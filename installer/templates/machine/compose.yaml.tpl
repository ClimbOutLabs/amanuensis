# Generated by the installer. The speech services shared by every instance: speech-to-text, and the voice that reads
# replies aloud.
name: aman-machine

services:
  aman-stt:
    image: @@STT_IMAGE@@
    # Built on this machine and never pulled.
    pull_policy: never
    container_name: aman-stt
    # Each instance reaches it through a relay on a network of its own; the service starts nothing and holds no privileges.
    user: '10001:10001'
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    read_only: true
    tmpfs:
      - /tmp:size=256m
    # No CPU pinning: transcription shares the machine cores with everything else.
    mem_limit: 2g
    memswap_limit: 2g
    pids_limit: 256
    environment:
      AMAN_STT_CPU_THREADS: ${AMAN_STT_CPU_THREADS:-4}
      AMAN_STT_MODEL_DIR: /data/stt-cache
    volumes:
      - stt-cache:/data/stt-cache
    networks:
      - machine
    restart: unless-stopped
@@IF_TTS@@
@@IF_TTS@@  aman-tts:
@@IF_TTS@@    image: @@TTS_IMAGE@@
@@IF_TTS@@    pull_policy: never
@@IF_TTS@@    container_name: aman-tts
@@IF_TTS@@    # Reached the same way as aman-stt. Its voice files are inside the image, so it needs no network access.
@@IF_TTS@@    user: '10001:10001'
@@IF_TTS@@    cap_drop:
@@IF_TTS@@      - ALL
@@IF_TTS@@    security_opt:
@@IF_TTS@@      - no-new-privileges:true
@@IF_TTS@@    read_only: true
@@IF_TTS@@    tmpfs:
@@IF_TTS@@      - /tmp:size=64m
@@IF_TTS@@    mem_limit: 1g
@@IF_TTS@@    memswap_limit: 1g
@@IF_TTS@@    pids_limit: 128
@@IF_TTS@@    environment:
@@IF_TTS@@      AMAN_TTS_CPU_THREADS: ${AMAN_TTS_CPU_THREADS:-4}
@@IF_TTS@@    networks:
@@IF_TTS@@      - machine
@@IF_TTS@@    restart: unless-stopped

volumes:
  stt-cache:
    name: aman_stt_cache

networks:
  machine:
    name: aman_machine
