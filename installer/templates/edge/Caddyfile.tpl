# Generated by the installer for instance @@NAME@@. Edit the installer templates, not this file.
@@APP_HOST@@ {
	# "?" sets a header only when the app did not send it, so the app's own Referrer-Policy and nosniff stay.
	header ?Strict-Transport-Security "max-age=31536000"
	header ?X-Content-Type-Options nosniff
	header ?Referrer-Policy strict-origin-when-cross-origin
	header ?X-Frame-Options DENY
	# Uploads up to 36 MiB; chat replies stream, so nothing is buffered.
	request_body {
		max_size 40MB
	}
	reverse_proxy 127.0.0.1:@@APP_PORT@@ {
		flush_interval -1
	}
}

@@LOGIN_HOST@@ {
	# Dex sends none of these by default.
	header ?Strict-Transport-Security "max-age=31536000"
	header ?X-Content-Type-Options nosniff
	header ?Referrer-Policy strict-origin-when-cross-origin
	header ?X-Frame-Options DENY
	reverse_proxy 127.0.0.1:@@LOGIN_PORT@@
}
