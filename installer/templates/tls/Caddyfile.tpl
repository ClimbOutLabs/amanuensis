# Generated by the installer for instance @@NAME@@. Edit the installer templates, not this file.
{
	admin off
	auto_https off
	# Browsers opened by address send no server name; the one certificate lists every address.
	default_sni @@DEFAULT_NAME@@
}

# Devices open Aman here, over https, with a certificate from this computer's own authority.
:@@HTTPS_IN@@ {
	tls /certs/leaf.crt /certs/leaf.key
	request_body {
		max_size 40MB
	}
	reverse_proxy 127.0.0.1:8790 {
		flush_interval -1
	}
}

# The plain port sends everything to https, except the page and the files that make a device trust this computer.
http://:@@HTTP_IN@@ {
	handle /trust {
		root * /srv/trust
		rewrite * /index.html
		file_server
	}
	handle_path /trust/* {
		root * /srv/trust
		@profile path /aman.mobileconfig
		header @profile Content-Type application/x-apple-aspen-config
		@certificate path /ca.crt
		header @certificate Content-Type application/x-x509-ca-cert
		file_server
	}
	handle {
		redir https://{http.request.host}:@@HTTPS_PORT@@{uri} 308
	}
}
