# Generated by the installer. Edit the installer templates, not this file.
name: aman-@@NAME@@

services:
  # Idle holder of the network namespace that app, login and the https front end share and that publishes their ports.
  # They are on 127.0.0.1 and on each private address of this computer an instance opened on the local network lists,
  # never on a wildcard; the login port is always on 127.0.0.1 (other devices reach sign-in through the app). Either
  # container can restart without stranding the other, and the login issuer name is the same URL for the browser and
  # for the app.
  loopback:
    image: @@APP_IMAGE@@
    # Built on this machine and never pulled.
    pull_policy: never
    init: true
    entrypoint: ['sleep', 'infinity']
    ports:
@@APP_PORTS@@
      - '127.0.0.1:@@LOGIN_PORT@@:@@LOGIN_PORT@@'
    # Lets a model server on the host answer at host.docker.internal.
    extra_hosts:
      - 'host.docker.internal:host-gateway'
@@IF_EDGE@@      # Caddy on this computer answers for the login name, so the app reaches its issuer without a trip through the public address.
@@IF_EDGE@@      - '@@LOGIN_HOST@@:host-gateway'
    # The app reaches speech by the name aman-stt on a network that only the relay below shares with it.
    networks:
      - default
      - link
    restart: unless-stopped

  # Carries the app's speech requests to the shared speech service and nothing else. The service is on a network of its
  # own with this relay alone, so it has no route to the app, the login service or the https front end.
  speech-link:
    image: @@APP_IMAGE@@
    pull_policy: never
    init: true
    user: '10001:10001'
    entrypoint:
      - node
      - --input-type=module
      - -e
      - "import n from 'node:net';n.createServer(c=>{const u=n.connect(8001,'aman-stt-engine');const x=()=>{c.destroy();u.destroy()};c.on('error',x);u.on('error',x);c.pipe(u).pipe(c)}).listen(8001)"
    networks:
      link:
        aliases:
          - aman-stt
      speech: {}
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    read_only: true
    mem_limit: 64m
    pids_limit: 64
    restart: unless-stopped

  app:
    image: @@APP_IMAGE@@
    pull_policy: never
    network_mode: 'service:loopback'
    env_file:
      - .env
    environment:
      NODE_ENV: production
      # Tells the server it was set up by the installer and under what name, so Settings can say how to turn the sandbox on.
      INSTALLER_INSTANCE: '@@NAME@@'
@@IF_SANDBOX@@      # Run code, shell and files go to the gVisor sandbox slots (project @@NAME@@-slots), never to Docker.
@@IF_SANDBOX@@      SANDBOX_BACKEND: slots
@@IF_SANDBOX@@      SANDBOX_SLOTS: '4'
@@IF_SANDBOX@@      SANDBOX_SLOTS_DIR: /run/aman-slots
@@IF_EMAIL@@      # The Email send list the server writes, and the connector's status file it reads (see mail-email).
@@IF_EMAIL@@      MAIL_POLICY_FILE: /data/mail-policy/allowed_recipients.toml
@@IF_EMAIL@@      MAIL_POLICY_STATUS_FILE: /data/mail-policy-status/loaded.sha256
@@IF_EMAIL@@      # The sidecar's account agent, which the Settings Email card talks to. Fixed inside the private network.
@@IF_EMAIL@@      MAIL_EMAIL_ACCOUNT_URL: http://mail-email:9559
    volumes:
      - data:/data
@@IF_SANDBOX@@      # Read-only views of each slot's control socket. No Docker socket, no workspace volume.
@@IF_SANDBOX@@      - slot_ctl_1:/run/aman-slots/1:ro
@@IF_SANDBOX@@      - slot_ctl_2:/run/aman-slots/2:ro
@@IF_SANDBOX@@      - slot_ctl_3:/run/aman-slots/3:ro
@@IF_SANDBOX@@      - slot_ctl_4:/run/aman-slots/4:ro
@@IF_SANDBOX@@      # One small writable volume per slot, only so the app can run the package mirrors the slot reaches there.
@@IF_SANDBOX@@      - slot_mirror_1:/run/aman-slots/1/mirror
@@IF_SANDBOX@@      - slot_mirror_2:/run/aman-slots/2/mirror
@@IF_SANDBOX@@      - slot_mirror_3:/run/aman-slots/3/mirror
@@IF_SANDBOX@@      - slot_mirror_4:/run/aman-slots/4/mirror
@@IF_EMAIL@@      # The Email send list. The server is its only writer; the connector mounts it read-only.
@@IF_EMAIL@@      - mail-policy:/data/mail-policy
@@IF_EMAIL@@      - mail-policy-status:/data/mail-policy-status:ro
    depends_on:
      loopback:
        condition: service_started
      dex:
        condition: service_healthy
    healthcheck:
      test:
        [
          'CMD',
          'node',
          '-e',
          "fetch('http://127.0.0.1:8790/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))",
        ]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 15s
    # Above the app's graceful shutdown window so a kill does not cut off turn drain.
    stop_grace_period: 35s
    restart: unless-stopped

@@IF_TLS@@  # Serves the app over https on the addresses of this computer, with a certificate from its own authority, and sends the
@@IF_TLS@@  # plain port to https. It shares the network of the app, so the app is never reachable except through it.
@@IF_TLS@@  tls:
@@IF_TLS@@    image: @@CADDY_IMAGE@@
@@IF_TLS@@    network_mode: 'service:loopback'
@@IF_TLS@@    user: '@@TLS_USER@@'
@@IF_TLS@@    command: ['caddy', 'run', '--config', '/etc/caddy/Caddyfile']
@@IF_TLS@@    volumes:
@@IF_TLS@@      - ./tls.Caddyfile:/etc/caddy/Caddyfile:ro
@@IF_TLS@@      - @@TLS_LEAF_DIR@@:/certs:ro
@@IF_TLS@@      - @@TLS_TRUST_DIR@@:/srv/trust:ro
@@IF_TLS@@    # It needs no privileges beyond the one its binary is marked with, and writes only to memory.
@@IF_TLS@@    cap_drop:
@@IF_TLS@@      - ALL
@@IF_TLS@@    cap_add:
@@IF_TLS@@      - NET_BIND_SERVICE
@@IF_TLS@@    security_opt:
@@IF_TLS@@      - no-new-privileges:true
@@IF_TLS@@    read_only: true
@@IF_TLS@@    tmpfs:
@@IF_TLS@@      - /data
@@IF_TLS@@      - /config
@@IF_TLS@@      - /tmp
@@IF_TLS@@    depends_on:
@@IF_TLS@@      app:
@@IF_TLS@@        condition: service_healthy
@@IF_TLS@@    healthcheck:
@@IF_TLS@@      test: ['CMD', 'wget', '-q', '-O', '/dev/null', 'http://127.0.0.1:@@TLS_HTTP_IN@@/trust']
@@IF_TLS@@      interval: 5s
@@IF_TLS@@      timeout: 3s
@@IF_TLS@@      retries: 10
@@IF_TLS@@    restart: unless-stopped

# Calendar connector. It starts only when named, so an instance without a calendar never runs it. The app reaches it at
# http://calendar-caldav:9558/mcp on this project's private network. Nothing is published, and the credentials come only from .env.calendar.
@@IF_CALENDAR@@  calendar-caldav:
@@IF_CALENDAR@@    image: @@CALENDAR_IMAGE@@
@@IF_CALENDAR@@    pull_policy: never
@@IF_CALENDAR@@    profiles: ['calendar']
@@IF_CALENDAR@@    env_file:
@@IF_CALENDAR@@      - path: ./.env.calendar
@@IF_CALENDAR@@        required: false
@@IF_CALENDAR@@    environment:
@@IF_CALENDAR@@      CALDAV_ALLOW_TOOLS: list_calendars,list_events,get_event,search_events,create_event,update_event,delete_event,respond_to_event
@@IF_CALENDAR@@      ELICITATION: 'false'
@@IF_CALENDAR@@    expose:
@@IF_CALENDAR@@      - '9558'
@@IF_CALENDAR@@    cap_drop:
@@IF_CALENDAR@@      - ALL
@@IF_CALENDAR@@    security_opt:
@@IF_CALENDAR@@      - no-new-privileges:true
@@IF_CALENDAR@@    restart: unless-stopped

# Email connector. It starts with the instance, and the app reaches it at http://mail-email:9557/mcp on this project's
# private network. Nothing is published. The account lives in .env.mail-email, which the installer writes and the
# Settings Email card changes through the sidecar's account agent on port 9559, also private-network only.
@@IF_EMAIL@@  mail-email:
@@IF_EMAIL@@    image: @@MAIL_EMAIL_IMAGE@@
@@IF_EMAIL@@    pull_policy: never
@@IF_EMAIL@@    # The wrapper starts the connector on the send list the app writes, and restarts it when that list changes.
@@IF_EMAIL@@    entrypoint: ['/bin/sh', '/usr/local/bin/aman-mail-entrypoint']
@@IF_EMAIL@@    command: ['streamable-http', '--host', '0.0.0.0', '--port', '9557']
@@IF_EMAIL@@    env_file:
@@IF_EMAIL@@      - path: ./.env.mail-email
@@IF_EMAIL@@        required: false
@@IF_EMAIL@@    environment:
@@IF_EMAIL@@      # Only requests addressed to this service name pass the DNS-rebinding check.
@@IF_EMAIL@@      MCP_ALLOWED_HOSTS: mail-email
@@IF_EMAIL@@      # Env-supplied accounts are read from the environment only, and no account is written to a config file.
@@IF_EMAIL@@      MCP_EMAIL_SERVER_CREDENTIAL_STORAGE: plaintext
@@IF_EMAIL@@      MCP_EMAIL_SERVER_CONFIG_PATH: /policy/allowed_recipients.toml
@@IF_EMAIL@@      AMAN_MAIL_STATUS_FILE: /mail-status/loaded.sha256
@@IF_EMAIL@@      # The account agent: the account file it owns, its private-network port, and its own path in the image.
@@IF_EMAIL@@      AMAN_MAIL_ACCOUNT_FILE: /account/.env.mail-email
@@IF_EMAIL@@      AMAN_MAIL_ACCOUNT_PORT: '9559'
@@IF_EMAIL@@      AMAN_MAIL_ACCOUNT_AGENT: /usr/local/bin/aman-mail-account-agent
@@IF_EMAIL@@      AMAN_MAIL_EMAIL_CHECK: /usr/local/bin/aman-mail-email-check
@@IF_EMAIL@@      MCP_EMAIL_SERVER_ENABLE_ATTACHMENT_CONTENT: 'true'
@@IF_EMAIL@@    volumes:
@@IF_EMAIL@@      - ./mail-email-entrypoint.sh:/usr/local/bin/aman-mail-entrypoint:ro
@@IF_EMAIL@@      - ./mail-account-agent.py:/usr/local/bin/aman-mail-account-agent:ro
@@IF_EMAIL@@      - ./mail-email-check.py:/usr/local/bin/aman-mail-email-check:ro
@@IF_EMAIL@@      - ./.env.mail-email:/account/.env.mail-email
@@IF_EMAIL@@      - mail-policy:/policy:ro
@@IF_EMAIL@@      - mail-policy-status:/mail-status
@@IF_EMAIL@@      - mail-email-data:/data
@@IF_EMAIL@@    expose:
@@IF_EMAIL@@      - '9557'
@@IF_EMAIL@@      - '9559'
@@IF_EMAIL@@    cap_drop:
@@IF_EMAIL@@      - ALL
@@IF_EMAIL@@    security_opt:
@@IF_EMAIL@@      - no-new-privileges:true
@@IF_EMAIL@@    restart: unless-stopped

  dex:
    image: @@DEX_IMAGE@@
    network_mode: 'service:loopback'
    command: ['dex', 'serve', '/etc/dex/config.yaml']
    # Only what login needs: the client secret it shares with the app, and the password hash in its own
    # file, which the app container never receives.
    env_file:
      - dex.env
    environment:
      OIDC_CLIENT_SECRET: ${OIDC_CLIENT_SECRET:?missing from .env}
    configs:
      - source: dex_config
        target: /etc/dex/config.yaml
    volumes:
      - dex:/var/dex
    healthcheck:
      test: ['CMD', 'wget', '-q', '-O', '/dev/null', 'http://127.0.0.1:@@DEX_TELEMETRY_PORT@@/healthz']
      interval: 3s
      timeout: 3s
      retries: 10
    restart: unless-stopped

configs:
  dex_config:
    file: ./dex.yaml

volumes:
  # The label lets a later purge find the data even after the instance directory is gone.
  data:
    name: aman_@@NAME@@_data
    labels:
      com.amanuensis.instance: @@NAME@@
  dex:
    name: aman_@@NAME@@_dex
    labels:
      com.amanuensis.instance: @@NAME@@

@@IF_EMAIL@@  # The Email send list. Holds only addresses, never credentials.
@@IF_EMAIL@@  mail-policy:
@@IF_EMAIL@@    name: aman_@@NAME@@_mail_policy
@@IF_EMAIL@@    labels:
@@IF_EMAIL@@      com.amanuensis.instance: @@NAME@@
@@IF_EMAIL@@  # Records which send list the Email connector loaded. Written by the connector, read by the app.
@@IF_EMAIL@@  mail-policy-status:
@@IF_EMAIL@@    name: aman_@@NAME@@_mail_policy_status
@@IF_EMAIL@@    labels:
@@IF_EMAIL@@      com.amanuensis.instance: @@NAME@@
@@IF_EMAIL@@  # Mail metadata index (SQLite). Holds mail metadata at rest, never credentials.
@@IF_EMAIL@@  mail-email-data:
@@IF_EMAIL@@    name: aman_@@NAME@@_mail_email_data
@@IF_EMAIL@@    labels:
@@IF_EMAIL@@      com.amanuensis.instance: @@NAME@@
@@IF_SANDBOX@@  # Created by the slots project, which the installer starts before this one.
@@IF_SANDBOX@@  slot_ctl_1:
@@IF_SANDBOX@@    name: @@NAME@@_slot_ctl_1
@@IF_SANDBOX@@    external: true
@@IF_SANDBOX@@  slot_ctl_2:
@@IF_SANDBOX@@    name: @@NAME@@_slot_ctl_2
@@IF_SANDBOX@@    external: true
@@IF_SANDBOX@@  slot_ctl_3:
@@IF_SANDBOX@@    name: @@NAME@@_slot_ctl_3
@@IF_SANDBOX@@    external: true
@@IF_SANDBOX@@  slot_ctl_4:
@@IF_SANDBOX@@    name: @@NAME@@_slot_ctl_4
@@IF_SANDBOX@@    external: true

@@IF_SANDBOX@@  slot_mirror_1:
@@IF_SANDBOX@@    name: @@NAME@@_slot_mirror_1
@@IF_SANDBOX@@    external: true
@@IF_SANDBOX@@  slot_mirror_2:
@@IF_SANDBOX@@    name: @@NAME@@_slot_mirror_2
@@IF_SANDBOX@@    external: true
@@IF_SANDBOX@@  slot_mirror_3:
@@IF_SANDBOX@@    name: @@NAME@@_slot_mirror_3
@@IF_SANDBOX@@    external: true
@@IF_SANDBOX@@  slot_mirror_4:
@@IF_SANDBOX@@    name: @@NAME@@_slot_mirror_4
@@IF_SANDBOX@@    external: true

networks:
  # Between the app and the relay only.
  link:
    internal: true
  # Between the relay and the shared speech service only; the installer joins the service to it.
  speech:
    internal: true
    name: @@STT_NETWORK@@
