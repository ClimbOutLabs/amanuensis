# Generated by the installer. Edit the installer templates, not this file.
name: aman-@@NAME@@

services:
  # Idle holder of the network namespace that app and login share and that publishes their ports. The app port is on
  # 127.0.0.1 only, or on every interface for an instance opened on the local network; the login port is always on
  # 127.0.0.1 (other devices reach sign-in through the app). Either container can restart without stranding the
  # other, and the login issuer name is the same URL for the browser and for the app.
  loopback:
    image: @@APP_IMAGE@@
    # Built on this machine and never pulled.
    pull_policy: never
    init: true
    entrypoint: ['sleep', 'infinity']
    ports:
      - '@@BIND@@@@APP_PORT@@:8790'
      - '127.0.0.1:@@LOGIN_PORT@@:@@LOGIN_PORT@@'
    # Lets a model server on the host answer at host.docker.internal.
    extra_hosts:
      - 'host.docker.internal:host-gateway'
@@IF_EDGE@@      # Caddy on this computer answers for the login name, so the app reaches its issuer without a trip through the public address.
@@IF_EDGE@@      - '@@LOGIN_HOST@@:host-gateway'
    # Own network for the shared speech service, so instances cannot reach each other through it.
    networks:
      - default
      - stt
    restart: unless-stopped

  app:
    image: @@APP_IMAGE@@
    pull_policy: never
    network_mode: 'service:loopback'
    env_file:
      - .env
    environment:
      NODE_ENV: production
@@IF_SANDBOX@@      # Run code, shell and files go to the gVisor sandbox slots (project @@NAME@@-slots), never to Docker.
@@IF_SANDBOX@@      SANDBOX_BACKEND: slots
@@IF_SANDBOX@@      SANDBOX_SLOTS: '4'
@@IF_SANDBOX@@      SANDBOX_SLOTS_DIR: /run/aman-slots
    volumes:
      - data:/data
@@IF_SANDBOX@@      # Read-only views of each slot's control socket. No Docker socket, no workspace volume.
@@IF_SANDBOX@@      - slot_ctl_1:/run/aman-slots/1:ro
@@IF_SANDBOX@@      - slot_ctl_2:/run/aman-slots/2:ro
@@IF_SANDBOX@@      - slot_ctl_3:/run/aman-slots/3:ro
@@IF_SANDBOX@@      - slot_ctl_4:/run/aman-slots/4:ro
    depends_on:
      loopback:
        condition: service_started
      dex:
        condition: service_healthy
    healthcheck:
      test:
        [
          'CMD',
          'node',
          '-e',
          "fetch('http://127.0.0.1:8790/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))",
        ]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 15s
    # Above the app's graceful shutdown window so a kill does not cut off turn drain.
    stop_grace_period: 35s
    restart: unless-stopped

  dex:
    image: @@DEX_IMAGE@@
    network_mode: 'service:loopback'
    command: ['dex', 'serve', '/etc/dex/config.yaml']
    # Only what login needs: the client secret it shares with the app, and the password hash in its own
    # file, which the app container never receives.
    env_file:
      - dex.env
    environment:
      OIDC_CLIENT_SECRET: ${OIDC_CLIENT_SECRET:?missing from .env}
    configs:
      - source: dex_config
        target: /etc/dex/config.yaml
    volumes:
      - dex:/var/dex
    healthcheck:
      test: ['CMD', 'wget', '-q', '-O', '/dev/null', 'http://127.0.0.1:@@DEX_TELEMETRY_PORT@@/healthz']
      interval: 3s
      timeout: 3s
      retries: 10
    restart: unless-stopped

configs:
  dex_config:
    file: ./dex.yaml

volumes:
  # The label lets a later purge find the data even after the instance directory is gone.
  data:
    name: aman_@@NAME@@_data
    labels:
      com.amanuensis.instance: @@NAME@@
  dex:
    name: aman_@@NAME@@_dex
    labels:
      com.amanuensis.instance: @@NAME@@

@@IF_SANDBOX@@  # Created by the slots project, which the installer starts before this one.
@@IF_SANDBOX@@  slot_ctl_1:
@@IF_SANDBOX@@    name: @@NAME@@_slot_ctl_1
@@IF_SANDBOX@@    external: true
@@IF_SANDBOX@@  slot_ctl_2:
@@IF_SANDBOX@@    name: @@NAME@@_slot_ctl_2
@@IF_SANDBOX@@    external: true
@@IF_SANDBOX@@  slot_ctl_3:
@@IF_SANDBOX@@    name: @@NAME@@_slot_ctl_3
@@IF_SANDBOX@@    external: true
@@IF_SANDBOX@@  slot_ctl_4:
@@IF_SANDBOX@@    name: @@NAME@@_slot_ctl_4
@@IF_SANDBOX@@    external: true

networks:
  stt:
    name: aman_@@NAME@@_stt
