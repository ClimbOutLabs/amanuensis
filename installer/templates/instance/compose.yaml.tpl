# Generated by the installer. Edit the installer templates, not this file.
name: aman-@@NAME@@

services:
  # Idle holder of the network namespace that app, login and the https front end share and that publishes their ports.
  # They are on 127.0.0.1 and on each private address of this computer an instance opened on the local network lists,
  # never on a wildcard; the login port is always on 127.0.0.1 (other devices reach sign-in through the app). Either
  # container can restart without stranding the other, and the login issuer name is the same URL for the browser and
  # for the app.
  loopback:
    image: @@APP_IMAGE@@
    # Built on this machine and never pulled.
    pull_policy: never
    init: true
    entrypoint: ['sleep', 'infinity']
    ports:
@@APP_PORTS@@
      - '127.0.0.1:@@LOGIN_PORT@@:@@LOGIN_PORT@@'
    # Lets a model server on the host answer at host.docker.internal.
    extra_hosts:
      - 'host.docker.internal:host-gateway'
@@IF_EDGE@@      # Caddy on this computer answers for the login name, so the app reaches its issuer without a trip through the public address.
@@IF_EDGE@@      - '@@LOGIN_HOST@@:host-gateway'
    # The app reaches speech by the names aman-stt and aman-tts on a network that only the relay below shares with it.
    networks:
      - default
      - link
@@IF_CALENDAR@@      - calendar
@@IF_EMAIL@@      - mail
@@IF_BROWSER@@      - browser-control
@@IF_LOCAL_MODEL@@      - local-model
    restart: unless-stopped

  # Carries the app's speech requests to the shared speech services and nothing else: speech-to-text on 8001, the voice
  # on 8002. The services are on a network of their own with this relay alone, so they have no route to the app, the
  # login service or the https front end.
  speech-link:
    image: @@APP_IMAGE@@
    pull_policy: never
    init: true
    user: '10001:10001'
    entrypoint:
      - node
      - --input-type=module
      - -e
      - "import n from 'node:net';const r=(p,h)=>n.createServer(c=>{const u=n.connect(p,h);const x=()=>{c.destroy();u.destroy()};c.on('error',x);u.on('error',x);c.pipe(u).pipe(c)}).listen(p);r(8001,'aman-stt-engine');r(8002,'aman-tts-engine')"
    networks:
      link:
        aliases:
          - aman-stt
          - aman-tts
      speech: {}
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    read_only: true
    mem_limit: 64m
    pids_limit: 64
    restart: unless-stopped

  app:
    image: @@APP_IMAGE@@
    pull_policy: never
    network_mode: 'service:loopback'
    env_file:
      - .env
    environment:
      NODE_ENV: production
      # Tells the server it was set up by the installer and under what name, so Settings can say how to turn the sandbox on.
      INSTALLER_INSTANCE: '@@NAME@@'
@@IF_SANDBOX@@      # Run code, shell and files go to the gVisor sandbox slots (project @@NAME@@-slots), never to Docker.
@@IF_SANDBOX@@      SANDBOX_BACKEND: slots
@@IF_SANDBOX@@      SANDBOX_SLOTS: '2'
@@IF_SANDBOX@@      SANDBOX_SLOTS_DIR: /run/aman-slots
@@IF_EMAIL@@      # The Email send list the server writes, and the connector's status file it reads (see mail-email).
@@IF_EMAIL@@      MAIL_POLICY_FILE: /data/mail-policy/allowed_recipients.toml
@@IF_EMAIL@@      MAIL_POLICY_STATUS_FILE: /data/mail-policy-status/loaded.sha256
@@IF_EMAIL@@      # The sidecar's account agent, which the Settings Email card talks to. Fixed inside the private network.
@@IF_EMAIL@@      MAIL_EMAIL_ACCOUNT_URL: http://mail-email:9559
@@IF_CALENDAR@@      # The calendar sidecar's account agent, which the Settings Calendar card talks to. Fixed inside the private network.
@@IF_CALENDAR@@      CALENDAR_ACCOUNT_URL: http://calendar-caldav:9560
@@IF_BROWSER@@      # Aman's own browser, reached only through its gateway's relay. BROWSER_SECRET comes from .env.
@@IF_BROWSER@@      BROWSER_ENABLED: 'true'
@@IF_BROWSER@@      BROWSER_URL: http://browser-relay:8792
@@IF_LOCAL_BRIDGE@@      # This computer's own addresses and names, so Settings can tell when a model address is this computer and offer
@@IF_LOCAL_BRIDGE@@      # the local model bridge instead. The ports are the ones the bridge carries, at http://aman-local-model:PORT.
@@IF_LOCAL_BRIDGE@@      THIS_COMPUTER_ADDRESSES: '@@THIS_COMPUTER_ADDRESSES@@'
@@IF_LOCAL_BRIDGE@@      LOCAL_MODEL_PORTS: '@@LOCAL_MODEL_PORTS@@'
    volumes:
      - data:/data
@@IF_SANDBOX@@      # Read-only views of each slot's control socket. No Docker socket, no workspace volume.
@@IF_SANDBOX@@      - slot_ctl_1:/run/aman-slots/1:ro
@@IF_SANDBOX@@      - slot_ctl_2:/run/aman-slots/2:ro
@@IF_SANDBOX@@      # One small writable volume per slot, only so the app can run the package mirrors the slot reaches there.
@@IF_SANDBOX@@      - slot_mirror_1:/run/aman-slots/1/mirror
@@IF_SANDBOX@@      - slot_mirror_2:/run/aman-slots/2/mirror
@@IF_EMAIL@@      # The Email send list. The server is its only writer; the connector mounts it read-only.
@@IF_EMAIL@@      - mail-policy:/data/mail-policy
@@IF_EMAIL@@      - mail-policy-status:/data/mail-policy-status:ro
    depends_on:
      loopback:
        condition: service_started
      dex:
        condition: service_healthy
    healthcheck:
      test:
        [
          'CMD',
          'node',
          '-e',
          "fetch('http://127.0.0.1:8790/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))",
        ]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 15s
    # Above the app's graceful shutdown window so a kill does not cut off turn drain.
    stop_grace_period: 35s
    restart: unless-stopped

@@IF_LOCAL_MODEL@@  # The local model bridge: carries the app's model requests to a model server on this computer, at the ports its owner
@@IF_LOCAL_MODEL@@  # named with aman local-model. This host side dials the model and listens only on socket files in a volume it shares
@@IF_LOCAL_MODEL@@  # with the link side below, never on a network port, so nothing else reaches the model through it.
@@IF_LOCAL_MODEL@@  local-model-host:
@@IF_LOCAL_MODEL@@    image: @@APP_IMAGE@@
@@IF_LOCAL_MODEL@@    pull_policy: never
@@IF_LOCAL_MODEL@@    init: true
@@IF_LOCAL_MODEL@@    user: '10001:10001'
@@IF_LOCAL_MODEL@@    entrypoint: ['node', '/usr/local/lib/aman/local-model-bridge.mjs']
@@IF_LOCAL_MODEL@@    environment:
@@IF_LOCAL_MODEL@@      LOCAL_MODEL_SIDE: host
@@IF_LOCAL_MODEL@@      LOCAL_MODEL_PORTS: '@@LOCAL_MODEL_PORTS@@'
@@IF_LOCAL_MODEL@@      LOCAL_MODEL_TARGET: '@@LOCAL_MODEL_TARGET@@'
@@IF_LOCAL_MODEL_HOSTNET@@    # Docker runs on this computer itself, so this side shares its network to reach a model that listens on 127.0.0.1.
@@IF_LOCAL_MODEL_HOSTNET@@    network_mode: host
@@IF_LOCAL_MODEL_DESKTOP@@    # Docker Desktop reaches a model on this computer at host.docker.internal, from a network of this side's own.
@@IF_LOCAL_MODEL_DESKTOP@@    networks:
@@IF_LOCAL_MODEL_DESKTOP@@      - local-model-egress
@@IF_LOCAL_MODEL_DESKTOP@@    extra_hosts:
@@IF_LOCAL_MODEL_DESKTOP@@      - 'host.docker.internal:host-gateway'
@@IF_LOCAL_MODEL@@    volumes:
@@IF_LOCAL_MODEL@@      - ./local-model-bridge.mjs:/usr/local/lib/aman/local-model-bridge.mjs:ro
@@IF_LOCAL_MODEL@@      - local-model-sockets:/run/aman-local-model
@@IF_LOCAL_MODEL@@    cap_drop:
@@IF_LOCAL_MODEL@@      - ALL
@@IF_LOCAL_MODEL@@    security_opt:
@@IF_LOCAL_MODEL@@      - no-new-privileges:true
@@IF_LOCAL_MODEL@@    read_only: true
@@IF_LOCAL_MODEL@@    mem_limit: 64m
@@IF_LOCAL_MODEL@@    pids_limit: 64
@@IF_LOCAL_MODEL@@    restart: unless-stopped

@@IF_LOCAL_MODEL@@  # The link side: answers the app at aman-local-model on a network only the app's network holder shares, and passes
@@IF_LOCAL_MODEL@@  # each connection to the host side's socket file.
@@IF_LOCAL_MODEL@@  local-model-link:
@@IF_LOCAL_MODEL@@    image: @@APP_IMAGE@@
@@IF_LOCAL_MODEL@@    pull_policy: never
@@IF_LOCAL_MODEL@@    init: true
@@IF_LOCAL_MODEL@@    user: '10001:10001'
@@IF_LOCAL_MODEL@@    entrypoint: ['node', '/usr/local/lib/aman/local-model-bridge.mjs']
@@IF_LOCAL_MODEL@@    environment:
@@IF_LOCAL_MODEL@@      LOCAL_MODEL_SIDE: link
@@IF_LOCAL_MODEL@@      LOCAL_MODEL_PORTS: '@@LOCAL_MODEL_PORTS@@'
@@IF_LOCAL_MODEL@@    networks:
@@IF_LOCAL_MODEL@@      local-model:
@@IF_LOCAL_MODEL@@        aliases:
@@IF_LOCAL_MODEL@@          - aman-local-model
@@IF_LOCAL_MODEL@@    volumes:
@@IF_LOCAL_MODEL@@      - ./local-model-bridge.mjs:/usr/local/lib/aman/local-model-bridge.mjs:ro
@@IF_LOCAL_MODEL@@      - local-model-sockets:/run/aman-local-model
@@IF_LOCAL_MODEL@@    depends_on:
@@IF_LOCAL_MODEL@@      local-model-host:
@@IF_LOCAL_MODEL@@        condition: service_started
@@IF_LOCAL_MODEL@@    cap_drop:
@@IF_LOCAL_MODEL@@      - ALL
@@IF_LOCAL_MODEL@@    security_opt:
@@IF_LOCAL_MODEL@@      - no-new-privileges:true
@@IF_LOCAL_MODEL@@    read_only: true
@@IF_LOCAL_MODEL@@    mem_limit: 64m
@@IF_LOCAL_MODEL@@    pids_limit: 64
@@IF_LOCAL_MODEL@@    restart: unless-stopped

@@IF_TLS@@  # Serves the app over https on the addresses of this computer, with a certificate from its own authority, and sends the
@@IF_TLS@@  # plain port to https. It shares the network of the app, so the app is never reachable except through it.
@@IF_TLS@@  tls:
@@IF_TLS@@    image: @@CADDY_IMAGE@@
@@IF_TLS@@    network_mode: 'service:loopback'
@@IF_TLS@@    user: '@@TLS_USER@@'
@@IF_TLS@@    command: ['caddy', 'run', '--config', '/etc/caddy/Caddyfile']
@@IF_TLS@@    volumes:
@@IF_TLS@@      - ./tls.Caddyfile:/etc/caddy/Caddyfile:ro
@@IF_TLS_HOST@@      - @@TLS_LEAF_DIR@@:/certs:ro
@@IF_TLS_HOST@@      - @@TLS_TRUST_DIR@@:/srv/trust:ro
@@IF_TLS_VOLUME@@      - type: volume
@@IF_TLS_VOLUME@@        source: aman_home
@@IF_TLS_VOLUME@@        target: /certs
@@IF_TLS_VOLUME@@        read_only: true
@@IF_TLS_VOLUME@@        volume:
@@IF_TLS_VOLUME@@          subpath: tls/leaf/@@NAME@@
@@IF_TLS_VOLUME@@      - type: volume
@@IF_TLS_VOLUME@@        source: aman_home
@@IF_TLS_VOLUME@@        target: /srv/trust
@@IF_TLS_VOLUME@@        read_only: true
@@IF_TLS_VOLUME@@        volume:
@@IF_TLS_VOLUME@@          subpath: tls/trust/@@NAME@@
@@IF_TLS@@    # It needs no privileges beyond the one its binary is marked with, and writes only to memory.
@@IF_TLS@@    cap_drop:
@@IF_TLS@@      - ALL
@@IF_TLS@@    cap_add:
@@IF_TLS@@      - NET_BIND_SERVICE
@@IF_TLS@@    security_opt:
@@IF_TLS@@      - no-new-privileges:true
@@IF_TLS@@    read_only: true
@@IF_TLS@@    tmpfs:
@@IF_TLS@@      - /data
@@IF_TLS@@      - /config
@@IF_TLS@@      - /tmp
@@IF_TLS@@    depends_on:
@@IF_TLS@@      app:
@@IF_TLS@@        condition: service_healthy
@@IF_TLS@@    healthcheck:
@@IF_TLS@@      test: ['CMD', 'wget', '-q', '-O', '/dev/null', 'http://127.0.0.1:@@TLS_HTTP_IN@@/trust']
@@IF_TLS@@      interval: 5s
@@IF_TLS@@      timeout: 3s
@@IF_TLS@@      retries: 10
@@IF_TLS@@    restart: unless-stopped

# Calendar connector. It starts with the instance whenever the release has its image, so the Settings Calendar card can
# set it up. The app reaches it at http://calendar-caldav:9558/mcp. Nothing is published. It sits on a network of its own
# that only the app's network holder shares, so no other service (the mail connector reads untrusted mail) can reach its
# account port, which also answers only a caller that presents this instance's secret.
# The calendar login lives in a volume this sidecar owns, which the installer writes through the sidecar's account agent
# and the Settings Calendar card changes through the same agent on port 9560.
# The tool server inside runs only while a login is saved.
@@IF_CALENDAR@@  calendar-caldav:
@@IF_CALENDAR@@    image: @@CALENDAR_IMAGE@@
@@IF_CALENDAR@@    pull_policy: never
@@IF_CALENDAR@@    environment:
@@IF_CALENDAR@@      CALDAV_ALLOW_TOOLS: list_calendars,list_events,get_event,search_events,create_event,update_event,delete_event,respond_to_event
@@IF_CALENDAR@@      ELICITATION: 'false'
@@IF_CALENDAR@@      # The account agent: the account file it owns and its private-network port.
@@IF_CALENDAR@@      CALENDAR_ACCOUNT_FILE: /account/.env.calendar
@@IF_CALENDAR@@      CALENDAR_ACCOUNT_PORT: '9560'
@@IF_CALENDAR@@      # Shared with the app through .env, which the installer fills in once.
@@IF_CALENDAR@@      CALENDAR_ACCOUNT_SECRET: ${CALENDAR_ACCOUNT_SECRET:?missing from .env}
@@IF_CALENDAR@@    networks:
@@IF_CALENDAR@@      - calendar
@@IF_CALENDAR@@    volumes:
@@IF_CALENDAR@@      - calendar-account:/account
@@IF_CALENDAR@@    expose:
@@IF_CALENDAR@@      - '9558'
@@IF_CALENDAR@@      - '9560'
@@IF_CALENDAR@@    cap_drop:
@@IF_CALENDAR@@      - ALL
@@IF_CALENDAR@@    security_opt:
@@IF_CALENDAR@@      - no-new-privileges:true
@@IF_CALENDAR@@    restart: unless-stopped

# Email connector. It starts with the instance, and the app reaches it at http://mail-email:9557/mcp. Nothing is
# published. It sits on a network of its own that only the app's network holder shares, so no other service can reach
# its tool port or its account port. The account lives in a volume this sidecar owns, which the installer writes
# through the sidecar's account agent and the Settings Email card changes through the same agent on port 9559.
# The account agent answers only a caller that presents this instance's secret.
@@IF_EMAIL@@  mail-email:
@@IF_EMAIL@@    image: @@MAIL_EMAIL_IMAGE@@
@@IF_EMAIL@@    pull_policy: never
@@IF_EMAIL@@    # The wrapper starts the connector on the send list the app writes, and restarts it when that list changes.
@@IF_EMAIL@@    entrypoint: ['/bin/sh', '/usr/local/bin/aman-mail-entrypoint']
@@IF_EMAIL@@    command: ['streamable-http', '--host', '0.0.0.0', '--port', '9557']
@@IF_EMAIL@@    environment:
@@IF_EMAIL@@      # Only requests addressed to this service name pass the DNS-rebinding check.
@@IF_EMAIL@@      MCP_ALLOWED_HOSTS: mail-email
@@IF_EMAIL@@      # Env-supplied accounts are read from the environment only, and no account is written to a config file.
@@IF_EMAIL@@      MCP_EMAIL_SERVER_CREDENTIAL_STORAGE: plaintext
@@IF_EMAIL@@      MCP_EMAIL_SERVER_CONFIG_PATH: /policy/allowed_recipients.toml
@@IF_EMAIL@@      AMAN_MAIL_STATUS_FILE: /mail-status/loaded.sha256
@@IF_EMAIL@@      # The account agent: the account file it owns, its private-network port, and its own path in the image.
@@IF_EMAIL@@      AMAN_MAIL_ACCOUNT_FILE: /account/.env.mail-email
@@IF_EMAIL@@      AMAN_MAIL_ACCOUNT_PORT: '9559'
@@IF_EMAIL@@      # Shared with the app through .env, which the installer fills in once.
@@IF_EMAIL@@      AMAN_MAIL_ACCOUNT_SECRET: ${MAIL_EMAIL_ACCOUNT_SECRET:?missing from .env}
@@IF_EMAIL@@      AMAN_MAIL_ACCOUNT_AGENT: /usr/local/bin/aman-mail-account-agent
@@IF_EMAIL@@      AMAN_MAIL_EMAIL_CHECK: /usr/local/bin/aman-mail-email-check
@@IF_EMAIL@@      MCP_EMAIL_SERVER_ENABLE_ATTACHMENT_CONTENT: 'true'
@@IF_EMAIL@@    networks:
@@IF_EMAIL@@      - mail
@@IF_EMAIL@@    volumes:
@@IF_EMAIL@@      - ./mail-email-entrypoint.sh:/usr/local/bin/aman-mail-entrypoint:ro
@@IF_EMAIL@@      - ./mail-account-agent.py:/usr/local/bin/aman-mail-account-agent:ro
@@IF_EMAIL@@      - ./mail-email-check.py:/usr/local/bin/aman-mail-email-check:ro
@@IF_EMAIL@@      - mail-account:/account
@@IF_EMAIL@@      - mail-policy:/policy:ro
@@IF_EMAIL@@      - mail-policy-status:/mail-status
@@IF_EMAIL@@      - mail-email-data:/data
@@IF_EMAIL@@    expose:
@@IF_EMAIL@@      - '9557'
@@IF_EMAIL@@      - '9559'
@@IF_EMAIL@@    cap_drop:
@@IF_EMAIL@@      - ALL
@@IF_EMAIL@@    security_opt:
@@IF_EMAIL@@      - no-new-privileges:true
@@IF_EMAIL@@    restart: unless-stopped

@@IF_BROWSER@@# Aman's own browser: a real Chromium on a virtual screen, with one profile per person in its own volume. It reads
@@IF_BROWSER@@# hostile pages, so its only network is an internal one shared with its gateway alone. Every request it makes goes
@@IF_BROWSER@@# through the gateway's proxy, which refuses this computer and private networks, and the app reaches it only through
@@IF_BROWSER@@# the gateway's relay, which checks the secret the app and the gateway share. This container never holds that secret.
@@IF_BROWSER@@  browser:
@@IF_BROWSER@@    image: @@BROWSER_IMAGE@@
@@IF_BROWSER@@    pull_policy: never
@@IF_BROWSER@@    init: true
@@IF_BROWSER@@    environment:
@@IF_BROWSER@@      BROWSER_PROXY: http://browser-proxy:3128
@@IF_BROWSER@@      BROWSER_API_PEER: browser-gateway
@@IF_BROWSER@@    networks:
@@IF_BROWSER@@      - browser-internal
@@IF_BROWSER@@    volumes:
@@IF_BROWSER@@      - browser-profiles:/profiles
@@IF_BROWSER@@    expose:
@@IF_BROWSER@@      - '8792'
@@IF_BROWSER@@    # Chromium keeps its own sandbox on, which needs the namespace calls this profile adds to Docker's default.
@@IF_BROWSER@@    security_opt:
@@IF_BROWSER@@      - no-new-privileges:true
@@IF_BROWSER@@      - seccomp=./browser-seccomp.json
@@IF_BROWSER@@    cap_drop:
@@IF_BROWSER@@      - ALL
@@IF_BROWSER@@    read_only: true
@@IF_BROWSER@@    tmpfs:
@@IF_BROWSER@@      - /tmp:size=256m
@@IF_BROWSER@@      - /home/pwuser:size=256m,uid=1001,gid=1001
@@IF_BROWSER@@    shm_size: 512m
@@IF_BROWSER@@    pids_limit: 512
@@IF_BROWSER@@    mem_limit: 2g
@@IF_BROWSER@@    restart: unless-stopped

@@IF_BROWSER@@  browser-gateway:
@@IF_BROWSER@@    image: @@BROWSER_GATEWAY_IMAGE@@
@@IF_BROWSER@@    pull_policy: never
@@IF_BROWSER@@    environment:
@@IF_BROWSER@@      BROWSER_SIDECAR_HOST: browser
@@IF_BROWSER@@      # Shared with the app through .env, which the installer fills in once.
@@IF_BROWSER@@      BROWSER_SECRET: ${BROWSER_SECRET:?missing from .env}
@@IF_BROWSER@@      # The proxy listens only on the browser's network, and the relay only on the app's.
@@IF_BROWSER@@      BROWSER_PROXY_BIND: browser-proxy
@@IF_BROWSER@@      BROWSER_RELAY_BIND: browser-relay
@@IF_BROWSER@@    networks:
@@IF_BROWSER@@      browser-internal:
@@IF_BROWSER@@        aliases: [browser-proxy]
@@IF_BROWSER@@      browser-control:
@@IF_BROWSER@@        aliases: [browser-relay]
@@IF_BROWSER@@      browser-egress: {}
@@IF_BROWSER@@    expose:
@@IF_BROWSER@@      - '3128'
@@IF_BROWSER@@      - '8792'
@@IF_BROWSER@@    security_opt:
@@IF_BROWSER@@      - no-new-privileges:true
@@IF_BROWSER@@    cap_drop:
@@IF_BROWSER@@      - ALL
@@IF_BROWSER@@    read_only: true
@@IF_BROWSER@@    pids_limit: 128
@@IF_BROWSER@@    mem_limit: 256m
@@IF_BROWSER@@    restart: unless-stopped

  dex:
    image: @@DEX_IMAGE@@
    network_mode: 'service:loopback'
    command: ['dex', 'serve', '/etc/dex/config.yaml']
    # Only what login needs: the client secret it shares with the app, and the password hash in its own
    # file, which the app container never receives.
    env_file:
      - dex.env
    environment:
      OIDC_CLIENT_SECRET: ${OIDC_CLIENT_SECRET:?missing from .env}
    configs:
      - source: dex_config
        target: /etc/dex/config.yaml
    volumes:
      - dex:/var/dex
    healthcheck:
      test: ['CMD', 'wget', '-q', '-O', '/dev/null', 'http://127.0.0.1:@@DEX_TELEMETRY_PORT@@/healthz']
      interval: 3s
      timeout: 3s
      retries: 10
    restart: unless-stopped

configs:
  dex_config:
    file: ./dex.yaml

volumes:
  # The label lets a later purge find the data even after the instance directory is gone.
  data:
    name: aman_@@NAME@@_data
    labels:
      com.amanuensis.instance: @@NAME@@
  dex:
    name: aman_@@NAME@@_dex
    labels:
      com.amanuensis.instance: @@NAME@@
@@IF_TLS_VOLUME@@
@@IF_TLS_VOLUME@@  # The state volume itself, declared so the https folders above can be mounted from inside it.
@@IF_TLS_VOLUME@@  # The setup that put the state there made it; Compose never makes it.
@@IF_TLS_VOLUME@@  aman_home:
@@IF_TLS_VOLUME@@    name: aman_home
@@IF_TLS_VOLUME@@    external: true

@@IF_EMAIL@@  # The Email send list. Holds only addresses, never credentials.
@@IF_EMAIL@@  mail-policy:
@@IF_EMAIL@@    name: aman_@@NAME@@_mail_policy
@@IF_EMAIL@@    labels:
@@IF_EMAIL@@      com.amanuensis.instance: @@NAME@@
@@IF_EMAIL@@  # Records which send list the Email connector loaded. Written by the connector, read by the app.
@@IF_EMAIL@@  mail-policy-status:
@@IF_EMAIL@@    name: aman_@@NAME@@_mail_policy_status
@@IF_EMAIL@@    labels:
@@IF_EMAIL@@      com.amanuensis.instance: @@NAME@@
@@IF_EMAIL@@  # Mail metadata index (SQLite). Holds mail metadata at rest, never credentials.
@@IF_EMAIL@@  mail-email-data:
@@IF_EMAIL@@    name: aman_@@NAME@@_mail_email_data
@@IF_EMAIL@@    labels:
@@IF_EMAIL@@      com.amanuensis.instance: @@NAME@@
@@IF_EMAIL@@  # The Email account file, owned by the connector. Holds the app password; nothing else reads it.
@@IF_EMAIL@@  mail-account:
@@IF_EMAIL@@    name: aman_@@NAME@@_mail_account
@@IF_EMAIL@@    labels:
@@IF_EMAIL@@      com.amanuensis.instance: @@NAME@@
@@IF_CALENDAR@@  # The Calendar login file, owned by the connector. Holds the app password; nothing else reads it.
@@IF_CALENDAR@@  calendar-account:
@@IF_CALENDAR@@    name: aman_@@NAME@@_calendar_account
@@IF_CALENDAR@@    labels:
@@IF_CALENDAR@@      com.amanuensis.instance: @@NAME@@
@@IF_BROWSER@@  # The browser's profiles: each person's cookies and site logins. Only the browser mounts it.
@@IF_BROWSER@@  browser-profiles:
@@IF_BROWSER@@    name: aman_@@NAME@@_browser_profiles
@@IF_BROWSER@@    labels:
@@IF_BROWSER@@      com.amanuensis.instance: @@NAME@@
@@IF_LOCAL_MODEL@@  # The local model bridge's socket files. Holds no data.
@@IF_LOCAL_MODEL@@  local-model-sockets:
@@IF_LOCAL_MODEL@@    name: aman_@@NAME@@_local_model
@@IF_LOCAL_MODEL@@    labels:
@@IF_LOCAL_MODEL@@      com.amanuensis.instance: @@NAME@@
@@IF_SANDBOX@@  # Created by the slots project, which the installer starts before this one.
@@IF_SANDBOX@@  slot_ctl_1:
@@IF_SANDBOX@@    name: @@NAME@@_slot_ctl_1
@@IF_SANDBOX@@    external: true
@@IF_SANDBOX@@  slot_ctl_2:
@@IF_SANDBOX@@    name: @@NAME@@_slot_ctl_2
@@IF_SANDBOX@@    external: true

@@IF_SANDBOX@@  slot_mirror_1:
@@IF_SANDBOX@@    name: @@NAME@@_slot_mirror_1
@@IF_SANDBOX@@    external: true
@@IF_SANDBOX@@  slot_mirror_2:
@@IF_SANDBOX@@    name: @@NAME@@_slot_mirror_2
@@IF_SANDBOX@@    external: true

networks:
  # Between the app and the relay only.
  link:
    internal: true
  # Between the relay and the shared speech services only; the installer joins the services to it.
  speech:
    internal: true
    name: @@STT_NETWORK@@
  # Between the app's network holder and the calendar connector only. Not internal: the connector reaches the
  # calendar server on the internet.
@@IF_CALENDAR@@  calendar: {}
@@IF_EMAIL@@  # Between the app's network holder and the mail connector only. Not internal: the connector reaches the mail
@@IF_EMAIL@@  # server on the internet.
@@IF_EMAIL@@  mail: {}
@@IF_BROWSER@@  # The browser and its gateway only. Internal: the browser has no way out but the gateway.
@@IF_BROWSER@@  browser-internal:
@@IF_BROWSER@@    internal: true
@@IF_BROWSER@@  # The app's network holder and the browser gateway only, for the app's calls to the browser.
@@IF_BROWSER@@  browser-control:
@@IF_BROWSER@@    internal: true
@@IF_BROWSER@@  # The gateway's own way out to the internet. Nothing else is on it.
@@IF_BROWSER@@  browser-egress: {}
@@IF_LOCAL_MODEL@@  # The app's network holder and the local model bridge's link side only. Internal: it has no way out.
@@IF_LOCAL_MODEL@@  local-model:
@@IF_LOCAL_MODEL@@    internal: true
@@IF_LOCAL_MODEL_DESKTOP@@  # The bridge's host side alone, for its calls to the model at host.docker.internal under Docker Desktop.
@@IF_LOCAL_MODEL_DESKTOP@@  local-model-egress: {}
