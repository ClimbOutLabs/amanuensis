# Generated by the installer. Edit the installer templates, not this file.
name: aman-@@NAME@@

services:
  # Idle holder of the network namespace that app and login share and that publishes their loopback
  # ports. Either one can restart without stranding the other, and the login issuer name is the same
  # URL for the browser and for the app.
  loopback:
    image: @@APP_IMAGE@@
    init: true
    entrypoint: ['sleep', 'infinity']
    ports:
      - '127.0.0.1:@@APP_PORT@@:8790'
      - '127.0.0.1:@@LOGIN_PORT@@:@@LOGIN_PORT@@'
    # Lets a model server on the host answer at host.docker.internal.
    extra_hosts:
      - 'host.docker.internal:host-gateway'
    networks:
      - default
      - machine
    restart: unless-stopped

  app:
    image: @@APP_IMAGE@@
    network_mode: 'service:loopback'
    env_file:
      - .env
    environment:
      NODE_ENV: production
    volumes:
      - data:/data
    depends_on:
      loopback:
        condition: service_started
      dex:
        condition: service_healthy
    healthcheck:
      test:
        [
          'CMD',
          'node',
          '-e',
          "fetch('http://127.0.0.1:8790/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))",
        ]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 15s
    # Above the app's graceful shutdown window so a kill does not cut off turn drain.
    stop_grace_period: 35s
    restart: unless-stopped

  dex:
    image: @@DEX_IMAGE@@
    network_mode: 'service:loopback'
    command: ['dex', 'serve', '/etc/dex/config.yaml']
    # Only what login needs; the rest of the instance secrets stay with the app.
    environment:
      OIDC_CLIENT_SECRET: ${OIDC_CLIENT_SECRET:?missing from .env}
      DEX_USER_PASSWORD_HASH: ${DEX_USER_PASSWORD_HASH:?missing from .env}
    configs:
      - source: dex_config
        target: /etc/dex/config.yaml
    volumes:
      - dex:/var/dex
    healthcheck:
      test: ['CMD', 'wget', '-q', '-O', '/dev/null', 'http://127.0.0.1:@@DEX_TELEMETRY_PORT@@/healthz']
      interval: 3s
      timeout: 3s
      retries: 10
    restart: unless-stopped

configs:
  dex_config:
    file: ./dex.yaml

volumes:
  data:
    name: aman_@@NAME@@_data
  dex:
    name: aman_@@NAME@@_dex

networks:
  machine:
    name: aman_machine
    external: true
