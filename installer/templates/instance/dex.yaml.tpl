# Generated by the installer. Holds no secrets: the client secret and password hash reach Dex as
# environment variables.
issuer: @@ISSUER@@

# Sessions survive a restart.
storage:
  type: sqlite3
  config:
    file: /var/dex/dex.db

# Plain http inside the instance network namespace; the owner's reverse proxy terminates TLS for a
# public URL. The port equals the published port so the issuer name works from the browser
# and from the app container.
web:
  http: 0.0.0.0:@@LOGIN_PORT@@

# Never published: the container health check reads /healthz here.
telemetry:
  http: 127.0.0.1:@@DEX_TELEMETRY_PORT@@

oauth2:
  responseTypes: ['code']
  # The app only signs people in with the code flow. Naming it alone leaves the device, refresh and password grants off.
  grantTypes: ['authorization_code']
  skipApprovalScreen: true

enablePasswordDB: true

staticPasswords:
  - email: '@@OWNER_EMAIL@@'
    hashFromEnv: DEX_USER_PASSWORD_HASH
    username: 'owner'
    userID: 'owner'

staticClients:
  - id: @@CLIENT_ID@@
    name: Amanuensis
    secretEnv: OIDC_CLIENT_SECRET
    redirectURIs:
@@REDIRECT_URIS@@
