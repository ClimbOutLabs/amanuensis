#!/usr/bin/env bash
# Host shim installed as ~/.amanuensis/bin/aman. `aman doctor` runs machine checks with
# the Docker CLI plus each instance's in-image `aman doctor`, combined into one document.
# Read-only; needs only Docker (no jq, no Node). The state directory is AMANUENSIS_HOME.
#
#   aman doctor [--json] [--verbose] [--only ID] [--instance NAME] [--deep] [--local]
#   aman doctor instance|network [--fix [--yes]] [--instance NAME]
#   aman doctor sandbox [--fix [--yes]] [--instance NAME] [--disk-gb N] [--no-hard-disk-limit]
#   aman doctor docker|disk|backup [--fix [--yes]]
#   aman backup [NAME]
#   aman upgrade [--check] [--force]
#
# The text report uses the terminal style of <home>/lib/ui.sh (the installer puts it beside this file's folder);
# --json never loads it and is the same document as before.
#
# `doctor sandbox` checks every sandbox slot's attestation and then makes a real call through the app. The slot
# setup is the copy of packages/trueforge/scripts/sandbox-slots the installer took out of the app image; it runs on
# the Node.js the installer downloaded into <home>/runtime/node, or on the host's Node.js 22.14 or newer. With --fix it rebuilds the image, reloads the AppArmor profile,
# recreates missing slot disks and recreates the slots; it asks before any sudo.
#
# `public_url` and `public_login` run from this machine against an instance's public https addresses (its health
# endpoint and the login discovery document), only for an instance installed with https addresses.
#
# --local keeps to what needs nothing outside this machine: it skips the model check and the public https checks, which
# call out to the network. The installer uses it for status lists and the pre-upgrade gate.
#
# Exit codes: 0 no failures, 1 at least one failure, 2 usage error.
# Test hooks: AMAN_DOCTOR_NOW (epoch seconds) replaces the clock.

set -u

# The state directory: AMANUENSIS_HOME, else the folder this command was installed in (so a schedule or another
# user of a custom home needs no setting), else ~/.amanuensis.
if [ -n "${AMANUENSIS_HOME:-}" ]; then
  AMAN_HOME=$AMANUENSIS_HOME
elif [ -f "$(dirname "${BASH_SOURCE[0]}")/../state/source" ]; then
  AMAN_HOME=$(cd -P -- "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
else
  AMAN_HOME="${HOME:-}/.amanuensis"
fi
APP_SERVICE="${AMAN_DOCTOR_APP_SERVICE:-app}"
AS_JSON=0
UI_VERBOSE=0
SUMMARY=0
PROBLEMS_ONLY=0
DEEP=0
LOCAL=0
ONLY=""
ONLY_INSTANCE=""

MACHINE_IDS="docker runtime credentials images disk docker_memory clock backup"
INSTANCE_IDS="config containers ports service login database disk clock run_code attachments demo model public_url public_login network"
IN_IMAGE_IDS="service login database disk clock run_code attachments demo model"

BACKUP_WARN_DAYS=7
GIB=$((1024 * 1024 * 1024))
CLOCK_WARN_SECONDS=60
CLOCK_FAIL_SECONDS=300
# The app image build peaks near 5 GB across its parallel stages.
DOCKER_MEM_FAIL_BYTES=$((6 * GIB))
DOCKER_MEM_WARN_BYTES=$((8 * GIB))
DOCKER_MIN_COMPOSE_MAJOR=2

RECORDS=""
CAUSE_IDS=""
CLEANED=""
JSON_ESCAPED=""
DOCKER_OK=0
DOCKER_ARCH=""
DOCKER_ROOT=""
DOCKER_SYSTEM_TIME=""
DOCKER_SECURITY=""
DOCKER_OS=""
DOCKER_MEM=""
APP_CONTAINER=""

usage() {
  cat >&2 <<'USAGE'
Usage: aman doctor [--json] [--verbose] [--only ID] [--instance NAME] [--deep] [--local]
       aman doctor instance|network [--fix [--yes]] [--instance NAME]
       aman doctor sandbox [--fix [--yes]] [--instance NAME] [--disk-gb N] [--no-hard-disk-limit]
       aman doctor docker|disk|backup [--fix [--yes]]
       aman backup [NAME]
       aman upgrade [--check] [--force]
USAGE
}

die_usage() {
  printf '%s\n' "$1" >&2
  usage
  exit 2
}

# The terminal style lives in <home>/lib/ui.sh, or installer/lib/ui.sh next to installer/doctor in a checkout. Only
# the text report needs it, so --json works without it.
load_lib() { # name: sources ../lib/<name>.sh beside this file; returns 1 when it is not there
  local src=${BASH_SOURCE[0]} target file
  while [ -L "$src" ] && command -v readlink >/dev/null 2>&1; do
    target=$(readlink "$src")
    case "$target" in
      /*) src=$target ;;
      *) src="$(dirname "$src")/$target" ;;
    esac
  done
  file="$(dirname "$src")/../lib/$1.sh"
  [ -r "$file" ] || return 1
  # shellcheck source=/dev/null
  . "$file"
}

if ! load_lib shared; then
  printf 'The doctor is missing a helper file (lib/shared.sh next to its folder). Run install.sh again; it puts the file back.\n' >&2
  exit 1
fi

load_ui() {
  if ! load_lib ui; then
    printf 'The doctor is missing its display file (lib/ui.sh next to its folder). Run install.sh again; it puts the file back.\n' >&2
    exit 1
  fi
  ui_init
}

# ---------------------------------------------------------------- helpers

now_epoch() {
  if [ -n "${AMAN_DOCTOR_NOW:-}" ]; then
    printf '%s' "$AMAN_DOCTOR_NOW"
  else
    date +%s
  fi
}

# Keeps a command from hanging the report; macOS has no `timeout` unless coreutils is installed.
bounded() {
  local seconds=$1
  shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$seconds" "$@"
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$seconds" "$@"
  else
    "$@"
  fi
}

PROBE_SECONDS=5

# One printable line, at most 400 characters; JSON output needs nothing stronger after this.
# Builtins only: this runs for every field and process spawns are the slow part.
clean() {
  local value=${1//[^[:print:]]/ }
  CLEANED=${value:0:400}
}

record() { # scope id state detail fix
  local detail fix
  clean "$4"
  detail=$CLEANED
  clean "$5"
  fix=$CLEANED
  RECORDS="${RECORDS}${1}"$'\t'"${2}"$'\t'"${3}"$'\t'"${detail}"$'\t'"${fix}"$'\n'
}

# One command fixes a stopped, unhealthy or wrongly published instance; it never asks the person to read container logs.
INSTANCE_FIX="Run aman doctor instance --fix"

# A value from the instance's record in the installer's state directory.
registry_value() { # instance key
  sed -n "s/^$2=//p" "${AMAN_HOME}/state/instances/${1}.conf" 2>/dev/null | head -n 1
}

# The cause of a container failure in one sentence (starting with a space), or nothing when the log does not say.
# CAUSE_IDS holds the containers that are not running or not healthy.
container_cause_sentence() {
  local id log="" cause
  if ! load_lib diagnose; then return 0; fi
  for id in $CAUSE_IDS; do
    log="${log}$(bounded "$PROBE_SECONDS" docker logs --tail 50 "$id" 2>&1)"$'\n'
  done
  [ -n "$log" ] || return 0
  cause=$(printf '%s' "$log" | container_failure_cause_stdin)
  if [ -n "$cause" ]; then printf ' %s' "$cause"; fi
}

json_escape() {
  local value=${1//\\/\\\\}
  JSON_ESCAPED=${value//\"/\\\"}
}

# Days-from-civil arithmetic, so no GNU or BSD date flags are needed.
rfc3339_to_epoch() {
  local value=$1 date_part rest time_part tz sign offset_h offset_m offset=0
  local y m d hh mm ss era yoe mp doy doe days
  date_part=${value%%T*}
  rest=${value#*T}
  case "$rest" in
    *Z)
      time_part=${rest%Z}
      ;;
    *+*)
      time_part=${rest%+*}
      tz=${rest##*+}
      sign=1
      ;;
    *-*)
      time_part=${rest%-*}
      tz=${rest##*-}
      sign=-1
      ;;
    *) return 1 ;;
  esac
  time_part=${time_part%%.*}
  IFS=- read -r y m d <<<"$date_part"
  IFS=: read -r hh mm ss <<<"$time_part"
  case "$y$m$d$hh$mm$ss" in
    '' | *[!0-9]*) return 1 ;;
  esac
  if [ -n "${tz:-}" ]; then
    IFS=: read -r offset_h offset_m <<<"$tz"
    case "${offset_h}${offset_m}" in
      '' | *[!0-9]*) return 1 ;;
    esac
    offset=$((sign * (10#$offset_h * 3600 + 10#$offset_m * 60)))
  fi
  y=$((10#$y))
  m=$((10#$m))
  d=$((10#$d))
  if [ "$m" -le 2 ]; then y=$((y - 1)); fi
  era=$((y / 400))
  yoe=$((y - era * 400))
  mp=$(((m + 9) % 12))
  doy=$(((153 * mp + 2) / 5 + d - 1))
  doe=$((yoe * 365 + yoe / 4 - yoe / 100 + doy))
  days=$((era * 146097 + doe - 719468))
  printf '%s' $((days * 86400 + 10#$hh * 3600 + 10#$mm * 60 + 10#$ss - offset))
}

file_mtime() {
  stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null
}

file_mode() {
  stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1" 2>/dev/null
}

normalize_arch() {
  case "$1" in
    x86_64 | amd64) printf amd64 ;;
    aarch64 | arm64) printf arm64 ;;
    *) printf '%s' "$1" ;;
  esac
}

json_value() { # file key
  sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" "$1" | head -n 1
}

# ---------------------------------------------------------------- machine checks

# The one command that fixes a Docker problem where it can be fixed from here (Debian and Ubuntu); elsewhere what to open.
docker_fix_hint() { # [running|compose]
  local release=${AMAN_OS_RELEASE:-/etc/os-release}
  if [ -r "$release" ] && grep -Eq '^ID="?(debian|ubuntu)' "$release"; then
    printf 'Run aman doctor docker --fix'
  elif [ "${1:-}" = running ]; then
    printf 'Open Docker Desktop and wait until it says it is running, then run aman doctor.'
  else
    printf 'Install Docker Desktop (macOS, Windows) or Docker Engine with Compose 2 (Linux), then run aman doctor.'
  fi
}

check_docker() {
  local out rc version arch security root systime os mem compose compose_major
  if ! command -v docker >/dev/null 2>&1; then
    record machine docker fail "Docker is not installed." \
      "$(docker_fix_hint)"
    return
  fi
  out=$(bounded "$PROBE_SECONDS" docker info --format '{{.ServerVersion}}|{{.Architecture}}|{{.SecurityOptions}}|{{.DockerRootDir}}|{{.SystemTime}}|{{.OperatingSystem}}|{{.MemTotal}}' 2>&1)
  rc=$?
  if [ "$rc" -ne 0 ]; then
    case "$out" in
      *"permission denied"*)
        record machine docker fail "Your user cannot use Docker yet." \
          "Run aman doctor docker --fix"
        ;;
      *"Cannot connect"* | *"daemon running"* | *"error during connect"* | *"connection refused"*)
        record machine docker fail "Docker is installed, but it is not running." \
          "$(docker_fix_hint running)"
        ;;
      *)
        record machine docker fail "Docker did not answer: ${out%%$'\n'*}" \
          "$(docker_fix_hint running)"
        ;;
    esac
    return
  fi
  IFS='|' read -r version arch security root systime os mem <<<"$out"
  DOCKER_ARCH=$(normalize_arch "$arch")
  DOCKER_ROOT=$root
  DOCKER_SYSTEM_TIME=$systime
  DOCKER_SECURITY=$security
  DOCKER_OS=$os
  DOCKER_MEM=$mem
  compose=$(bounded "$PROBE_SECONDS" docker compose version --short 2>&1)
  rc=$?
  compose=${compose#v}
  if [ "$rc" -eq 0 ] && [[ $compose =~ ^([0-9]+)\.[0-9]+ ]]; then
    compose_major=$((10#${BASH_REMATCH[1]}))
  else
    compose_major=0
  fi
  if [ "$compose_major" -lt "$DOCKER_MIN_COMPOSE_MAJOR" ]; then
    if [ "$compose_major" -eq 0 ]; then
      record machine docker fail "Docker Compose is missing; version ${DOCKER_MIN_COMPOSE_MAJOR} is needed." "$(docker_fix_hint compose)"
    else
      record machine docker fail "Docker Compose ${compose} is too old; version ${DOCKER_MIN_COMPOSE_MAJOR} is needed." "$(docker_fix_hint compose)"
    fi
    return
  fi
  DOCKER_OK=1
  record machine docker ok "Docker ${version} is running and Compose ${compose} is available." ""
}

check_runtime() {
  local components cli_version text
  if [ "$DOCKER_OK" != 1 ]; then
    record machine runtime off "Skipped: Docker is not reachable." ""
    return
  fi
  components=$(bounded "$PROBE_SECONDS" docker version --format '{{range .Server.Components}}{{.Name}};{{end}}' 2>/dev/null)
  cli_version=$(bounded "$PROBE_SECONDS" docker --version 2>/dev/null)
  text=$(lowercase "$components $cli_version $DOCKER_OS")
  case "$text" in
    *podman*)
      record machine runtime fail "Podman is not supported." \
        "Install Docker Engine or Docker Desktop and make it the docker command, then run aman doctor."
      return
      ;;
  esac
  case "$DOCKER_SECURITY" in
    *rootless*)
      record machine runtime fail "Rootless Docker is not supported." \
        "Install the regular Docker Engine or Docker Desktop and switch to it, then run aman doctor."
      return
      ;;
  esac
  record machine runtime ok "A supported Docker runtime is in use." ""
}

check_credentials() {
  local config store helper
  config="${DOCKER_CONFIG:-${HOME:-}/.docker}/config.json"
  if [ ! -r "$config" ]; then
    record machine credentials ok "No Docker settings file, so no credential store is in use." ""
    return
  fi
  store=$(json_value "$config" credsStore)
  if [ -z "$store" ]; then
    record machine credentials ok "Docker uses no credential store." ""
    return
  fi
  helper="docker-credential-${store}"
  if ! command -v "$helper" >/dev/null 2>&1; then
    record machine credentials fail "Docker is set to use the credential store \"${store}\", but ${helper} is not on PATH; image downloads will fail with \"error getting credentials\"." \
      "Open Docker Desktop and wait until it says it is running, then run aman doctor."
    return
  fi
  if ! bounded "$PROBE_SECONDS" "$helper" list >/dev/null 2>&1; then
    record machine credentials fail "The credential store \"${store}\" is installed but did not answer; image downloads will fail." \
      "Open Docker Desktop and unlock your keychain, then run aman doctor."
    return
  fi
  record machine credentials ok "The Docker credential store \"${store}\" answers." ""
}

check_images() {
  local release key ref out rc missing="" wrong_arch="" checked=0 image_arch
  if [ "$DOCKER_OK" != 1 ]; then
    record machine images off "Skipped: Docker is not reachable." ""
    return
  fi
  release="${AMAN_HOME}/release/release.json"
  if [ ! -r "$release" ]; then
    record machine images warn "No release record was found, so the expected images are unknown." \
      "Run install.sh again from the folder Aman was installed from."
    return
  fi
  for key in app_image dex_image stt_image; do
    ref=$(json_value "$release" "$key")
    [ -n "$ref" ] || continue
    checked=$((checked + 1))
    out=$(bounded "$PROBE_SECONDS" docker image inspect --format '{{.Architecture}}' "$ref" 2>&1)
    rc=$?
    if [ "$rc" -ne 0 ]; then
      missing="${missing} ${key}"
      continue
    fi
    image_arch=$(normalize_arch "$out")
    if [ -n "$DOCKER_ARCH" ] && [ "$image_arch" != "$DOCKER_ARCH" ]; then
      wrong_arch="${wrong_arch} ${key}(${image_arch})"
    fi
  done
  if [ "$checked" -eq 0 ]; then
    record machine images warn "The release record lists no images." "Run install.sh again from the folder Aman was installed from."
  elif [ -n "$missing" ]; then
    record machine images fail "Some of Aman is not built on this computer:${missing}." \
      "Run aman upgrade"
  elif [ -n "$wrong_arch" ]; then
    record machine images fail "Images built for another CPU type than Docker uses (${DOCKER_ARCH}):${wrong_arch}." \
      "Run aman upgrade"
  else
    record machine images ok "All ${checked} images are ready." ""
  fi
}

format_gb() { # kilobytes
  awk -v kb="$1" 'BEGIN { printf "%.1f GB", kb / 1048576 }'
}

check_disk() {
  local kb bytes
  if [ "$DOCKER_OK" != 1 ]; then
    record machine disk off "Skipped: Docker is not reachable." ""
    return
  fi
  if [ -z "$DOCKER_ROOT" ] || [ ! -d "$DOCKER_ROOT" ]; then
    record machine disk off "Docker keeps its data inside a virtual machine here; free space is checked per instance." ""
    return
  fi
  kb=$(df -Pk "$DOCKER_ROOT" 2>/dev/null | awk 'NR == 2 { print $4 }')
  case "$kb" in
    '' | *[!0-9]*)
      record machine disk warn "The free space for Docker data could not be read." "Run aman doctor disk --fix"
      return
      ;;
  esac
  bytes=$((kb * 1024))
  if [ "$bytes" -lt $((2 * GIB)) ]; then
    record machine disk fail "Only $(format_gb "$kb") is free for Docker data; installs and upgrades will fail." \
      "Run aman doctor disk --fix"
  elif [ "$bytes" -lt $((10 * GIB)) ]; then
    record machine disk warn "$(format_gb "$kb") is free for Docker data; 10 GB is recommended." \
      "Run aman doctor disk --fix"
  else
    record machine disk ok "$(format_gb "$kb") is free for Docker data." ""
  fi
}

check_docker_memory() {
  local mem_fix="Raise it in Docker Desktop under Settings, Resources, Memory. On Linux, free up memory or add swap."
  if [ "$DOCKER_OK" != 1 ]; then
    record machine docker_memory off "Skipped: Docker is not reachable." ""
    return
  fi
  case "$DOCKER_MEM" in
    '' | *[!0-9]*)
      record machine docker_memory off "Skipped: Docker did not report how much memory it has." ""
      return
      ;;
  esac
  local gb
  gb=$(awk -v b="$DOCKER_MEM" 'BEGIN { printf "%.1f GB", b / 1073741824 }')
  if [ "$DOCKER_MEM" -lt "$DOCKER_MEM_FAIL_BYTES" ]; then
    record machine docker_memory fail "Docker has only ${gb} of memory; building the app needs at least 6 GB." "$mem_fix"
  elif [ "$DOCKER_MEM" -lt "$DOCKER_MEM_WARN_BYTES" ]; then
    record machine docker_memory warn "Docker has ${gb} of memory; 8 GB is recommended for builds and upgrades." "$mem_fix"
  else
    record machine docker_memory ok "Docker has ${gb} of memory." ""
  fi
}

check_clock() {
  local daemon now skew
  if [ "$DOCKER_OK" != 1 ]; then
    record machine clock off "Skipped: Docker is not reachable." ""
    return
  fi
  if ! daemon=$(rfc3339_to_epoch "$DOCKER_SYSTEM_TIME"); then
    record machine clock off "Skipped: Docker did not report a readable time." ""
    return
  fi
  now=$(now_epoch)
  skew=$((now - daemon))
  if [ "$skew" -lt 0 ]; then skew=$((-skew)); fi
  local fix="Turn on automatic time sync in your system settings (with Docker Desktop, restart it: its clock drifts after the computer sleeps)."
  if [ "$skew" -gt "$CLOCK_FAIL_SECONDS" ]; then
    record machine clock fail "This machine and Docker disagree on the time by ${skew} seconds; sign-in will fail." "$fix"
  elif [ "$skew" -gt "$CLOCK_WARN_SECONDS" ]; then
    record machine clock warn "This machine and Docker disagree on the time by ${skew} seconds." "$fix"
  else
    record machine clock ok "This machine and Docker agree on the time." ""
  fi
}

# A schedule turned on within the last two days has not had its first run yet.
backup_mode_is_recent() {
  local mtime
  mtime=$(file_mtime "$(backups_mode_file)")
  case "$mtime" in '' | *[!0-9]*) return 1 ;; esac
  [ $(($(now_epoch) - mtime)) -lt 172800 ]
}

check_backup() {
  local dir newest="" newest_time=0 entry mtime age_days=-1 now mode scheduled=0 days=""
  dir="${AMAN_HOME}/backups"
  for entry in "$dir"/*/; do
    [ -d "$entry" ] || continue
    mtime=$(file_mtime "$entry")
    case "$mtime" in '' | *[!0-9]*) continue ;; esac
    if [ "$mtime" -gt "$newest_time" ]; then
      newest_time=$mtime
      newest=$entry
    fi
  done
  now=$(now_epoch)
  if [ -n "$newest" ]; then
    age_days=$(((now - newest_time) / 86400))
    days=$([ "$age_days" = 1 ] && echo "1 day" || echo "${age_days} days")
  fi
  STATE_DIR="${AMAN_HOME}/state"
  mode=""
  if load_lib schedule; then
    mode=$(backups_mode)
    if backup_schedule_present; then scheduled=1; fi
  fi
  case "$mode" in
    daily)
      if [ "$scheduled" != 1 ]; then
        record machine backup warn "Daily backups are on, but the schedule that runs them is missing." "Run aman doctor backup --fix"
      elif [ "$age_days" -lt 0 ] && backup_mode_is_recent; then
        record machine backup ok "Daily backups are on; the first one runs within a day." ""
      elif [ "$age_days" -lt 0 ] || [ "$age_days" -gt 2 ]; then
        record machine backup warn "Daily backups are scheduled, but ${newest:+the last one is ${days} old}${newest:-none has been made yet}." "Run aman doctor backup --fix"
      else
        record machine backup ok "Daily backups are on; the last one is ${days} old." ""
      fi
      ;;
    off)
      if [ "$age_days" -gt "$BACKUP_WARN_DAYS" ]; then
        record machine backup warn "Automatic backups are off, and the last backup is ${days} old." "Run aman doctor backup --fix"
      else
        record machine backup ok "Automatic backups are off." ""
      fi
      ;;
    *)
      if [ -z "$newest" ]; then
        record machine backup ok "No backup yet; one is made automatically before your first upgrade." ""
      elif [ "$age_days" -gt "$BACKUP_WARN_DAYS" ]; then
        record machine backup warn "The last backup is ${days} old." "Run aman backup"
      else
        record machine backup ok "The last backup is ${days} old." ""
      fi
      ;;
  esac
}

# ---------------------------------------------------------------- instance checks

check_instance_config() {
  local name=$1 file mode dir
  dir="${AMAN_HOME}/instances/${name}"
  if [ ! -f "${dir}/.env" ]; then
    record "$name" config fail "The instance settings file is missing." \
      "Restore this instance from a backup in ${AMAN_HOME}/backups."
    return
  fi
  # dex.env holds the login password hash; both files hold secrets.
  for file in "${dir}/.env" "${dir}/dex.env"; do
    [ -f "$file" ] || continue
    mode=$(file_mode "$file")
    if [ "$mode" != 600 ]; then
      record "$name" config fail "${file##*/} holds secrets but is readable by other users (mode ${mode:-unknown})." \
        "$INSTANCE_FIX"
      return
    fi
  done
  summarize_users "$dir"
  if [ "$USERS_SHORT" = 1 ]; then
    record "$name" config warn "The settings files are private to you.${USERS_SUMMARY} Fewer emails are allowed to sign in than there are users." \
      "Run install.sh instance list-users, then instance add-user again for each member; it repairs the allowed emails."
    return
  fi
  record "$name" config ok "The settings files exist and are private to you.${USERS_SUMMARY}" ""
}

# Sets USERS_SUMMARY (" N sign-in user(s): the owner and M member(s).") from the hash variables in dex.env, and
# USERS_SHORT=1 when fewer emails are allowed than there are users. Hashes are counted, never printed.
summarize_users() { # instance dir
  local users members allowed
  USERS_SUMMARY=""
  USERS_SHORT=0
  [ -f "${1}/dex.env" ] || return 0
  users=$(awk '/^DEX_USER_PASSWORD_HASH(_[A-Z0-9_]+)?=/ { n++ } END { print n + 0 }' "${1}/dex.env" 2>/dev/null)
  users=${users:-0}
  members=0
  if [ "$users" -gt 0 ]; then members=$((users - 1)); fi
  USERS_SUMMARY=" ${users} sign-in user(s): the owner and ${members} member(s)."
  allowed=$(sed -n 's/^OIDC_ALLOWED_EMAILS=//p' "${1}/.env" 2>/dev/null | awk 'END { print }')
  case "$allowed" in
    '' | *'*'*) return 0 ;;
  esac
  if [ "$(printf '%s' "$allowed" | tr ',' '\n' | awk 'NF { n++ } END { print n + 0 }')" -lt "$users" ]; then USERS_SHORT=1; fi
}

# What a container is, in words for a person: "the main app" for the app of instance main.
container_words() { # instance service
  case "$2" in
    app) printf 'the %s app' "$1" ;;
    dex) printf 'the %s sign-in service' "$1" ;;
    loopback) printf 'the %s network link' "$1" ;;
    *) printf 'the %s %s' "$1" "$2" ;;
  esac
}

# "the main app", or "the main app and the main sign-in service", from a list of words separated by "|".
join_words() {
  local list=${1#|} out="" word count=0 total
  total=$(printf '%s' "$list" | awk -F'|' '{ print NF }')
  while IFS= read -r word; do
    count=$((count + 1))
    if [ -z "$out" ]; then out=$word; elif [ "$count" -eq "$total" ]; then out="$out and $word"; else out="$out, $word"; fi
  done < <(printf '%s\n' "$list" | tr '|' '\n')
  printf '%s' "$out"
}

check_instance_containers() { # name; sets APP_CONTAINER
  local name=$1 line id cname state status service bad="" unhealthy="" starting="" found=0 ports exposed="" count=0 words
  APP_CONTAINER=""
  CAUSE_IDS=""
  local lines
  lines=$(bounded "$PROBE_SECONDS" docker ps -a --filter "label=com.docker.compose.project=aman-${name}" \
    --format '{{.ID}}|{{.Names}}|{{.State}}|{{.Status}}|{{.Label "com.docker.compose.service"}}' 2>/dev/null)
  while IFS='|' read -r id cname state status service; do
    [ -n "$id" ] || continue
    found=1
    count=$((count + 1))
    case "$state" in
      running)
        if [ "$service" = "$APP_SERVICE" ]; then APP_CONTAINER=$id; fi
        case "$status" in
          *"(unhealthy)"*)
            unhealthy="${unhealthy}|$(container_words "$name" "$service")"
            CAUSE_IDS="${CAUSE_IDS} ${id}"
            ;;
          *"(health: starting)"*) starting="${starting}|$(container_words "$name" "$service")" ;;
        esac
        ports=$(bounded "$PROBE_SECONDS" docker port "$id" 2>/dev/null)
        # An instance opened on the network publishes the app port (8790 inside) on every interface on purpose.
        if [ -n "$(registry_value "$name" origins)" ]; then ports=$(printf '%s\n' "$ports" | grep -v '^8790/tcp' || true); fi
        case "$ports" in
          *"0.0.0.0:"* | *"[::]:"* | *":::"*) exposed="${exposed}|$(container_words "$name" "$service")" ;;
        esac
        ;;
      exited)
        case "$status" in
          "Exited (0)"*) ;;
          *)
            bad="${bad}|$(container_words "$name" "$service")"
            CAUSE_IDS="${CAUSE_IDS} ${id}"
            ;;
        esac
        ;;
      *)
        bad="${bad}|$(container_words "$name" "$service")"
        CAUSE_IDS="${CAUSE_IDS} ${id}"
        ;;
    esac
  done <<<"$lines"
  if [ "$found" = 0 ]; then
    record "$name" containers fail "Instance $name is stopped." "$INSTANCE_FIX"
    record "$name" ports off "Skipped: the instance has no containers." ""
    return
  fi
  if [ -n "$bad" ]; then
    words=$(join_words "$bad")
    record "$name" containers fail "$(capitalize "$words") $(is_are "$bad") not running.$(container_cause_sentence)" "$INSTANCE_FIX"
  elif [ -n "$unhealthy" ]; then
    words=$(join_words "$unhealthy")
    record "$name" containers fail "$(capitalize "$words") $(is_are "$unhealthy") not healthy.$(container_cause_sentence)" "$INSTANCE_FIX"
  elif [ -n "$starting" ]; then
    words=$(join_words "$starting")
    record "$name" containers warn "$(capitalize "$words") $(is_are "$starting") still starting." "Wait a minute, then run aman doctor."
  else
    record "$name" containers ok "All ${count} parts of instance $name are running." ""
  fi
  if [ -n "$exposed" ]; then
    words=$(join_words "$exposed")
    record "$name" ports fail "$(capitalize "$words") $(is_are "$exposed") open to the whole network, not just this computer." "$INSTANCE_FIX"
  elif [ -n "$(registry_value "$name" origins)" ]; then
    record "$name" ports ok "The app is open to your network on purpose, so other devices can open Aman; sign-in stays on this computer." ""
  else
    record "$name" ports ok "Aman listens on this computer only." ""
  fi
}

capitalize() { printf '%s%s' "$(printf '%s' "${1:0:1}" | tr '[:lower:]' '[:upper:]')" "${1:1}"; }

# "is" for one item of a "|" list, "are" for several.
is_are() { case "${1#|}" in *"|"*) printf are ;; *) printf is ;; esac; }

in_list() { # word list
  case " $2 " in *" $1 "*) return 0 ;; esac
  return 1
}

run_in_image_checks() { # name
  # The model check waits on a hosted model, so the whole run gets more room than the local checks need.
  local name=$1 out rc line id state detail fix exec_timeout=45 args=(doctor --text)
  if [ "$DEEP" = 1 ]; then
    exec_timeout=90
    args+=(--deep)
  fi
  if [ "$LOCAL" = 1 ]; then
    args+=(--local)
  fi
  if [ -n "$ONLY" ] && in_list "$ONLY" "$IN_IMAGE_IDS"; then
    args+=(--only "$ONLY")
  fi
  # The host passes its own time: the app's clock is judged against the host, not against a service on it.
  out=$(bounded "$exec_timeout" docker exec -e "AMAN_HOST_EPOCH=$(now_epoch)" "$APP_CONTAINER" aman "${args[@]}" 2>&1)
  rc=$?
  if [ "$rc" -ne 0 ] && [ "$rc" -ne 1 ]; then
    record "$name" service fail "The checks could not run inside the app container: ${out%%$'\n'*}" \
      "$INSTANCE_FIX"
    return
  fi
  while IFS=$'\t' read -r id state detail fix; do
    case "$state" in
      ok | warn | fail | off) record "$name" "$id" "$state" "$detail" "$fix" ;;
    esac
  done <<<"$out"
}

PROBE_RC=0
PROBE_CODE=""
PROBE_BODY=""
PROBE_ERR=""

# One https request from this machine; a second form pins the name to this machine to tell a broken public path
# (DNS, firewall, a cloud that does not loop back) from a broken proxy.
http_probe() { # url [host:port:address]
  local url=$1 pin=${2:-} out args=(-sS --max-time 10 -w $'\n%{http_code}')
  if [ -n "$pin" ]; then args+=(--resolve "$pin"); fi
  out=$(bounded 15 curl "${args[@]}" "$url" 2>&1)
  PROBE_RC=$?
  PROBE_CODE=""
  PROBE_BODY=""
  PROBE_ERR=""
  if [ "$PROBE_RC" -ne 0 ]; then
    clean "${out##*$'\n'}"
    PROBE_ERR=$CLEANED
    return
  fi
  PROBE_CODE=${out##*$'\n'}
  PROBE_BODY=${out%$'\n'*}
}

public_check() { # name id url what [expected issuer]
  local name=$1 id=$2 url=$3 what=$4 want=${5:-} rest host port=443 first_error="" pinned=0 got
  local fix_path="Run aman doctor instance --fix. If it still fails, the DNS records or the firewall (port 443) are the cause."
  rest=${url#https://}
  host=${rest%%/*}
  case "$host" in *:*)
    port=${host##*:}
    host=${host%%:*}
    ;;
  esac
  http_probe "$url"
  if [ "$PROBE_RC" -ne 0 ]; then
    first_error=$PROBE_ERR
    http_probe "$url" "${host}:${port}:127.0.0.1"
    if [ "$PROBE_RC" -ne 0 ]; then
      record "$name" "$id" fail "${what} did not answer over https (${first_error:-no answer})." "$fix_path"
      return
    fi
    pinned=1
  fi
  if [ "$PROBE_CODE" != 200 ]; then
    record "$name" "$id" fail "${what} answered status ${PROBE_CODE}, not 200." \
      "$INSTANCE_FIX"
    return
  fi
  if [ -n "$want" ]; then
    got=$(printf '%s' "$PROBE_BODY" | tr -d '\n' | sed -n 's/.*"issuer"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    if [ "$got" != "$want" ]; then
      record "$name" "$id" fail "The sign-in service reports the address ${got:-missing}, not ${want}." \
        "$INSTANCE_FIX"
      return
    fi
  fi
  if [ "$pinned" = 1 ]; then
    record "$name" "$id" warn "${what} answers on this machine with a valid certificate, but not through its public address from here (${first_error:-no answer})." \
      "Your cloud may not reach this computer's public address from inside it; this is only a warning."
    return
  fi
  record "$name" "$id" ok "${what} answers over https." ""
}

# The addresses people use, checked the way a browser reaches them. Skipped for an instance with local addresses only.
check_instance_public() { # name
  local name=$1 file public issuer
  file="${AMAN_HOME}/instances/${name}/.env"
  [ -r "$file" ] || return 0
  public=$(sed -n 's/^PUBLIC_BASE_URL=//p' "$file" | head -n 1)
  issuer=$(sed -n 's/^OIDC_ISSUER_URL=//p' "$file" | head -n 1)
  case "$public" in https://*) ;; *) return 0 ;; esac
  if ! command -v curl >/dev/null 2>&1; then
    record "$name" public_url off "Skipped: curl is not installed, so the public https address cannot be tried." ""
    return 0
  fi
  public_check "$name" public_url "${public}/healthz" "The app at ${public}"
  case "$issuer" in
    https://*) public_check "$name" public_login "${issuer}/.well-known/openid-configuration" "The login provider at ${issuer}" "$issuer" ;;
  esac
}

check_instance() {
  check_instance_core "$1"
  if [ "$LOCAL" != 1 ]; then check_instance_public "$1"; fi
  check_instance_network "$1"
}

# An instance opened on the network lists the addresses it answers at; a new address of this computer (another
# network, a changed DHCP lease, Tailscale coming up) is not on the list until the instance is refreshed, and sign-in
# is refused there. Nothing is recorded for an instance that is open on this computer only.
check_instance_network() {
  local name=$1 origins port host missing='' count
  origins=$(registry_value "$name" origins)
  [ -n "$origins" ] || return 0
  if ! load_lib network; then
    record "$name" network off "Skipped: the network helper file (lib/network.sh next to the doctor's folder) is missing." ""
    return
  fi
  port=$(registry_value "$name" app_port)
  # shellcheck disable=SC2046,SC2086 # the extra hosts are checked names without spaces
  for host in $(network_default_hosts) $(registry_value "$name" extra_hosts); do
    case ",${origins}," in
      *",http://${host}:${port},"*) ;;
      *) missing="${missing} ${host}" ;;
    esac
  done
  if [ -n "$missing" ]; then
    record "$name" network warn "This computer has addresses Aman is not set up for:${missing}. Until they are added, every page opened at them is refused." \
      "Run aman doctor network --fix"
    return
  fi
  count=$(printf '%s\n' "$origins" | tr ',' '\n' | wc -l | tr -d ' ')
  record "$name" network ok "Aman opens at ${count} addresses of this computer, and sign-in works at each." ""
}

check_instance_core() {
  local name=$1
  check_instance_config "$name"
  if [ "$DOCKER_OK" != 1 ]; then
    record "$name" service fail "Docker is not reachable, so this instance cannot be checked." \
      "Fix the Docker problem reported under the machine checks first."
    return
  fi
  check_instance_containers "$name"
  if [ -z "$APP_CONTAINER" ]; then
    # The containers check above already says what is down; one line, not two.
    record "$name" service off "Skipped: the app is not running." ""
    return
  fi
  run_in_image_checks "$name"
}

list_instances() {
  local entry
  for entry in "${AMAN_HOME}/instances"/*/; do
    [ -d "$entry" ] || continue
    entry=${entry%/}
    printf '%s\n' "${entry##*/}"
  done
}

# ---------------------------------------------------------------- output

visible_records() { # scope
  local scope=$1 line
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$line" in
      "${scope}"$'\t'*) ;;
      *) continue ;;
    esac
    if [ -n "$ONLY" ]; then
      local rest=${line#*$'\t'}
      [ "${rest%%$'\t'*}" = "$ONLY" ] || continue
    fi
    printf '%s\n' "$line"
  done <<<"$RECORDS"
}

json_checks() { # scope
  local first=1 line scope id state detail fix
  printf '['
  while IFS=$'\t' read -r scope id state detail fix; do
    [ -n "$scope" ] || continue
    if [ "$first" = 1 ]; then first=0; else printf ','; fi
    json_escape "$id"
    id=$JSON_ESCAPED
    json_escape "$detail"
    detail=$JSON_ESCAPED
    json_escape "$fix"
    fix=$JSON_ESCAPED
    printf '{"id":"%s","state":"%s","detail":"%s","fix":"%s"}' "$id" "$state" "$detail" "$fix"
  done < <(visible_records "$1")
  printf ']'
}

# Skipped checks with the same reason print as one line, so one failure does not look like six.
SKIP_IDS=""
SKIP_DETAIL=""
flush_skipped() {
  if [ -n "$SKIP_IDS" ]; then ui_skip "$SKIP_DETAIL ($SKIP_IDS)"; fi
  SKIP_IDS=""
  SKIP_DETAIL=""
}

text_checks() { # scope
  local scope id state detail fix label
  while IFS=$'\t' read -r scope id state detail fix; do
    [ -n "$scope" ] || continue
    if [ "$PROBLEMS_ONLY" = 1 ]; then
      case "$state" in warn | fail) ;; *) continue ;; esac
    fi
    case "$state" in
      ok | warn | fail) ;;
      *)
        if [ -n "$SKIP_IDS" ] && [ "$SKIP_DETAIL" != "$detail" ]; then flush_skipped; fi
        SKIP_DETAIL=$detail
        SKIP_IDS="${SKIP_IDS:+$SKIP_IDS, }$id"
        continue
        ;;
    esac
    flush_skipped
    # Two checks that pass without saying anything useful are counted but not shown, unless asked for.
    if [ "$state" = ok ] && [ "$UI_VERBOSE" != 1 ] && in_list "$id" "runtime credentials"; then continue; fi
    label=$detail
    if [ "$UI_VERBOSE" = 1 ]; then label="$detail ($id)"; fi
    case "$state" in
      ok) ui_ok "$label" ;;
      warn) ui_warn "$label" "$fix" ;;
      fail) ui_fail "$label" "$fix" ;;
    esac
  done < <(visible_records "$1")
  flush_skipped
}

# Counts of the visible checks of a scope: sets N_OK, N_WARN, N_FAIL and N_OFF.
count_checks() { # scope
  local scope id state _rest
  N_OK=0
  N_WARN=0
  N_FAIL=0
  N_OFF=0
  while IFS=$'\t' read -r scope id state _rest; do
    [ -n "$scope" ] || continue
    case "$state" in
      ok) N_OK=$((N_OK + 1)) ;;
      warn) N_WARN=$((N_WARN + 1)) ;;
      fail) N_FAIL=$((N_FAIL + 1)) ;;
      *) N_OFF=$((N_OFF + 1)) ;;
    esac
  done < <(visible_records "$1")
}

plural() { # count word
  if [ "$1" = 1 ]; then printf '1 %s' "$2"; else printf '%s %ss' "$1" "$2"; fi
}

# The closing block: how many problems and warnings there are, or that all is well.
print_verdict() {
  local scope fails=0 warns=0 parts=""
  for scope in machine "${INSTANCES[@]+"${INSTANCES[@]}"}"; do
    count_checks "$scope"
    fails=$((fails + N_FAIL))
    warns=$((warns + N_WARN))
  done
  if [ "$fails" -gt 0 ]; then parts="$(plural "$fails" problem)"; fi
  if [ "$warns" -gt 0 ]; then parts="${parts:+$parts, }$(plural "$warns" warning)"; fi
  if [ "$fails" -gt 0 ]; then
    ui_summary fail "$parts."
    ui_line "Run the Next command for each, then run aman doctor again."
  elif [ "$warns" -gt 0 ]; then
    ui_summary warn "$parts."
    ui_line "Run the Next command for each, then run aman doctor again."
  else
    ui_summary ok "All checks passed."
  fi
  ui_summary_end
}

print_json() {
  local name first=1
  printf '{"machine":'
  json_checks machine
  printf ',"instances":{'
  for name in "${INSTANCES[@]+"${INSTANCES[@]}"}"; do
    if [ "$first" = 1 ]; then first=0; else printf ','; fi
    json_escape "$name"
    printf '"%s":' "$JSON_ESCAPED"
    json_checks "$name"
  done
  printf '}}\n'
}

print_text() {
  local name
  load_ui
  if [ "$SUMMARY" = 1 ]; then
    print_summary
    return
  fi
  ui_phase "Checking this computer"
  text_checks machine
  for name in "${INSTANCES[@]+"${INSTANCES[@]}"}"; do
    ui_phase "Checking instance $name"
    text_checks "$name"
  done
  print_verdict
}

# What the installer shows after a run: one line when everything passed, otherwise only the problems.
print_summary() {
  local scope label passed=0 problems=0
  for scope in machine "${INSTANCES[@]+"${INSTANCES[@]}"}"; do
    count_checks "$scope"
    passed=$((passed + N_OK))
    problems=$((problems + N_WARN + N_FAIL))
  done
  if [ "$problems" -eq 0 ]; then
    ui_ok "All $passed checks passed"
    return
  fi
  PROBLEMS_ONLY=1
  for scope in machine "${INSTANCES[@]+"${INSTANCES[@]}"}"; do
    count_checks "$scope"
    if [ $((N_WARN + N_FAIL)) -eq 0 ]; then continue; fi
    if [ "$scope" = machine ]; then label="This computer"; else label="Instance $scope"; fi
    ui_line "$label"
    text_checks "$scope"
  done
  PROBLEMS_ONLY=0
  ui_hint "$passed other checks passed. Full report: aman doctor"
}

select_instances() {
  INSTANCES=()
  if [ -n "$ONLY_INSTANCE" ]; then
    case "$ONLY_INSTANCE" in
      '' | *[!a-z0-9-]* | -*) die_usage "Instance names use lowercase letters, digits and hyphens." ;;
    esac
    [ -d "${AMAN_HOME}/instances/${ONLY_INSTANCE}" ] || die_usage "No instance named \"${ONLY_INSTANCE}\" under ${AMAN_HOME}/instances."
    INSTANCES=("$ONLY_INSTANCE")
  else
    while IFS= read -r instance_name; do
      [ -n "$instance_name" ] && INSTANCES+=("$instance_name")
    done < <(list_instances)
  fi
}

# ---------------------------------------------------------------- sandbox

record_state() { # scope id
  local scope id state _rest
  while IFS=$'\t' read -r scope id state _rest; do
    if [ "$scope" = "$1" ] && [ "$id" = "$2" ]; then
      printf '%s' "$state"
      return 0
    fi
  done <<<"$RECORDS"
}

# The pinned runtime the installer downloaded, else the host's Node.js when it is new enough; empty when neither is.
sandbox_node_path() {
  if [ -x "${AMAN_HOME}/runtime/node/bin/node" ]; then
    printf '%s' "${AMAN_HOME}/runtime/node/bin/node"
  elif sandbox_node_ok; then
    command -v node
  fi
}

# The slots come back after a restart only if Docker itself starts at boot.
docker_boot_state() { # prints enabled, or the reason it is not
  command -v systemctl >/dev/null 2>&1 || return 0
  systemctl cat docker.service >/dev/null 2>&1 || return 0
  systemctl is-enabled --quiet docker 2>/dev/null || printf 'disabled'
}

# The instances that have the sandbox: their record says so, or their app is already wired to the slots.
sandbox_instances() {
  local name compose
  for name in "${INSTANCES[@]+"${INSTANCES[@]}"}"; do
    compose=$(cat "${AMAN_HOME}/instances/${name}/compose.yaml" 2>/dev/null)
    case "$compose" in
      *"SANDBOX_BACKEND: slots"*) printf '%s\n' "$name" ;;
      *) if [ "$(registry_value "$name" sandbox)" = slots ]; then printf '%s\n' "$name"; fi ;;
    esac
  done
}

# True when the settings that connect the app to its sandboxes are all there.
sandbox_settings_complete() { # name
  local compose
  compose=$(cat "${AMAN_HOME}/instances/${1}/compose.yaml" 2>/dev/null)
  case "$compose" in
    *"SANDBOX_BACKEND: slots"*"SANDBOX_SLOTS: "*"SANDBOX_SLOTS_DIR: "*) return 0 ;;
  esac
  return 1
}

doctor_sandbox() {
  local fix=0 yes=0 passthru=() bundle source repo name args state failed=0 targets=() node_bin installer
  while [ $# -gt 0 ]; do
    case "$1" in
      --fix) fix=1 ;;
      --yes) yes=1 ;;
      --verbose) UI_VERBOSE=1 ;;
      --no-hard-disk-limit) passthru+=(--no-hard-disk-limit) ;;
      --disk-gb)
        [ $# -ge 2 ] || die_usage "--disk-gb needs a number."
        passthru+=(--disk-gb "$2")
        shift
        ;;
      --instance)
        [ $# -ge 2 ] || die_usage "--instance needs a name."
        ONLY_INSTANCE=$2
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      *) die_usage "Unknown argument: $1" ;;
    esac
    shift
  done
  if [ "$yes" = 1 ] && [ "$fix" != 1 ]; then die_usage "--yes goes with --fix."; fi
  select_instances
  load_ui
  UI_ASSUME_YES=$yes
  bundle="${AMAN_HOME}/bin/aman-sandbox.mjs"
  source="${AMAN_HOME}/state/source"
  if [ ! -f "$bundle" ] || [ ! -r "$source" ]; then
    UI_FD=2 ui_fail "The sandbox tools are not installed under $(ui_path "$AMAN_HOME")." "Run install.sh again from the folder Aman was installed from."
    exit 1
  fi
  repo=$(head -n 1 "$source")
  if [ ! -f "${repo}/docker-compose.slots.yml" ]; then
    UI_FD=2 ui_fail "The checkout the sandbox was installed from is not at $(ui_path "$repo") any more." "Run install.sh again from that folder."
    exit 1
  fi
  node_bin=$(sandbox_node_path)
  if [ -z "$node_bin" ]; then
    UI_FD=2 ui_fail "No Node.js runtime for the sandbox setup was found (in $(ui_path "$AMAN_HOME")/runtime/node, or Node.js $SANDBOX_NODE_MAJOR.$SANDBOX_NODE_MINOR or newer on this computer)." "Run install.sh again from the folder Aman was installed from."
    exit 1
  fi
  check_docker
  if [ "$DOCKER_OK" != 1 ]; then
    text_checks machine
    exit 1
  fi
  while IFS= read -r name; do
    [ -n "$name" ] && targets+=("$name")
  done < <(sandbox_instances)
  if [ "${#targets[@]}" -eq 0 ]; then
    ui_skip "No instance has the sandbox (it was installed with --no-sandbox, or no instance exists yet)."
    exit 0
  fi
  if [ "$(docker_boot_state)" = disabled ]; then
    ui_warn "Docker does not start at boot here, so the sandbox stays down after a restart." "Run aman doctor sandbox --fix"
    # --yes is the explicit approval for this root step; without it the question defaults to no.
    if [ "$fix" = 1 ] && { [ "$yes" = 1 ] || ui_confirm "Turn Docker on at boot now? This needs sudo." n; }; then
      sudo systemctl enable docker || failed=1
    fi
  fi
  for name in "${targets[@]}"; do
    if ! sandbox_settings_complete "$name"; then
      # Settings the installer writes from its template and the record, so the same rewrite as `instance refresh`.
      if [ "$fix" != 1 ]; then
        ui_warn "The sandbox settings of instance $name are incomplete." "Run aman doctor sandbox --fix"
        failed=1
        continue
      fi
      if ! installer=$(checkout_installer); then
        ui_fail "Aman cannot find the folder it was installed from." "Run install.sh again from that folder."
        failed=1
        continue
      fi
      if ui_confirm "Rewrite the sandbox settings of instance $name and restart it?" y; then
        bash "$installer" --home "$AMAN_HOME" --yes instance refresh "$name" || {
          failed=1
          continue
        }
      else
        failed=1
        continue
      fi
    fi
    args=(--instance "$name" --repo-root "$repo" --log-file "${AMAN_HOME}/state/sandbox.log" --command-name "${AMAN_HOME}/bin/aman doctor sandbox" "${passthru[@]+"${passthru[@]}"}")
    if [ "$UI_VERBOSE" = 1 ]; then args+=(--verbose); fi
    if [ "$fix" = 1 ]; then
      args+=(--fix --restart)
      if [ "$yes" = 1 ]; then args+=(--yes); fi
    else
      args+=(--check)
    fi
    if ! "$node_bin" "$bundle" "${args[@]}"; then
      failed=1
      continue
    fi
    # The slots are healthy; now the app's own view of them, which is what Settings > Sandbox reports.
    RECORDS=""
    ONLY=run_code
    check_instance_containers "$name"
    if [ -z "$APP_CONTAINER" ]; then
      record "$name" run_code fail "The $name app is not running, so run code could not be tried." "$INSTANCE_FIX"
    else
      run_in_image_checks "$name"
    fi
    text_checks "$name"
    state=$(record_state "$name" run_code)
    if [ "$state" != ok ]; then failed=1; fi
  done
  exit "$failed"
}

# The installer the sandbox tools were set up from, which knows how to render an instance again.
checkout_installer() {
  local source="${AMAN_HOME}/state/source" repo
  [ -r "$source" ] || return 1
  repo=$(head -n 1 "$source")
  [ -f "${repo}/installer/install.sh" ] || return 1
  printf '%s' "${repo}/installer/install.sh"
}

# aman doctor instance|network [--fix [--yes]] [--instance NAME]: show the check and, with --fix, let the installer
# render the instance again from its record and restart it.
doctor_repair() { # kind
  local kind=$1 fix=0 yes=0 name installer failed=0 question args=()
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --fix) fix=1 ;;
      --yes) yes=1 ;;
      --verbose) UI_VERBOSE=1 ;;
      --instance)
        [ $# -ge 2 ] || die_usage "--instance needs a name."
        ONLY_INSTANCE=$2
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      *) die_usage "Unknown argument: $1" ;;
    esac
    shift
  done
  if [ "$yes" = 1 ] && [ "$fix" != 1 ]; then die_usage "--yes goes with --fix."; fi
  select_instances
  load_ui
  UI_ASSUME_YES=$yes
  check_docker
  if [ "$DOCKER_OK" != 1 ]; then
    text_checks machine
    exit 1
  fi
  if [ "${#INSTANCES[@]}" -eq 0 ]; then
    ui_skip "There is no instance yet."
    exit 0
  fi
  for name in "${INSTANCES[@]}"; do
    RECORDS=""
    ui_phase "Instance $name"
    if [ "$kind" = network ]; then
      check_instance_network "$name"
      if [ -z "$RECORDS" ]; then
        ui_skip "Open on this computer only; there are no network addresses to keep up to date"
        continue
      fi
    else
      check_instance_containers "$name"
    fi
    text_checks "$name"
    count_checks "$name"
    if [ $((N_WARN + N_FAIL)) -eq 0 ] || [ "$fix" != 1 ]; then
      if [ "$N_FAIL" -gt 0 ]; then failed=1; fi
      continue
    fi
    if ! installer=$(checkout_installer); then
      ui_fail "Aman cannot find the folder it was installed from." "Run install.sh again from that folder."
      failed=1
      continue
    fi
    args=(--home "$AMAN_HOME" --yes instance refresh "$name")
    if [ "$kind" = network ]; then
      question="Add this computer's current addresses to instance $name and restart it?"
    else
      question="Restart instance $name now?"
    fi
    if ui_confirm "$question" y; then
      if bash "$installer" "${args[@]}"; then ui_ok "Instance $name is fixed"; else failed=1; fi
    fi
  done
  exit "$failed"
}

# The Aman images this computer no longer needs: every aman-app and aman-stt image that is not the recorded release and
# that no container uses.
unused_aman_images() {
  local release="${AMAN_HOME}/release/release.json" keep image used
  keep=" $(json_value "$release" app_image) $(json_value "$release" stt_image) "
  used=" $(docker ps -a --format '{{.Image}}' 2>/dev/null | tr '\n' ' ') "
  while IFS= read -r image; do
    case "$image" in aman-app:* | aman-stt:*) ;; *) continue ;; esac
    case "$keep$used" in *" $image "*) continue ;; esac
    printf '%s\n' "$image"
  done < <(docker images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null)
}

# aman doctor disk --fix: removes old Aman images and the build cache, after asking.
fix_disk() {
  local images count image
  images=$(unused_aman_images)
  count=$(printf '%s' "$images" | awk 'NF { n++ } END { print n + 0 }')
  if ui_confirm "Remove $count unused Aman image(s) and the build cache? Nothing that runs is touched." y; then
    while IFS= read -r image; do
      [ -n "$image" ] || continue
      docker rmi "$image" >/dev/null 2>&1 || ui_warn "Could not remove $image" ""
    done <<<"$images"
    docker builder prune -f >/dev/null 2>&1 || true
    ui_ok "Removed the old Aman images and the build cache"
  fi
}

# aman doctor docker|disk|backup [--fix [--yes]]: the machine checks of one area and, with --fix, the one repair.
doctor_machine_repair() { # kind
  local kind=$1 fix=0 yes=0 installer failed=0
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --fix) fix=1 ;;
      --yes) yes=1 ;;
      --verbose) UI_VERBOSE=1 ;;
      -h | --help)
        usage
        exit 0
        ;;
      *) die_usage "Unknown argument: $1" ;;
    esac
    shift
  done
  if [ "$yes" = 1 ] && [ "$fix" != 1 ]; then die_usage "--yes goes with --fix."; fi
  load_ui
  UI_ASSUME_YES=$yes
  RECORDS=""
  case "$kind" in
    docker)
      check_docker
      check_runtime
      check_credentials
      ;;
    disk)
      check_docker
      check_disk
      ;;
    backup) check_backup ;;
  esac
  text_checks machine
  count_checks machine
  if [ "$N_FAIL" -gt 0 ]; then failed=1; fi
  if [ $((N_WARN + N_FAIL)) -eq 0 ] || [ "$fix" != 1 ]; then exit "$failed"; fi
  if ! installer=$(checkout_installer); then
    ui_fail "Aman cannot find the folder it was installed from." "Run install.sh again from that folder."
    exit 1
  fi
  case "$kind" in
    docker) bash "$installer" --home "$AMAN_HOME" docker || exit 1 ;;
    disk) fix_disk ;;
    backup)
      bash "$installer" --home "$AMAN_HOME" --yes backups daily || exit 1
      bash "$installer" --home "$AMAN_HOME" --yes backup || exit 1
      ;;
  esac
  exit 0
}

# aman backup [NAME] and aman upgrade [...]: the installer the sandbox tools were set up from, run for the person.
run_installer() { # command args...
  local installer
  if ! installer=$(checkout_installer); then
    printf 'Aman cannot find the folder it was installed from. Run install.sh again from that folder.\n' >&2
    exit 1
  fi
  exec bash "$installer" --home "$AMAN_HOME" "$@"
}

# ---------------------------------------------------------------- main

case "${1:-}" in
  doctor) shift ;;
  backup | upgrade) run_installer "$@" ;;
  -h | --help)
    usage
    exit 0
    ;;
  *) die_usage "Unknown command: ${1:-(none)}" ;;
esac

case "${1:-}" in
  sandbox)
    shift
    doctor_sandbox "$@"
    ;;
  instance | network)
    kind=$1
    shift
    doctor_repair "$kind" "$@"
    ;;
  docker | disk | backup)
    kind=$1
    shift
    doctor_machine_repair "$kind" "$@"
    ;;
esac

while [ $# -gt 0 ]; do
  case "$1" in
    --json) AS_JSON=1 ;;
    --verbose) UI_VERBOSE=1 ;;
    --summary) SUMMARY=1 ;;
    --deep)
      DEEP=1
      PROBE_SECONDS=30
      ;;
    --local) LOCAL=1 ;;
    --only)
      [ $# -ge 2 ] || die_usage "--only needs a check id."
      ONLY=$2
      shift
      ;;
    --instance)
      [ $# -ge 2 ] || die_usage "--instance needs a name."
      ONLY_INSTANCE=$2
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *) die_usage "Unknown argument: $1" ;;
  esac
  shift
done

if [ -n "$ONLY" ] && ! in_list "$ONLY" "$MACHINE_IDS $INSTANCE_IDS"; then
  die_usage "Unknown check \"${ONLY}\". Checks: ${MACHINE_IDS} ${INSTANCE_IDS}"
fi

select_instances

check_docker
check_runtime
check_credentials
check_images
check_disk
check_docker_memory
check_clock
check_backup
for instance_name in "${INSTANCES[@]+"${INSTANCES[@]}"}"; do
  check_instance "$instance_name"
done

if [ "$AS_JSON" = 1 ]; then print_json; else print_text; fi

failures=0
while IFS=$'\t' read -r _scope id state _rest; do
  if [ "$state" = fail ] && { [ -z "$ONLY" ] || [ "$id" = "$ONLY" ]; }; then failures=1; fi
done <<<"$RECORDS"
if [ "$failures" = 1 ]; then exit 1; fi
exit 0
