#!/usr/bin/env bash
# Host shim installed as ~/.amanuensis/bin/aman. `aman doctor` runs machine checks with
# the Docker CLI plus each instance's in-image `aman doctor`, combined into one document.
# Read-only; needs only Docker (no jq, no Node). The state directory is AMANUENSIS_HOME.
#
#   aman doctor [--json] [--only ID] [--instance NAME] [--deep] [--local]
#   aman doctor sandbox [--fix [--yes]] [--instance NAME] [--disk-gb N] [--no-hard-disk-limit]
#
# `doctor sandbox` checks every sandbox slot's attestation and then makes a real call through the app. The slot
# setup is the copy of packages/trueforge/scripts/sandbox-slots the installer took out of the app image; it runs on
# the Node.js the installer downloaded into <home>/runtime/node, or on the host's Node.js 22.14 or newer. With --fix it rebuilds the image, reloads the AppArmor profile,
# recreates missing slot disks and recreates the slots; it asks before any sudo.
#
# `public_url` and `public_login` run from this machine against an instance's public https addresses (its health
# endpoint and the login discovery document), only for an instance installed with https addresses.
#
# --local keeps to what needs nothing outside this machine: it skips the model check and the public https checks, which
# call out to the network. The installer uses it for status lists and the pre-upgrade gate.
#
# Exit codes: 0 no failures, 1 at least one failure, 2 usage error.
# Test hooks: AMAN_DOCTOR_NOW (epoch seconds) replaces the clock.

set -u

AMAN_HOME="${AMANUENSIS_HOME:-${HOME:-}/.amanuensis}"
APP_SERVICE="${AMAN_DOCTOR_APP_SERVICE:-app}"
AS_JSON=0
DEEP=0
LOCAL=0
ONLY=""
ONLY_INSTANCE=""

MACHINE_IDS="docker runtime credentials images disk docker_memory clock backup"
INSTANCE_IDS="config containers ports service login database disk clock run_code attachments demo model public_url public_login"
IN_IMAGE_IDS="service login database disk clock run_code attachments demo model"

BACKUP_WARN_DAYS=7
GIB=$((1024 * 1024 * 1024))
CLOCK_WARN_SECONDS=60
CLOCK_FAIL_SECONDS=300
# The app image build peaks near 5 GB across its parallel stages.
DOCKER_MEM_FAIL_BYTES=$((6 * GIB))
DOCKER_MEM_WARN_BYTES=$((8 * GIB))
DOCKER_MIN_COMPOSE_MAJOR=2

RECORDS=""
CLEANED=""
JSON_ESCAPED=""
DOCKER_OK=0
DOCKER_ARCH=""
DOCKER_ROOT=""
DOCKER_SYSTEM_TIME=""
DOCKER_SECURITY=""
DOCKER_OS=""
DOCKER_MEM=""
APP_CONTAINER=""

usage() {
  cat >&2 <<'USAGE'
Usage: aman doctor [--json] [--only ID] [--instance NAME] [--deep] [--local]
       aman doctor sandbox [--fix [--yes]] [--instance NAME] [--disk-gb N] [--no-hard-disk-limit]
USAGE
}

die_usage() {
  printf '%s\n' "$1" >&2
  usage
  exit 2
}

# ---------------------------------------------------------------- helpers

now_epoch() {
  if [ -n "${AMAN_DOCTOR_NOW:-}" ]; then
    printf '%s' "$AMAN_DOCTOR_NOW"
  else
    date +%s
  fi
}

# Keeps a command from hanging the report; macOS has no `timeout` unless coreutils is installed.
bounded() {
  local seconds=$1
  shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$seconds" "$@"
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$seconds" "$@"
  else
    "$@"
  fi
}

PROBE_SECONDS=5

# One printable line, at most 400 characters; JSON output needs nothing stronger after this.
# Builtins only: this runs for every field and process spawns are the slow part.
clean() {
  local value=${1//[^[:print:]]/ }
  CLEANED=${value:0:400}
}

record() { # scope id state detail fix
  local detail fix
  clean "$4"
  detail=$CLEANED
  clean "$5"
  fix=$CLEANED
  RECORDS="${RECORDS}${1}"$'\t'"${2}"$'\t'"${3}"$'\t'"${detail}"$'\t'"${fix}"$'\n'
}

json_escape() {
  local value=${1//\\/\\\\}
  JSON_ESCAPED=${value//\"/\\\"}
}

lowercase() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

# Days-from-civil arithmetic, so no GNU or BSD date flags are needed.
rfc3339_to_epoch() {
  local value=$1 date_part rest time_part tz sign offset_h offset_m offset=0
  local y m d hh mm ss era yoe mp doy doe days
  date_part=${value%%T*}
  rest=${value#*T}
  case "$rest" in
    *Z)
      time_part=${rest%Z}
      ;;
    *+*)
      time_part=${rest%+*}
      tz=${rest##*+}
      sign=1
      ;;
    *-*)
      time_part=${rest%-*}
      tz=${rest##*-}
      sign=-1
      ;;
    *) return 1 ;;
  esac
  time_part=${time_part%%.*}
  IFS=- read -r y m d <<<"$date_part"
  IFS=: read -r hh mm ss <<<"$time_part"
  case "$y$m$d$hh$mm$ss" in
    '' | *[!0-9]*) return 1 ;;
  esac
  if [ -n "${tz:-}" ]; then
    IFS=: read -r offset_h offset_m <<<"$tz"
    case "${offset_h}${offset_m}" in
      '' | *[!0-9]*) return 1 ;;
    esac
    offset=$((sign * (10#$offset_h * 3600 + 10#$offset_m * 60)))
  fi
  y=$((10#$y))
  m=$((10#$m))
  d=$((10#$d))
  if [ "$m" -le 2 ]; then y=$((y - 1)); fi
  era=$((y / 400))
  yoe=$((y - era * 400))
  mp=$(((m + 9) % 12))
  doy=$(((153 * mp + 2) / 5 + d - 1))
  doe=$((yoe * 365 + yoe / 4 - yoe / 100 + doy))
  days=$((era * 146097 + doe - 719468))
  printf '%s' $((days * 86400 + 10#$hh * 3600 + 10#$mm * 60 + 10#$ss - offset))
}

file_mtime() {
  stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null
}

file_mode() {
  stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1" 2>/dev/null
}

normalize_arch() {
  case "$1" in
    x86_64 | amd64) printf amd64 ;;
    aarch64 | arm64) printf arm64 ;;
    *) printf '%s' "$1" ;;
  esac
}

json_value() { # file key
  sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" "$1" | head -n 1
}

# ---------------------------------------------------------------- machine checks

check_docker() {
  local out rc version arch security root systime os mem compose compose_major
  if ! command -v docker >/dev/null 2>&1; then
    record machine docker fail "Docker is not installed, or its command is not on PATH." \
      "Install Docker: on Linux follow https://docs.docker.com/engine/install/ (or let install.sh do it); on macOS or Windows install Docker Desktop. Then run install.sh again."
    return
  fi
  out=$(bounded "$PROBE_SECONDS" docker info --format '{{.ServerVersion}}|{{.Architecture}}|{{.SecurityOptions}}|{{.DockerRootDir}}|{{.SystemTime}}|{{.OperatingSystem}}|{{.MemTotal}}' 2>&1)
  rc=$?
  if [ "$rc" -ne 0 ]; then
    case "$out" in
      *"permission denied"*)
        record machine docker fail "Docker is running, but this user is not allowed to use its socket." \
          "Add yourself to the docker group with: sudo usermod -aG docker \"\$USER\" ; then sign out and back in (the docker group gives full control of this machine). install.sh finishes its own run without that."
        ;;
      *"Cannot connect"* | *"daemon running"* | *"error during connect"* | *"connection refused"*)
        record machine docker fail "Docker is installed, but its engine is not running." \
          "Start it: on Linux run \"sudo systemctl start docker\"; on macOS or Windows open Docker Desktop and wait until it says it is running."
        ;;
      *)
        record machine docker fail "Docker did not answer: ${out%%$'\n'*}" \
          "Check that Docker is running with \"docker info\", fix what it reports, then run doctor again."
        ;;
    esac
    return
  fi
  IFS='|' read -r version arch security root systime os mem <<<"$out"
  DOCKER_ARCH=$(normalize_arch "$arch")
  DOCKER_ROOT=$root
  DOCKER_SYSTEM_TIME=$systime
  DOCKER_SECURITY=$security
  DOCKER_OS=$os
  DOCKER_MEM=$mem
  compose=$(bounded "$PROBE_SECONDS" docker compose version --short 2>&1)
  rc=$?
  compose=${compose#v}
  if [ "$rc" -eq 0 ] && [[ $compose =~ ^([0-9]+)\.[0-9]+ ]]; then
    compose_major=$((10#${BASH_REMATCH[1]}))
  else
    compose_major=0
  fi
  if [ "$compose_major" -lt "$DOCKER_MIN_COMPOSE_MAJOR" ]; then
    record machine docker fail "Docker ${version} is running, but Docker Compose v${DOCKER_MIN_COMPOSE_MAJOR} or newer is missing (found: ${compose:-none})." \
      "Install the Compose plugin (Linux: sudo apt-get install docker-compose-plugin; Docker Desktop already includes it), then run doctor again."
    return
  fi
  DOCKER_OK=1
  record machine docker ok "Docker ${version} is running and Compose ${compose} is available." ""
}

check_runtime() {
  local components cli_version text
  if [ "$DOCKER_OK" != 1 ]; then
    record machine runtime off "Skipped: Docker is not reachable." ""
    return
  fi
  components=$(bounded "$PROBE_SECONDS" docker version --format '{{range .Server.Components}}{{.Name}};{{end}}' 2>/dev/null)
  cli_version=$(bounded "$PROBE_SECONDS" docker --version 2>/dev/null)
  text=$(lowercase "$components $cli_version $DOCKER_OS")
  case "$text" in
    *podman*)
      record machine runtime fail "Podman is not supported." \
        "Install Docker Engine (https://docs.docker.com/engine/install/) or Docker Desktop, point the docker command at it, then run install.sh again."
      return
      ;;
  esac
  case "$DOCKER_SECURITY" in
    *rootless*)
      record machine runtime fail "Rootless Docker is not supported." \
        "Install the regular Docker Engine (https://docs.docker.com/engine/install/) or Docker Desktop, switch the docker context to it, then run install.sh again."
      return
      ;;
  esac
  record machine runtime ok "A supported Docker runtime is in use." ""
}

check_credentials() {
  local config store helper
  config="${DOCKER_CONFIG:-${HOME:-}/.docker}/config.json"
  if [ ! -r "$config" ]; then
    record machine credentials ok "No Docker settings file, so no credential store is in use." ""
    return
  fi
  store=$(json_value "$config" credsStore)
  if [ -z "$store" ]; then
    record machine credentials ok "Docker uses no credential store." ""
    return
  fi
  helper="docker-credential-${store}"
  if ! command -v "$helper" >/dev/null 2>&1; then
    record machine credentials fail "Docker is set to use the credential store \"${store}\", but ${helper} is not on PATH; image downloads will fail with \"error getting credentials\"." \
      "Start Docker Desktop and make sure its tools folder is on PATH (macOS: /Applications/Docker.app/Contents/Resources/bin), or remove the \"credsStore\" line from ${config} and run doctor again."
    return
  fi
  if ! bounded "$PROBE_SECONDS" "$helper" list >/dev/null 2>&1; then
    record machine credentials fail "The credential store \"${store}\" is installed but did not answer; image downloads will fail." \
      "Open Docker Desktop and unlock your keychain, or remove the \"credsStore\" line from ${config}, then run doctor again."
    return
  fi
  record machine credentials ok "The Docker credential store \"${store}\" answers." ""
}

check_images() {
  local release key ref out rc missing="" wrong_arch="" checked=0 image_arch
  if [ "$DOCKER_OK" != 1 ]; then
    record machine images off "Skipped: Docker is not reachable." ""
    return
  fi
  release="${AMAN_HOME}/release/release.json"
  if [ ! -r "$release" ]; then
    record machine images warn "No release record was found, so the expected images are unknown." \
      "Run install.sh to finish the setup; it writes the release record."
    return
  fi
  for key in app_image dex_image stt_image; do
    ref=$(json_value "$release" "$key")
    [ -n "$ref" ] || continue
    checked=$((checked + 1))
    out=$(bounded "$PROBE_SECONDS" docker image inspect --format '{{.Architecture}}' "$ref" 2>&1)
    rc=$?
    if [ "$rc" -ne 0 ]; then
      missing="${missing} ${key}"
      continue
    fi
    image_arch=$(normalize_arch "$out")
    if [ -n "$DOCKER_ARCH" ] && [ "$image_arch" != "$DOCKER_ARCH" ]; then
      wrong_arch="${wrong_arch} ${key}(${image_arch})"
    fi
  done
  if [ "$checked" -eq 0 ]; then
    record machine images warn "The release record lists no images." "Run install.sh again to rewrite the release record."
  elif [ -n "$missing" ]; then
    record machine images fail "Images missing on this machine:${missing}." \
      "Run install.sh again; it builds the app and speech images from this checkout and pulls Dex by its pinned digest."
  elif [ -n "$wrong_arch" ]; then
    record machine images fail "Images built for another CPU type than Docker uses (${DOCKER_ARCH}):${wrong_arch}." \
      "Run install.sh again to rebuild them for this machine."
  else
    record machine images ok "All ${checked} images are present for ${DOCKER_ARCH:-this CPU}." ""
  fi
}

format_gb() { # kilobytes
  awk -v kb="$1" 'BEGIN { printf "%.1f GB", kb / 1048576 }'
}

check_disk() {
  local kb bytes
  if [ "$DOCKER_OK" != 1 ]; then
    record machine disk off "Skipped: Docker is not reachable." ""
    return
  fi
  if [ -z "$DOCKER_ROOT" ] || [ ! -d "$DOCKER_ROOT" ]; then
    record machine disk off "Docker keeps its data inside a virtual machine here; free space is checked per instance." ""
    return
  fi
  kb=$(df -Pk "$DOCKER_ROOT" 2>/dev/null | awk 'NR == 2 { print $4 }')
  case "$kb" in
    '' | *[!0-9]*)
      record machine disk warn "The free space for Docker data could not be read." "Run \"df -h\" and check the disk that holds ${DOCKER_ROOT}."
      return
      ;;
  esac
  bytes=$((kb * 1024))
  if [ "$bytes" -lt $((2 * GIB)) ]; then
    record machine disk fail "Only $(format_gb "$kb") is free for Docker data; installs and upgrades will fail." \
      "Free space with \"docker system prune\" (removes stopped containers and unused images) or by removing old backups, then run doctor again."
  elif [ "$bytes" -lt $((10 * GIB)) ]; then
    record machine disk warn "$(format_gb "$kb") is free for Docker data; 10 GB is recommended." \
      "Free space with \"docker system prune\" (removes stopped containers and unused images) or by removing old backups."
  else
    record machine disk ok "$(format_gb "$kb") is free for Docker data." ""
  fi
}

check_docker_memory() {
  local mem_fix="Raise it in Docker Desktop under Settings, Resources, Memory. On Linux, free up memory or add swap."
  if [ "$DOCKER_OK" != 1 ]; then
    record machine docker_memory off "Skipped: Docker is not reachable." ""
    return
  fi
  case "$DOCKER_MEM" in
    '' | *[!0-9]*)
      record machine docker_memory off "Skipped: Docker did not report how much memory it has." ""
      return
      ;;
  esac
  local gb
  gb=$(awk -v b="$DOCKER_MEM" 'BEGIN { printf "%.1f GB", b / 1073741824 }')
  if [ "$DOCKER_MEM" -lt "$DOCKER_MEM_FAIL_BYTES" ]; then
    record machine docker_memory fail "Docker has only ${gb} of memory; building the app needs at least 6 GB." "$mem_fix"
  elif [ "$DOCKER_MEM" -lt "$DOCKER_MEM_WARN_BYTES" ]; then
    record machine docker_memory warn "Docker has ${gb} of memory; 8 GB is recommended for builds and upgrades." "$mem_fix"
  else
    record machine docker_memory ok "Docker has ${gb} of memory." ""
  fi
}

check_clock() {
  local daemon now skew
  if [ "$DOCKER_OK" != 1 ]; then
    record machine clock off "Skipped: Docker is not reachable." ""
    return
  fi
  if ! daemon=$(rfc3339_to_epoch "$DOCKER_SYSTEM_TIME"); then
    record machine clock off "Skipped: Docker did not report a readable time." ""
    return
  fi
  now=$(now_epoch)
  skew=$((now - daemon))
  if [ "$skew" -lt 0 ]; then skew=$((-skew)); fi
  local fix="Turn on automatic time sync (Linux: sudo timedatectl set-ntp true; Docker Desktop: restart it, since its clock drifts after the computer sleeps)."
  if [ "$skew" -gt "$CLOCK_FAIL_SECONDS" ]; then
    record machine clock fail "This machine and Docker disagree on the time by ${skew} seconds; sign-in will fail." "$fix"
  elif [ "$skew" -gt "$CLOCK_WARN_SECONDS" ]; then
    record machine clock warn "This machine and Docker disagree on the time by ${skew} seconds." "$fix"
  else
    record machine clock ok "This machine and Docker agree on the time." ""
  fi
}

check_backup() {
  local dir newest="" newest_time=0 entry mtime age_days now
  dir="${AMAN_HOME}/backups"
  for entry in "$dir"/*/; do
    [ -d "$entry" ] || continue
    mtime=$(file_mtime "$entry")
    case "$mtime" in '' | *[!0-9]*) continue ;; esac
    if [ "$mtime" -gt "$newest_time" ]; then
      newest_time=$mtime
      newest=$entry
    fi
  done
  if [ -z "$newest" ]; then
    record machine backup ok "No backup yet; one is made automatically before your first upgrade." ""
    return
  fi
  now=$(now_epoch)
  age_days=$(((now - newest_time) / 86400))
  if [ "$age_days" -gt "$BACKUP_WARN_DAYS" ]; then
    record machine backup warn "The last backup is ${age_days} days old." "Run \"install.sh backup\" to make a new one."
  else
    record machine backup ok "The last backup is ${age_days} days old." ""
  fi
}

# ---------------------------------------------------------------- instance checks

check_instance_config() {
  local name=$1 file mode dir
  dir="${AMAN_HOME}/instances/${name}"
  if [ ! -f "${dir}/.env" ]; then
    record "$name" config fail "The instance settings file is missing." \
      "Run install.sh to recreate it, or restore it from a backup."
    return
  fi
  # dex.env holds the login password hash; both files hold secrets.
  for file in "${dir}/.env" "${dir}/dex.env"; do
    [ -f "$file" ] || continue
    mode=$(file_mode "$file")
    if [ "$mode" != 600 ]; then
      record "$name" config fail "${file##*/} holds secrets but is readable by other users (mode ${mode:-unknown})." \
        "Run: chmod 600 ${file}"
      return
    fi
  done
  summarize_users "$dir"
  if [ "$USERS_SHORT" = 1 ]; then
    record "$name" config warn "The settings files are private to you.${USERS_SUMMARY} Fewer emails are allowed to sign in than there are users." \
      "Run install.sh instance list-users, then instance add-user again for each member; it repairs the allowed emails."
    return
  fi
  record "$name" config ok "The settings files exist and are private to you.${USERS_SUMMARY}" ""
}

# Sets USERS_SUMMARY (" N sign-in user(s): the owner and M member(s).") from the hash variables in dex.env, and
# USERS_SHORT=1 when fewer emails are allowed than there are users. Hashes are counted, never printed.
summarize_users() { # instance dir
  local users members allowed
  USERS_SUMMARY=""
  USERS_SHORT=0
  [ -f "${1}/dex.env" ] || return 0
  users=$(awk '/^DEX_USER_PASSWORD_HASH(_[A-Z0-9_]+)?=/ { n++ } END { print n + 0 }' "${1}/dex.env" 2>/dev/null)
  users=${users:-0}
  members=0
  if [ "$users" -gt 0 ]; then members=$((users - 1)); fi
  USERS_SUMMARY=" ${users} sign-in user(s): the owner and ${members} member(s)."
  allowed=$(sed -n 's/^OIDC_ALLOWED_EMAILS=//p' "${1}/.env" 2>/dev/null | awk 'END { print }')
  case "$allowed" in
    '' | *'*'*) return 0 ;;
  esac
  if [ "$(printf '%s' "$allowed" | tr ',' '\n' | awk 'NF { n++ } END { print n + 0 }')" -lt "$users" ]; then USERS_SHORT=1; fi
}

check_instance_containers() { # name; sets APP_CONTAINER
  local name=$1 line id cname state status service bad="" unhealthy="" starting="" found=0 ports exposed="" count=0
  APP_CONTAINER=""
  local up_command="docker compose --project-directory ${AMAN_HOME}/instances/${name} up -d"
  local lines
  lines=$(bounded "$PROBE_SECONDS" docker ps -a --filter "label=com.docker.compose.project=aman-${name}" \
    --format '{{.ID}}|{{.Names}}|{{.State}}|{{.Status}}|{{.Label "com.docker.compose.service"}}' 2>/dev/null)
  while IFS='|' read -r id cname state status service; do
    [ -n "$id" ] || continue
    found=1
    count=$((count + 1))
    case "$state" in
      running)
        if [ "$service" = "$APP_SERVICE" ]; then APP_CONTAINER=$id; fi
        case "$status" in
          *"(unhealthy)"*) unhealthy="${unhealthy} ${cname}" ;;
          *"(health: starting)"*) starting="${starting} ${cname}" ;;
        esac
        ports=$(bounded "$PROBE_SECONDS" docker port "$id" 2>/dev/null)
        case "$ports" in
          *"0.0.0.0:"* | *"[::]:"* | *":::"*) exposed="${exposed} ${cname}" ;;
        esac
        ;;
      exited)
        case "$status" in
          "Exited (0)"*) ;;
          *) bad="${bad} ${cname}" ;;
        esac
        ;;
      *) bad="${bad} ${cname}" ;;
    esac
  done <<<"$lines"
  if [ "$found" = 0 ]; then
    record "$name" containers fail "This instance has no containers; it is stopped or was removed." "Start it with: ${up_command}"
    record "$name" ports off "Skipped: the instance has no containers." ""
    return
  fi
  if [ -n "$bad" ]; then
    record "$name" containers fail "Not running:${bad}." "Start them with: ${up_command}  (read the log with \"docker logs\" if one keeps stopping)"
  elif [ -n "$unhealthy" ]; then
    record "$name" containers fail "Reported unhealthy by Docker:${unhealthy}." "Read the log with \"docker logs\" for that container, then restart it with: docker compose --project-directory ${AMAN_HOME}/instances/${name} restart"
  elif [ -n "$starting" ]; then
    record "$name" containers warn "Still starting:${starting}." "Wait a minute and run doctor again."
  else
    record "$name" containers ok "All ${count} containers are running." ""
  fi
  if [ -n "$exposed" ]; then
    record "$name" ports fail "Ports are open to the whole network, not just this machine:${exposed}." \
      "Change the published ports in ${AMAN_HOME}/instances/${name}/compose.yaml to start with 127.0.0.1:, then run: ${up_command}"
  else
    record "$name" ports ok "Published ports listen on this machine only." ""
  fi
}

in_list() { # word list
  case " $2 " in *" $1 "*) return 0 ;; esac
  return 1
}

run_in_image_checks() { # name
  # The model check waits on a hosted model, so the whole run gets more room than the local checks need.
  local name=$1 out rc line id state detail fix exec_timeout=45 args=(doctor --text)
  if [ "$DEEP" = 1 ]; then
    exec_timeout=90
    args+=(--deep)
  fi
  if [ "$LOCAL" = 1 ]; then
    args+=(--local)
  fi
  if [ -n "$ONLY" ] && in_list "$ONLY" "$IN_IMAGE_IDS"; then
    args+=(--only "$ONLY")
  fi
  # The host passes its own time: the app's clock is judged against the host, not against a service on it.
  out=$(bounded "$exec_timeout" docker exec -e "AMAN_HOST_EPOCH=$(now_epoch)" "$APP_CONTAINER" aman "${args[@]}" 2>&1)
  rc=$?
  if [ "$rc" -ne 0 ] && [ "$rc" -ne 1 ]; then
    record "$name" service fail "The checks could not run inside the app container: ${out%%$'\n'*}" \
      "Rebuild the app image with install.sh (it must include the aman command), then restart the instance."
    return
  fi
  while IFS=$'\t' read -r id state detail fix; do
    case "$state" in
      ok | warn | fail | off) record "$name" "$id" "$state" "$detail" "$fix" ;;
    esac
  done <<<"$out"
}

PROBE_RC=0
PROBE_CODE=""
PROBE_BODY=""
PROBE_ERR=""

# One https request from this machine; a second form pins the name to this machine to tell a broken public path
# (DNS, firewall, a cloud that does not loop back) from a broken proxy.
http_probe() { # url [host:port:address]
  local url=$1 pin=${2:-} out args=(-sS --max-time 10 -w $'\n%{http_code}')
  if [ -n "$pin" ]; then args+=(--resolve "$pin"); fi
  out=$(bounded 15 curl "${args[@]}" "$url" 2>&1)
  PROBE_RC=$?
  PROBE_CODE=""
  PROBE_BODY=""
  PROBE_ERR=""
  if [ "$PROBE_RC" -ne 0 ]; then
    clean "${out##*$'\n'}"
    PROBE_ERR=$CLEANED
    return
  fi
  PROBE_CODE=${out##*$'\n'}
  PROBE_BODY=${out%$'\n'*}
}

public_check() { # name id url what [expected issuer]
  local name=$1 id=$2 url=$3 what=$4 want=${5:-} rest host port=443 first_error="" pinned=0 got
  local fix_path="Check that the DNS records point at this machine, that Caddy is running (sudo systemctl status caddy; sudo journalctl -u caddy -n 50) and that port 443 is open in the cloud firewall."
  rest=${url#https://}
  host=${rest%%/*}
  case "$host" in *:*)
    port=${host##*:}
    host=${host%%:*}
    ;;
  esac
  http_probe "$url"
  if [ "$PROBE_RC" -ne 0 ]; then
    first_error=$PROBE_ERR
    http_probe "$url" "${host}:${port}:127.0.0.1"
    if [ "$PROBE_RC" -ne 0 ]; then
      record "$name" "$id" fail "${what} did not answer over https (${first_error:-no answer})." "$fix_path"
      return
    fi
    pinned=1
  fi
  if [ "$PROBE_CODE" != 200 ]; then
    record "$name" "$id" fail "${what} answered status ${PROBE_CODE}, not 200." \
      "Status 502 or 503 means Caddy runs but the instance does not answer: run \"aman doctor --instance ${name}\" and fix what it reports. Otherwise check the Caddy log: sudo journalctl -u caddy -n 50."
    return
  fi
  if [ -n "$want" ]; then
    got=$(printf '%s' "$PROBE_BODY" | tr -d '\n' | sed -n 's/.*"issuer"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    if [ "$got" != "$want" ]; then
      record "$name" "$id" fail "${what} answered, but its issuer is \"${got:-missing}\", not the configured \"${want}\"." \
        "Check that the login address in the instance .env (OIDC_ISSUER_URL) is the one Caddy serves for the sign-in service, then restart the instance."
      return
    fi
  fi
  if [ "$pinned" = 1 ]; then
    record "$name" "$id" warn "${what} answers on this machine with a valid certificate, but not through its public address from here (${first_error:-no answer})." \
      "Some clouds do not loop a machine back to its own public address. Check from another network: curl -sSI ${url}"
    return
  fi
  record "$name" "$id" ok "${what} answers over https." ""
}

# The addresses people use, checked the way a browser reaches them. Skipped for an instance with local addresses only.
check_instance_public() { # name
  local name=$1 file public issuer
  file="${AMAN_HOME}/instances/${name}/.env"
  [ -r "$file" ] || return 0
  public=$(sed -n 's/^PUBLIC_BASE_URL=//p' "$file" | head -n 1)
  issuer=$(sed -n 's/^OIDC_ISSUER_URL=//p' "$file" | head -n 1)
  case "$public" in https://*) ;; *) return 0 ;; esac
  if ! command -v curl >/dev/null 2>&1; then
    record "$name" public_url off "Skipped: curl is not installed, so the public https address cannot be tried." ""
    return 0
  fi
  public_check "$name" public_url "${public}/healthz" "The app at ${public}"
  case "$issuer" in
    https://*) public_check "$name" public_login "${issuer}/.well-known/openid-configuration" "The login provider at ${issuer}" "$issuer" ;;
  esac
}

check_instance() {
  check_instance_core "$1"
  if [ "$LOCAL" != 1 ]; then check_instance_public "$1"; fi
}

check_instance_core() {
  local name=$1
  check_instance_config "$name"
  if [ "$DOCKER_OK" != 1 ]; then
    record "$name" service fail "Docker is not reachable, so this instance cannot be checked." \
      "Fix the Docker problem reported under the machine checks first."
    return
  fi
  check_instance_containers "$name"
  if [ -z "$APP_CONTAINER" ]; then
    record "$name" service fail "The app container is not running." \
      "Start the instance with: docker compose --project-directory ${AMAN_HOME}/instances/${name} up -d"
    return
  fi
  run_in_image_checks "$name"
}

list_instances() {
  local entry
  for entry in "${AMAN_HOME}/instances"/*/; do
    [ -d "$entry" ] || continue
    entry=${entry%/}
    printf '%s\n' "${entry##*/}"
  done
}

# ---------------------------------------------------------------- output

visible_records() { # scope
  local scope=$1 line
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$line" in
      "${scope}"$'\t'*) ;;
      *) continue ;;
    esac
    if [ -n "$ONLY" ]; then
      local rest=${line#*$'\t'}
      [ "${rest%%$'\t'*}" = "$ONLY" ] || continue
    fi
    printf '%s\n' "$line"
  done <<<"$RECORDS"
}

json_checks() { # scope
  local first=1 line scope id state detail fix
  printf '['
  while IFS=$'\t' read -r scope id state detail fix; do
    [ -n "$scope" ] || continue
    if [ "$first" = 1 ]; then first=0; else printf ','; fi
    json_escape "$id"
    id=$JSON_ESCAPED
    json_escape "$detail"
    detail=$JSON_ESCAPED
    json_escape "$fix"
    fix=$JSON_ESCAPED
    printf '{"id":"%s","state":"%s","detail":"%s","fix":"%s"}' "$id" "$state" "$detail" "$fix"
  done < <(visible_records "$1")
  printf ']'
}

text_checks() { # scope
  local scope id state detail fix label
  while IFS=$'\t' read -r scope id state detail fix; do
    [ -n "$scope" ] || continue
    case "$state" in
      ok) label="ok  " ;;
      warn) label="WARN" ;;
      fail) label="FAIL" ;;
      *) label="off " ;;
    esac
    printf '  [%s] %-12s %s\n' "$label" "$id" "$detail"
    if [ -n "$fix" ]; then printf '         Fix: %s\n' "$fix"; fi
  done < <(visible_records "$1")
}

print_json() {
  local name first=1
  printf '{"machine":'
  json_checks machine
  printf ',"instances":{'
  for name in "${INSTANCES[@]+"${INSTANCES[@]}"}"; do
    if [ "$first" = 1 ]; then first=0; else printf ','; fi
    json_escape "$name"
    printf '"%s":' "$JSON_ESCAPED"
    json_checks "$name"
  done
  printf '}}\n'
}

print_text() {
  local name
  printf 'Machine\n'
  text_checks machine
  for name in "${INSTANCES[@]+"${INSTANCES[@]}"}"; do
    printf '\nInstance %s\n' "$name"
    text_checks "$name"
  done
}

select_instances() {
  INSTANCES=()
  if [ -n "$ONLY_INSTANCE" ]; then
    case "$ONLY_INSTANCE" in
      '' | *[!a-z0-9-]* | -*) die_usage "Instance names use lowercase letters, digits and hyphens." ;;
    esac
    [ -d "${AMAN_HOME}/instances/${ONLY_INSTANCE}" ] || die_usage "No instance named \"${ONLY_INSTANCE}\" under ${AMAN_HOME}/instances."
    INSTANCES=("$ONLY_INSTANCE")
  else
    while IFS= read -r instance_name; do
      [ -n "$instance_name" ] && INSTANCES+=("$instance_name")
    done < <(list_instances)
  fi
}

# ---------------------------------------------------------------- sandbox

SANDBOX_NODE_MAJOR=22
SANDBOX_NODE_MINOR=14

sandbox_node_ok() {
  local v major minor
  command -v node >/dev/null 2>&1 || return 1
  v=$(node --version 2>/dev/null) || return 1
  v=${v#v}
  major=${v%%.*}
  minor=${v#*.}
  minor=${minor%%.*}
  case "$major$minor" in '' | *[!0-9]*) return 1 ;; esac
  [ "$major" -gt "$SANDBOX_NODE_MAJOR" ] || { [ "$major" -eq "$SANDBOX_NODE_MAJOR" ] && [ "$minor" -ge "$SANDBOX_NODE_MINOR" ]; }
}

record_state() { # scope id
  local scope id state _rest
  while IFS=$'\t' read -r scope id state _rest; do
    if [ "$scope" = "$1" ] && [ "$id" = "$2" ]; then
      printf '%s' "$state"
      return 0
    fi
  done <<<"$RECORDS"
}

# The pinned runtime the installer downloaded, else the host's Node.js when it is new enough; empty when neither is.
sandbox_node_path() {
  if [ -x "${AMAN_HOME}/runtime/node/bin/node" ]; then
    printf '%s' "${AMAN_HOME}/runtime/node/bin/node"
  elif sandbox_node_ok; then
    command -v node
  fi
}

# The slots come back after a restart only if Docker itself starts at boot.
docker_boot_state() { # prints enabled, or the reason it is not
  command -v systemctl >/dev/null 2>&1 || return 0
  systemctl cat docker.service >/dev/null 2>&1 || return 0
  systemctl is-enabled --quiet docker 2>/dev/null || printf 'disabled'
}

sandbox_instances() { # prints the instances whose app is wired to the slots
  local name compose
  for name in "${INSTANCES[@]+"${INSTANCES[@]}"}"; do
    compose=$(cat "${AMAN_HOME}/instances/${name}/compose.yaml" 2>/dev/null)
    case "$compose" in
      *"SANDBOX_BACKEND: slots"*) printf '%s\n' "$name" ;;
    esac
  done
}

doctor_sandbox() {
  local fix=0 yes=0 passthru=() bundle source repo name args state failed=0 targets=() node_bin answer
  while [ $# -gt 0 ]; do
    case "$1" in
      --fix) fix=1 ;;
      --yes) yes=1 ;;
      --no-hard-disk-limit) passthru+=(--no-hard-disk-limit) ;;
      --disk-gb)
        [ $# -ge 2 ] || die_usage "--disk-gb needs a number."
        passthru+=(--disk-gb "$2")
        shift
        ;;
      --instance)
        [ $# -ge 2 ] || die_usage "--instance needs a name."
        ONLY_INSTANCE=$2
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      *) die_usage "Unknown argument: $1" ;;
    esac
    shift
  done
  if [ "$yes" = 1 ] && [ "$fix" != 1 ]; then die_usage "--yes goes with --fix."; fi
  select_instances
  bundle="${AMAN_HOME}/bin/aman-sandbox.mjs"
  source="${AMAN_HOME}/state/source"
  if [ ! -f "$bundle" ] || [ ! -r "$source" ]; then
    printf 'The sandbox tools are not installed under %s. Run install.sh from the checkout; it installs them.\n' "$AMAN_HOME" >&2
    exit 1
  fi
  repo=$(head -n 1 "$source")
  if [ ! -f "${repo}/docker-compose.slots.yml" ]; then
    printf 'The checkout the sandbox was installed from is not at %s any more. Run install.sh from the checkout; it records the new place.\n' "$repo" >&2
    exit 1
  fi
  node_bin=$(sandbox_node_path)
  if [ -z "$node_bin" ]; then
    printf 'No Node.js runtime for the sandbox setup was found (%s/runtime/node, or Node.js %s.%s or newer on this computer). Run install.sh from the checkout; it downloads one.\n' "$AMAN_HOME" "$SANDBOX_NODE_MAJOR" "$SANDBOX_NODE_MINOR" >&2
    exit 1
  fi
  check_docker
  if [ "$DOCKER_OK" != 1 ]; then
    text_checks machine
    exit 1
  fi
  while IFS= read -r name; do
    [ -n "$name" ] && targets+=("$name")
  done < <(sandbox_instances)
  if [ "${#targets[@]}" -eq 0 ]; then
    printf 'No instance has the sandbox (it was installed with --no-sandbox, or no instance exists yet).\n'
    exit 0
  fi
  if [ "$(docker_boot_state)" = disabled ]; then
    printf 'Docker does not start at boot here, so the sandbox stays down after a restart.\n  Fix: sudo systemctl enable docker\n'
    if [ "$fix" = 1 ]; then
      answer=n
      if [ "$yes" = 1 ]; then answer=y; else read -r -p 'Run it now? [y/N] ' answer || true; fi
      case "$answer" in
        y | Y | yes) sudo systemctl enable docker || failed=1 ;;
      esac
    fi
  fi
  for name in "${targets[@]}"; do
    printf 'Instance %s\n' "$name"
    args=(--instance "$name" --repo-root "$repo" --log-file "${AMAN_HOME}/state/sandbox.log" --command-name "${AMAN_HOME}/bin/aman doctor sandbox" "${passthru[@]+"${passthru[@]}"}")
    if [ "$fix" = 1 ]; then
      args+=(--fix --restart)
      if [ "$yes" = 1 ]; then args+=(--yes); fi
    else
      args+=(--check)
    fi
    if ! "$node_bin" "$bundle" "${args[@]}"; then
      failed=1
      continue
    fi
    # The slots are healthy; now the app's own view of them, which is what Settings > Sandbox reports.
    RECORDS=""
    ONLY=run_code
    check_instance_containers "$name"
    if [ -z "$APP_CONTAINER" ]; then
      record "$name" run_code fail "The app container is not running, so run_code could not be tried through the app." \
        "Start the instance with: docker compose --project-directory ${AMAN_HOME}/instances/${name} up -d"
    else
      run_in_image_checks "$name"
    fi
    text_checks "$name"
    state=$(record_state "$name" run_code)
    if [ "$state" != ok ]; then failed=1; fi
  done
  exit "$failed"
}

# ---------------------------------------------------------------- main

case "${1:-}" in
  doctor) shift ;;
  -h | --help)
    usage
    exit 0
    ;;
  *) die_usage "Unknown command: ${1:-(none)}" ;;
esac

if [ "${1:-}" = sandbox ]; then
  shift
  doctor_sandbox "$@"
fi

while [ $# -gt 0 ]; do
  case "$1" in
    --json) AS_JSON=1 ;;
    --deep)
      DEEP=1
      PROBE_SECONDS=30
      ;;
    --local) LOCAL=1 ;;
    --only)
      [ $# -ge 2 ] || die_usage "--only needs a check id."
      ONLY=$2
      shift
      ;;
    --instance)
      [ $# -ge 2 ] || die_usage "--instance needs a name."
      ONLY_INSTANCE=$2
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *) die_usage "Unknown argument: $1" ;;
  esac
  shift
done

if [ -n "$ONLY" ] && ! in_list "$ONLY" "$MACHINE_IDS $INSTANCE_IDS"; then
  die_usage "Unknown check \"${ONLY}\". Checks: ${MACHINE_IDS} ${INSTANCE_IDS}"
fi

select_instances

check_docker
check_runtime
check_credentials
check_images
check_disk
check_docker_memory
check_clock
check_backup
for instance_name in "${INSTANCES[@]+"${INSTANCES[@]}"}"; do
  check_instance "$instance_name"
done

if [ "$AS_JSON" = 1 ]; then print_json; else print_text; fi

failures=0
while IFS=$'\t' read -r _scope id state _rest; do
  if [ "$state" = fail ] && { [ -z "$ONLY" ] || [ "$id" = "$ONLY" ]; }; then failures=1; fi
done <<<"$RECORDS"
if [ "$failures" = 1 ]; then exit 1; fi
exit 0
