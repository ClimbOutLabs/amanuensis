#!/usr/bin/env bash
# Test double for host Node.js running the sandbox slot setup copied out of the app image. It records the call
# and answers like the real setup: --check reports the state in $STUB_STATE/slots_state, a full run brings the slots up.
set -u
printf 'node %s\n' "$*" >>"$STUB_LOG"
# Prints its progress lines in the installer's own style, as the real setup does.
if [ -n "${STUB_UI_SH:-}" ]; then
  # shellcheck source=../../lib/ui.sh
  . "$STUB_UI_SH"
  ui_init
fi
say_ok() { if [ -n "${STUB_UI_SH:-}" ]; then ui_ok "$1"; else echo "+ $1"; fi; }
if [ "${1:-}" = --version ]; then
  echo "${STUB_NODE_VERSION:-v22.22.0}"
  exit 0
fi
shift
S=$STUB_STATE
instance=
mode=up
fix=0
json=0
purge=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --instance) instance=$2; shift ;;
    --check) mode=check ;;
    --build-only) mode=build ;;
    --down) mode=down ;;
    --purge) purge=1 ;;
    --fix) fix=1 ;;
    --json) json=1 ;;
    --repo-root | --log-file | --command-name) shift ;;
  esac
  shift
done
state=$(cat "$S/slots_state" 2>/dev/null || echo ready)
case "$mode" in
  build)
    echo "amanuensis-sandbox-slot:local" >>"$S/images"
    say_ok "Built the slot image"
    exit "${STUB_SLOT_BUILD_RC:-0}"
    ;;
  down)
    rm -f "$S/up/$instance-slots"
    # The disks go last and need sudo, so a refused password leaves only them behind.
    [ -z "${STUB_SLOT_DISK_FAIL:-}" ] || exit 1
    if [ "$purge" = 1 ]; then
      grep -v "^${instance}_slot_" "$S/volumes" >"$S/volumes.new" || true
      mv "$S/volumes.new" "$S/volumes"
      if [ -n "${AMAN_SLOT_DISK_ROOT:-}" ]; then rm -rf "${AMAN_SLOT_DISK_ROOT:?}/$instance"; fi
    fi
    exit 0
    ;;
  check)
    if [ "$state" = ready ] && [ -f "$S/up/$instance-slots" ]; then
      [ "$json" = 1 ] && echo '{"ok":true,"checks":[]}'
      exit 0
    fi
    step=attest
    case "$state" in needs_apparmor) step=apparmor ;; needs_disk) step=disk ;; needs_retire) step=retire ;; esac
    [ "$json" = 1 ] && echo "{\"ok\":false,\"checks\":[],\"step\":\"$step\",\"error\":\"stub\",\"fix\":\"stub\"}"
    exit 1
    ;;
  up)
    # Retiring the extra sandboxes is cleanup: without --fix the slots still start and the state stays.
    if [ "$state" != ready ] && [ "$fix" != 1 ] && [ "$state" != needs_retire ]; then
      echo "x $state: needs --fix" >&2
      exit 1
    fi
    say_ok "Started 2 slots"
    mkdir -p "$S/up"
    echo slots >"$S/up/$instance-slots"
    for n in 1 2; do grep -Fxq "${instance}_slot_ctl_$n" "$S/volumes" || echo "${instance}_slot_ctl_$n" >>"$S/volumes"; done
    for n in 1 2; do grep -Fxq "${instance}_slot_mirror_$n" "$S/volumes" || echo "${instance}_slot_mirror_$n" >>"$S/volumes"; done
    if [ "$state" != needs_retire ] || [ "$fix" = 1 ]; then echo ready >"$S/slots_state"; fi
    # The slots now run the image as it is.
    { cat "$S/image_id" 2>/dev/null || echo first; } >"$S/slots_run_image_id"
    exit 0
    ;;
esac
