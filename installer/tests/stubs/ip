#!/usr/bin/env bash
# Test double for `ip`: lists the IPv4 addresses in $STUB_ADDRS (space separated, each ADDRESS or INTERFACE:ADDRESS)
# the way `ip -4 -o addr show` does.
case "$*" in
  *"addr show"*)
    n=0
    for addr in ${STUB_ADDRS:-}; do
      n=$((n + 1))
      iface=eth0
      case "$addr" in *:*)
        iface=${addr%%:*}
        addr=${addr#*:}
        ;;
      esac
      echo "$((n + 1)): $iface    inet $addr/24 brd 255.255.255.255 scope global $iface"
    done
    ;;
  *) exit 1 ;;
esac
