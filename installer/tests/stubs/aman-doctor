#!/usr/bin/env bash
# Stand-in for the doctor shim: prints a fixed document and exits as STUB_DOCTOR_EXIT says.
printf 'doctor %s\n' "$*" >>"$STUB_LOG"
# The installer names the command the report is saved for; the real doctor writes it.
if [ -n "${AMAN_REPORT_COMMAND:-}" ]; then printf 'report %s\n' "$AMAN_REPORT_COMMAND" >>"$STUB_LOG"; fi
# The sandbox check has its own exit code so a failing sandbox is told apart from a failing machine.
# shellcheck source=../../lib/ui.sh
. "$(dirname "$0")/../lib/ui.sh"
ui_init
if [ "${2:-}" = sandbox ]; then
  ui_ok "run_code is ready: the sandbox slots answer through the app."
  exit "${STUB_SANDBOX_DOCTOR_EXIT:-0}"
fi
if [ "${2:-}" = --summary ]; then
  # Like the real summary: one line when all is well, otherwise only the problems.
  if [ "${STUB_DOCTOR_EXIT:-0}" = 0 ]; then
    ui_ok "All 16 checks passed"
  else
    ui_line "Instance main"
    ui_fail "Port 5556 is already in use by another program." "Run aman doctor instance --fix"
    ui_hint "15 other checks passed. Full report: aman doctor"
  fi
  exit "${STUB_DOCTOR_EXIT:-0}"
fi
echo '{"machine":[{"id":"docker","state":"ok","detail":"","fix":""}],"instances":{}}'
exit "${STUB_DOCTOR_EXIT:-0}"
