#!/usr/bin/env bash
# Records the call. Docker passes through as root would; anything else only gets logged, so the
# real machine is never touched.
printf 'sudo %s\n' "$*" >>"$STUB_LOG"
case "$1" in
  -v)
    [ -z "${STUB_SUDO_REFUSE:-}" ] || exit 1
    ;;
  docker)
    STUB_VIA_SUDO=1 exec "${STUB_BIN}/docker" "${@:2}"
    ;;
  env)
    shift
    while [ "$#" -gt 0 ] && [[ $1 == *=* ]]; do shift; done
    if [ "$1" = docker ]; then
      STUB_VIA_SUDO=1 exec "${STUB_BIN}/docker" "${@:2}"
    fi
    STUB_VIA_SUDO=1 exec "$@"
    ;;
  sh)
    [ -z "${STUB_SUDO_SH_FAIL:-}" ] || exit 1
    if printf '%s' "$3" | grep -q 'apt-get install -y docker-ce'; then
      cp "$STUB_DOCKER_SRC" "$STUB_BIN/docker"
      printf '%s\n' "$STUB_USER" >"$STUB_STATE/group_members"
    fi
    if [ -e "$STUB_STATE/run_root_sh" ]; then
      sh -c "$3"
      exit $?
    fi
    ;;
  usermod)
    printf '%s\n' "$STUB_USER" >"$STUB_STATE/group_members"
    ;;
esac
exit 0
