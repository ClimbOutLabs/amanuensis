#!/usr/bin/env bash
# Test double for the docker CLI. State lives in $STUB_STATE; every call is appended to $STUB_LOG.
# It models only what the installer asks: images, volumes, compose projects and a few run commands.
set -u
printf 'docker %s\n' "$*" >>"$STUB_LOG"
S=$STUB_STATE
mkdir -p "$S/up"
touch "$S/images" "$S/volumes"
# Fails any call whose arguments contain $STUB_FAIL_ON, to test what a command leaves behind when one step breaks.
if [ -n "${STUB_FAIL_ON:-}" ]; then
  case "$*" in *"$STUB_FAIL_ON"*) echo "stub: forced failure" >&2; exit 1 ;; esac
fi

compose_image() { sed -n 's/^[[:space:]]*image:[[:space:]]*//p' "$1" | head -n 1; }

# The old compose stack the migrate step reads exists when a test wrote its folder into $S/old_compose_dir. Its
# containers are "id project service kind" lines in $S/old_containers (kind app, postgres or other), by default the
# repository's own docker-compose.yml.
old_rows() {
  [ -f "$S/old_compose_dir" ] || return 0
  if [ -f "$S/old_containers" ]; then
    cat "$S/old_containers"
  else
    printf 'old-postgres trueforge postgres postgres\nold-server trueforge server app\n'
  fi
}
old_row() { old_rows | awk -v id="$1" '$1 == id'; }

# Models Ctrl-C or a hangup: the signal reaches the installer itself, past any subshell it runs docker from.
signal_installer() { # signal
  local p=$PPID target=''
  while [ "$p" -gt 1 ]; do
    if tr '\0' '\n' <"/proc/$p/cmdline" | grep -qx '.*install\.sh'; then
      target=$p
    elif [ -n "$target" ]; then
      break
    fi
    p=$(awk '{print $4}' "/proc/$p/stat")
  done
  [ -z "$target" ] || kill -s "$1" "$target"
}

cmd=${1:-}
shift || true
case "$cmd" in
  info)
    if [ -n "${STUB_DOCKER_DENIED:-}" ] && [ -z "${STUB_VIA_SG:-}" ] && [ -z "${STUB_VIA_SUDO:-}" ]; then
      echo "permission denied while trying to connect to the Docker daemon socket at unix:///var/run/docker.sock" >&2
      exit 1
    fi
    if [ -n "${STUB_DOCKER_DOWN:-}" ]; then
      echo "Cannot connect to the Docker daemon at unix:///var/run/docker.sock. Is the docker daemon running?" >&2
      exit 1
    fi
    if [ "${1:-}" = "--format" ]; then
      secopts=$(printf '[name=seccomp,profile=builtin%s%s]' "${STUB_ROOTLESS:+ name=rootless}" "${STUB_APPARMOR:+ name=apparmor}")
      case "${2:-}" in
        *ServerVersion*) printf '28.0.1|x86_64|%s|/nonexistent|%s|Docker Engine\n' "$secopts" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" ;;
        *MemTotal*) printf '%s\n' "${STUB_DOCKER_MEM_BYTES:-17179869184}" ;;
        *DockerRootDir*) printf '%s\n' "${STUB_DOCKER_ROOT:-}" ;;
        *CgroupVersion*) printf '%s\n' "${STUB_CGROUP:-2}" ;;
        *OperatingSystem*) printf '%s\n' "${STUB_DOCKER_OS:-Ubuntu 24.04}" ;;
        *) printf '%s\n' "$secopts" ;;
      esac
      exit 0
    fi
    echo "Server Version: 28.0.1"
    echo " Security Options:"
    echo "  seccomp"
    [ -n "${STUB_ROOTLESS:-}" ] && echo "  rootless"
    exit 0
    ;;
  version)
    if [ "${1:-}" = "--format" ]; then
      echo "${STUB_ENGINE_VERSION:-28.0.1}"
      exit 0
    fi
    echo "Client: Docker Engine"
    [ -n "${STUB_PODMAN:-}" ] && echo "Server: Podman Engine"
    exit 0
    ;;
  image)
    if [ "$1" = inspect ]; then
      for ref in "$@"; do :; done
      if grep -Fxq "$ref" "$S/images"; then
        case "$*" in
          *Architecture*) echo amd64 ;;
          # A rebuild that changed an image changes its id; tests write the new id to $S/image_id.
          *'{{.Id}}'*) echo "sha256:$(cat "$S/image_id" 2>/dev/null || echo first)" ;;
        esac
        exit 0
      fi
      exit 1
    fi
    ;;
  build)
    tag=
    while [ "$#" -gt 0 ]; do
      if [ "$1" = -t ]; then tag=$2; fi
      shift
    done
    if [ -n "${STUB_BUILD_OOM:-}" ]; then
      echo 'ERROR: process "/bin/sh -c pnpm --filter frontend build" did not complete successfully: exit code: 137' >&2
      exit 1
    fi
    if [ -n "${STUB_BUILD_FAIL:-}" ]; then
      echo '#0 building with "default" instance using docker driver'
      echo "build failed" >&2
      exit 1
    fi
    echo '#0 building with "default" instance using docker driver'
    echo '#1 [internal] load build definition from Dockerfile.dev'
    echo "$tag" >>"$S/images"
    echo "$tag" >>"$S/builds"
    exit 0
    ;;
  pull)
    echo "sha256:4c1d: Pulling from dexidp/dex"
    echo "$1" >>"$S/images"
    exit 0
    ;;
  logs)
    printf '%s\n' "${STUB_UP_FAIL_LOG:-}"
    exit 0
    ;;
  inspect)
    # The old compose containers the migrate step reads: whether Postgres runs, its image, settings and project, and
    # the app's mounts.
    for last in "$@"; do :; done
    row=$(old_row "$last")
    if [ -n "$row" ]; then
      read -r _ project _ kind <<<"$row"
      case "$*" in
        *State.Running*) [ -n "${STUB_OLD_PG_STOPPED:-}" ] && echo false || echo true ;;
        *Config.Image*) [ "$kind" = postgres ] && echo postgres:17 || echo truefoundry-server:latest ;;
        *Config.Env*) [ "$kind" = postgres ] && echo PGDATA=/var/lib/postgresql/data; echo PATH=/usr/bin ;;
        *com.docker.compose.project*) echo "$project" ;;
        *'"/data/memory"'*) [ "$kind" = app ] && echo trueforge_memory-data ;;
        *'"/data/persona-knowledge"'*) [ "$kind" = app ] && echo trueforge_persona-knowledge-data ;;
      esac
      exit 0
    fi
    # A slot container: the id of the image it was started from.
    case "$*" in
      *'{{.Image}}'*)
        for a in "$@"; do case "$a" in c[0-9]*) echo "sha256:$(cat "$S/slots_run_image_id" 2>/dev/null || echo first)" ;; esac; done
        exit 0
        ;;
    esac
    echo "stub exit 1 oom false"
    exit 0
    ;;
  network)
    sub=$1
    shift
    touch "$S/networks" "$S/network_links"
    case "$sub" in
      create)
        for n in "$@"; do :; done
        echo "$n" >>"$S/networks"
        exit 0
        ;;
      rm)
        grep -Fxv "$1" "$S/networks" >"$S/networks.new" || true
        mv "$S/networks.new" "$S/networks"
        echo "$1" >>"$S/networks_removed"
        exit 0
        ;;
      inspect)
        # With a format: the gateway of an instance's own network.
        case "$*" in
          *--format*) case "$1" in aman-*_default) echo "172.30.0.1 "; exit 0 ;; esac ;;
        esac
        grep -Fxq "$1" "$S/networks"
        exit $?
        ;;
      connect)
        # connect [--alias NAME] NETWORK CONTAINER
        [ "$1" = --alias ] && shift 2
        grep -Fxq "$1" "$S/networks" || { echo "network $1 not found" >&2; exit 1; }
        if grep -Fxq "$1 $2" "$S/network_links"; then
          echo "endpoint with name $2 already exists in network $1" >&2
          exit 1
        fi
        echo "$1 $2" >>"$S/network_links"
        exit 0
        ;;
      disconnect)
        [ "$1" = -f ] && shift
        grep -Fxv "$1 $2" "$S/network_links" >"$S/network_links.new" || true
        mv "$S/network_links.new" "$S/network_links"
        exit 0
        ;;
    esac
    exit 0
    ;;
  volume)
    sub=$1
    shift
    case "$sub" in
      inspect) grep -Fxq "$1" "$S/volumes"; exit $? ;;
      create)
        # Scratch volumes are labelled; the label lets the installer find leftovers.
        label=
        name=
        while [ "$#" -gt 0 ]; do
          case "$1" in --label) label=$2; shift 2 ;; *) name=$1; shift ;; esac
        done
        grep -Fxq "$name" "$S/volumes" || echo "$name" >>"$S/volumes"
        [ -n "$label" ] && echo "$name" >>"$S/volumes_scratch"
        echo "$name"
        exit 0
        ;;
      ls)
        case "$*" in
          *label=com.amanuensis.instance=*)
            inst=${*##*label=com.amanuensis.instance=}
            inst=${inst%% *}
            [ -f "$S/volumes_labels" ] && awk -v i="$inst" '$2 == i {print $1}' "$S/volumes_labels" | grep -Fxf - "$S/volumes"
            ;;
          *) [ -f "$S/volumes_scratch" ] && grep -Fxf "$S/volumes" "$S/volumes_scratch" ;;
        esac
        exit 0
        ;;
      rm)
        for v in "$@"; do
          [ "$v" = -f ] && continue
          case " ${STUB_VOLUME_RM_FAIL:-} " in *" $v "*) echo "volume is in use" >&2; exit 1 ;; esac
          grep -Fxv "$v" "$S/volumes" >"$S/volumes.new" || true
          mv "$S/volumes.new" "$S/volumes"
          if [ -f "$S/volumes_scratch" ] && grep -Fxq "$v" "$S/volumes_scratch"; then
            rm -rf "${S:?}/scratchfs/$v"
            echo "$v" >>"$S/scratch_removed"
          else
            echo "$v" >>"$S/volumes_removed"
          fi
        done
        exit 0
        ;;
    esac
    ;;
  ps)
    case "$*" in
      *com.docker.compose.project.working_dir=*)
        # Filters by folder, and by project or service when asked.
        dir='' want_project='' want_service=''
        for a in "$@"; do
          case "$a" in
            label=com.docker.compose.project.working_dir=*) dir=${a#label=com.docker.compose.project.working_dir=} ;;
            label=com.docker.compose.project=*) want_project=${a#label=com.docker.compose.project=} ;;
            label=com.docker.compose.service=*) want_service=${a#label=com.docker.compose.service=} ;;
          esac
        done
        [ -f "$S/old_compose_dir" ] && [ "$dir" = "$(cat "$S/old_compose_dir")" ] || exit 0
        old_rows | awk -v p="$want_project" -v s="$want_service" '(p == "" || $2 == p) && (s == "" || $3 == s) {print $1}'
        exit 0
        ;;
    esac
    proj=
    formatted=
    all=
    for a in "$@"; do
      case "$a" in
        -a) all=1 ;;
        label=com.docker.compose.project=*) proj=${a#label=com.docker.compose.project=} ;;
        '{{'*) formatted=1 ;;
      esac
    done
    if [ -n "$all" ] && [ -f "$S/failed/$proj" ]; then
      echo c-app
      exit 0
    fi
    if [ -f "$S/up/$proj" ]; then
      case "$proj" in
        aman-machine) echo c1 ;;
        *-slots) printf 'c1\nc2\nc3\nc4\n' ;;
        *)
          if [ -n "$formatted" ]; then
            # id|name|state|status|compose service, as the doctor asks for them
            for svc in loopback app dex; do printf 'c-%s|%s-%s-1|running|Up 2 minutes (healthy)|%s\n' "$svc" "$proj" "$svc" "$svc"; done
          else
            printf 'c1\nc2\nc3\n'
          fi
          ;;
      esac
    fi
    exit 0
    ;;
  exec)
    case "$*" in
      *pg_isready*) exit 0 ;;
      *pg_dump*)
        echo "$*" >>"$S/pg_dumps"
        [ -n "${STUB_PGDUMP_FAIL:-}" ] && { echo "pg_dump: connection refused" >&2; exit 1; }
        echo "PGDUMP-OF-OLD"
        exit 0
        ;;
      *pg_restore*)
        cat >"$S/pg_restored"
        exit 0
        ;;
    esac
    # `docker exec <container> aman doctor --text`: one tab-separated check per line.
    printf 'service\tok\tstub\t\nrun_code\tok\tstub\t\n'
    exit 0
    ;;
  run)
    vol=
    vol_spec=
    data_vol=
    scratch_vol=
    prev=
    for a in "$@"; do
      if [ "$prev" = -v ]; then
        vol=${a%%:*}
        vol_spec=$a
        case "$a" in
          *:/data) data_vol=$vol ;;
          *:/backup) scratch_vol=$vol ;;
        esac
      fi
      prev=$a
    done
    case "$*" in
      *"--entrypoint cat"*)
        # The slot setup copied out of the app image.
        [ -n "${STUB_NO_BUNDLE:-}" ] && exit 1
        echo "// stub sandbox setup"
        exit 0
        ;;
      *"/pki.mjs"*)
        # The authority script, run for real with the host's Node.js on the folder mounted as /tls.
        echo "$*" >>"$S/pki_runs"
        [ -n "${STUB_PKI_FAIL:-}" ] && { echo "certificate failed" >&2; exit 1; }
        [ -n "${STUB_REAL_NODE:-}" ] || { echo "the test host has no Node.js" >&2; exit 1; }
        tls_dir=
        pki=
        last=
        prev=
        for a in "$@"; do
          if [ "$prev" = -v ]; then
            case "$a" in
              *:/tls) tls_dir=${a%:/tls} ;;
              *:/pki.mjs:ro) pki=${a%:/pki.mjs:ro} ;;
            esac
          fi
          prev=$a
          last=$a
        done
        script=$(printf '%s' "$last" | sed "s#/tls#$tls_dir#g; s#/pki.mjs#$pki#g")
        PATH="$(dirname "$STUB_REAL_NODE"):/usr/bin:/bin" exec sh -c "$script"
        ;;
      *"/qr.mjs"*)
        echo "$*" >>"$S/qr_runs"
        [ -n "${STUB_REAL_NODE:-}" ] || exit 1
        qr=
        last=
        prev=
        for a in "$@"; do
          if [ "$prev" = -v ]; then
            case "$a" in *:/qr.mjs:ro) qr=${a%:/qr.mjs:ro} ;; esac
          fi
          prev=$a
          last=$a
        done
        exec "$STUB_REAL_NODE" "$qr" "$last"
        ;;
      *"rm -f /var/dex/dex.db"*)
        # Clearing the sign-in service's saved keys, which ends every session. The volume belongs to uid 1001 (the Dex
        # user, mode 755), so the delete works only as that user and only in an image where it can: the app image runs
        # as 10001. It also has to name the files under the mount, as the real rm would.
        image=
        user=
        target=${vol_spec#*:}
        prev=
        for a in "$@"; do
          [ "$prev" = --user ] && user=$a
          prev=$a
        done
        image=$(printf '%s\n' "$*" | sed -n 's/.*--entrypoint sh \([^ ]*\) -c .*/\1/p')
        case "$image" in
          *dex*) uid=${user%%:*}; uid=${uid:-1001} ;;
          *) uid=${user%%:*}; uid=${uid:-10001} ;;
        esac
        files=$(printf '%s\n' "$*" | sed -n 's/.* -c rm -f \(.*\)$/\1/p')
        case "$image" in *dex*) ;; *) uid=0 ;; esac
        if [ "$uid" != 1001 ]; then
          echo "rm: can't remove '/var/dex/dex.db': Permission denied" >&2
          exit 1
        fi
        echo "$vol_spec $(for f in $files; do printf '%s ' "${f#"$target"/}"; done)" >>"$S/dex_wipes"
        exit 0
        ;;
      *"aman hash-password"*)
        cat >"$S/hash_stdin"
        env >"$S/hash_env"
        # Derived from the password, so two different passwords never share a hash.
        hash="\$2a\$10\$$(sha256sum <"$S/hash_stdin" | cut -c1-53)"
        printf '{"hash":"%s"}\n' "$hash"
        exit 0
        ;;
      *"aman import-data --check-ready"*)
        # Downloading for the first STUB_MODEL_DOWNLOADING looks, then ready; STUB_MODEL_BROKEN answers nothing.
        [ -n "${STUB_MODEL_BROKEN:-}" ] && exit 1
        echo x >>"$S/model_checks"
        if [ "$(wc -l <"$S/model_checks")" -le "${STUB_MODEL_DOWNLOADING:-0}" ]; then
          echo '{"search_model":"downloading"}'
        else
          echo '{"search_model":"ready"}'
        fi
        exit 0
        ;;
      *"aman export-data"*)
        # Models the CLI on the copy: records the call and the settings file it was handed on stdin.
        echo "$*" >>"$S/export_runs"
        cat >"$S/export_stdin"
        case "$*" in
          *--list-users*)
            printf '%s\n' "${STUB_EXPORT_USERS:-{\"sign_in\":\"off\",\"sign_in_off_user_id\":\"trueforge-default\",\"users\":[{\"user_id\":\"trueforge-default\",\"display_name\":\"Sam Example\",\"sessions\":4}]}}"
            ;;
          *)
            [ -n "${STUB_EXPORT_FAIL:-}" ] && { echo "Memory export failed for a namespace: stub." >&2; exit 1; }
            printf '{"user_id":"stub"}\n'
            ;;
        esac
        exit 0
        ;;
      *"cp -a /from/"*)
        echo "$*" >>"$S/volume_copies"
        exit 0
        ;;
      *" cat /out/aman-export.zip"*)
        umask >"$S/copy_umask"
        printf 'PK-EXPORT-FROM-COPY'
        [ -n "${STUB_COPY_SIGNAL:-}" ] && { signal_installer "$STUB_COPY_SIGNAL"; exit 130; }
        exit 0
        ;;
      *"aman import-data"*)
        # Models the CLI: records the call, and fails on request the way a refused import does.
        echo "$*" >>"$S/import_runs"
        if [ -n "${STUB_IMPORT_SIGNAL:-}" ]; then
          signal_installer "$STUB_IMPORT_SIGNAL"
          exit 130
        fi
        [ -n "${STUB_IMPORT_FAIL:-}" ] && { echo "This instance already has chats, so the import was refused and nothing was changed." >&2; exit 1; }
        printf '{"user_id":"stub","chats":1}\n'
        exit 0
        ;;
      *"aman backup"*)
        # Models the CLI: refuses a missing --target, writes db.sqlite, memory/, persona-knowledge/ and a manifest there.
        echo "$*" >>"$S/backup_runs"
        [ -n "${STUB_BACKUP_FAIL:-}" ] && { echo "backup failed" >&2; exit 1; }
        case "$*" in *"--target /backup"*) ;; *) echo "Missing --target <directory>." >&2; exit 2 ;; esac
        [ -n "$scratch_vol" ] || exit 2
        out=$S/scratchfs/$scratch_vol
        mkdir -p "$out/memory" "$out/persona-knowledge"
        printf 'SQLITE-OF-%s\n' "$data_vol" >"$out/db.sqlite"
        printf '{"version":1,"files":[]}\n' >"$out/manifest.json"
        printf '{"target":"/backup","manifest":"manifest.json","files":1,"bytes":1}\n'
        exit 0
        ;;
      *" test -f "*)
        # The probe for a database file; a data volume listed in $S/no_db has none.
        [ -f "$S/no_db/$vol" ] && exit 1
        exit 0
        ;;
      *" test ! -e "*)
        # Whether the folder is missing or searchable; a data volume listed in $S/unreadable is neither.
        [ -f "$S/unreadable/$vol" ] && exit 1
        exit 0
        ;;
      *" tar "*)
        if [ -d "$S/scratchfs/$vol" ]; then
          tar -C "$S/scratchfs/$vol" -cf - .
        else
          printf 'TAR-OF-%s\n' "$vol"
        fi
        exit 0
        ;;
      *"sh -c"*)
        cat >"$S/restored_$vol"
        echo "restore $vol" >>"$S/restores"
        exit 0
        ;;
    esac
    exit 0
    ;;
  rm)
    for c in "$@"; do :; done
    echo "$c" >>"$S/containers_removed"
    exit 0
    ;;
  compose)
    if [ "${1:-}" = version ]; then
      echo "${STUB_COMPOSE_VERSION-2.29.1}"
      exit 0
    fi
    proj=
    file=
    envfile=
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --project-name) proj=$2; shift 2 ;;
        --env-file) envfile=$2; shift 2 ;;
        --project-directory) shift 2 ;;
        -f) file=$2; shift 2 ;;
        *) break ;;
      esac
    done
    sub=${1:-}
    shift || true
    case "$sub" in
      up)
        img=$(compose_image "$file")
        # An external volume has to exist already, as in Compose.
        missing=$(awk '/^    name: / {n = $2} /external: true/ {print n}' "$file" | while read -r v; do grep -Fxq "$v" "$S/volumes" || echo "$v"; done)
        if [ -n "$missing" ]; then
          echo "external volume \"$missing\" not found" >&2
          exit 1
        fi
        if [ -n "${STUB_UP_FAIL_LOG:-}" ] && [ "$proj" != aman-machine ]; then
          mkdir -p "$S/failed"
          : >"$S/failed/$proj"
          echo "dependency failed to start: container ${proj}-app-1 is unhealthy" >&2
          exit 1
        fi
        if [ -n "${STUB_UP_FAIL_UNLESS_TAG:-}" ] && [ "$img" != "$STUB_UP_FAIL_UNLESS_TAG" ] && [ "$proj" != aman-machine ]; then
          echo "container is unhealthy" >&2
          exit 1
        fi
        case " $* " in *" dex "*) rm -f "$S/dex_stopped_$proj" ;; esac
        printf '%s\n' "$img" >"$S/up/$proj"
        awk '/^    name: / {n = $2} /com.amanuensis.instance:/ {print n, $2}' "$file" >>"$S/volumes_labels"
        grep -o 'name: aman_[a-z0-9_-]*' "$file" | sed 's/name: //' | while read -r v; do
          case "$v" in
            *_stt) grep -Fxq "$v" "$S/networks" 2>/dev/null || echo "$v" >>"$S/networks" ;;
            *) grep -Fxq "$v" "$S/volumes" || echo "$v" >>"$S/volumes" ;;
          esac
        done
        exit 0
        ;;
      exec)
        # `exec -T app aman demo-seed ...`: refuses unless the instance .env turns demo mode on, as the real command does.
        case "$*" in
          *"aman demo-seed"*)
            echo "$*" >>"$S/demo_runs"
            [ -n "${STUB_DEMO_FAIL:-}" ] && { echo "No model is configured yet." >&2; exit 1; }
            if ! grep -q '^DEMO_MODE=true$' "$envfile"; then
              echo "Refusing to seed: DEMO_MODE is not true. This command only runs on a demo instance." >&2
              exit 1
            fi
            printf '{"action":"seed"}\n'
            ;;
        esac
        exit 0
        ;;
      stop)
        # The instance counts as down once its app is stopped (the stub models a project as up or not).
        echo "$sub $*" >>"$S/compose_stops"
        rm -f "$S/up/$proj"
        exit 0
        ;;
      down)
        rm -f "$S/up/$proj"
        n=aman_${proj#aman-}_stt
        grep -Fxv "$n" "$S/networks" >"$S/networks.new" 2>/dev/null; mv "$S/networks.new" "$S/networks" 2>/dev/null
        exit 0
        ;;
      stop)
        case " $* " in *" dex "*) : >"$S/dex_stopped_$proj" ;; esac
        exit 0
        ;;
      *) exit 0 ;;
    esac
    ;;
esac
exit 0
