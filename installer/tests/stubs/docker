#!/usr/bin/env bash
# Test double for the docker CLI. State lives in $STUB_STATE; every call is appended to $STUB_LOG.
# It models only what the installer asks: images, volumes, compose projects and a few run commands.
set -u
printf 'docker %s\n' "$*" >>"$STUB_LOG"
S=$STUB_STATE
mkdir -p "$S/up"
touch "$S/images" "$S/volumes"

compose_image() { sed -n 's/^[[:space:]]*image:[[:space:]]*//p' "$1" | head -n 1; }

cmd=${1:-}
shift || true
case "$cmd" in
  info)
    if [ -n "${STUB_DOCKER_DENIED:-}" ] && [ -z "${STUB_VIA_SG:-}" ] && [ -z "${STUB_VIA_SUDO:-}" ]; then
      echo "permission denied while trying to connect to the Docker daemon socket at unix:///var/run/docker.sock" >&2
      exit 1
    fi
    if [ -n "${STUB_DOCKER_DOWN:-}" ]; then
      echo "Cannot connect to the Docker daemon at unix:///var/run/docker.sock. Is the docker daemon running?" >&2
      exit 1
    fi
    if [ "${1:-}" = "--format" ]; then
      printf '[name=seccomp,profile=builtin%s]\n' "${STUB_ROOTLESS:+ name=rootless}"
      exit 0
    fi
    echo "Server Version: 27.1.1"
    echo " Security Options:"
    echo "  seccomp"
    [ -n "${STUB_ROOTLESS:-}" ] && echo "  rootless"
    exit 0
    ;;
  version)
    if [ "${1:-}" = "--format" ]; then
      echo "${STUB_ENGINE_VERSION:-27.1.1}"
      exit 0
    fi
    echo "Client: Docker Engine"
    [ -n "${STUB_PODMAN:-}" ] && echo "Server: Podman Engine"
    exit 0
    ;;
  image)
    if [ "$1" = inspect ]; then
      grep -Fxq "$2" "$S/images"
      exit $?
    fi
    ;;
  build)
    tag=
    while [ "$#" -gt 0 ]; do
      if [ "$1" = -t ]; then tag=$2; fi
      shift
    done
    if [ -n "${STUB_BUILD_FAIL:-}" ]; then
      echo "build failed" >&2
      exit 1
    fi
    echo "$tag" >>"$S/images"
    echo "$tag" >>"$S/builds"
    exit 0
    ;;
  pull)
    echo "$1" >>"$S/images"
    exit 0
    ;;
  volume)
    sub=$1
    shift
    case "$sub" in
      inspect) grep -Fxq "$1" "$S/volumes"; exit $? ;;
      rm)
        for v in "$@"; do
          [ "$v" = -f ] && continue
          grep -Fxv "$v" "$S/volumes" >"$S/volumes.new" || true
          mv "$S/volumes.new" "$S/volumes"
          echo "$v" >>"$S/volumes_removed"
        done
        exit 0
        ;;
    esac
    ;;
  ps)
    proj=
    for a in "$@"; do
      case "$a" in label=com.docker.compose.project=*) proj=${a#label=com.docker.compose.project=} ;; esac
    done
    if [ -f "$S/up/$proj" ]; then
      case "$proj" in aman-machine) echo c1 ;; *) printf 'c1\nc2\nc3\n' ;; esac
    fi
    exit 0
    ;;
  run)
    vol=
    prev=
    for a in "$@"; do
      if [ "$prev" = -v ]; then vol=${a%%:*}; fi
      prev=$a
    done
    case "$*" in
      *"amanuensis hash-password"*)
        cat >"$S/hash_stdin"
        env >"$S/hash_env"
        hash="\$2a\$10\$abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXY01"
        printf '{"hash":"%s"}\n' "$hash"
        exit 0
        ;;
      *"amanuensis backup"*)
        printf 'SQLITE-OF-%s\n' "$vol"
        exit 0
        ;;
      *" tar "*)
        printf 'TAR-OF-%s\n' "$vol"
        exit 0
        ;;
      *"sh -c"*)
        cat >"$S/restored_$vol"
        echo "restore $vol" >>"$S/restores"
        exit 0
        ;;
    esac
    exit 0
    ;;
  compose)
    if [ "${1:-}" = version ]; then
      echo "${STUB_COMPOSE_VERSION:-2.29.1}"
      exit 0
    fi
    proj=
    file=
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --project-name) proj=$2; shift 2 ;;
        --project-directory | --env-file) shift 2 ;;
        -f) file=$2; shift 2 ;;
        *) break ;;
      esac
    done
    sub=${1:-}
    shift || true
    case "$sub" in
      up)
        img=$(compose_image "$file")
        if [ -n "${STUB_UP_FAIL_UNLESS_TAG:-}" ] && [ "$img" != "$STUB_UP_FAIL_UNLESS_TAG" ] && [ "$proj" != aman-machine ]; then
          echo "container is unhealthy" >&2
          exit 1
        fi
        printf '%s\n' "$img" >"$S/up/$proj"
        grep -o 'name: aman_[a-z0-9_-]*' "$file" | sed 's/name: //' | while read -r v; do
          grep -Fxq "$v" "$S/volumes" || echo "$v" >>"$S/volumes"
        done
        exit 0
        ;;
      down)
        rm -f "$S/up/$proj"
        exit 0
        ;;
      exec)
        [ -n "${STUB_EXEC_FAIL:-}" ] && exit 1
        printf 'SQLITE-OF-%s\n' "$proj"
        exit 0
        ;;
      *) exit 0 ;;
    esac
    ;;
esac
exit 0
