#!/usr/bin/env bash
# Stands for this computer's security chip. STUB_CHIP_MISSING models a computer without one, STUB_CHIP_REFUSES a
# chip that will not take a key, and STUB_CHIP_GARBLES one that gives something else back. The copy it writes is
# the key with every byte shifted, so a test can tell that the key itself is not in the file.
printf 'stub-systemd-creds %s\n' "$*" >>"$STUB_LOG"
case "$1" in
  has-tpm2)
    [ -z "${STUB_CHIP_MISSING:-}" ] || exit 1
    exit 0
    ;;
  encrypt)
    [ -z "${STUB_CHIP_REFUSES:-}" ] || { cat >/dev/null; echo "the chip refused" >&2; exit 1; }
    out=${*: -1}
    { printf 'CHIP-COPY\n'; tr 'A-Za-z0-9' 'N-ZA-Mn-za-m5-90-4'; } >"$out"
    ;;
  decrypt)
    in=${*: -2:1}
    if [ -n "${STUB_CHIP_GARBLES:-}" ]; then echo garbled; exit 0; fi
    tail -n +2 "$in" | tr 'N-ZA-Mn-za-m5-90-4' 'A-Za-z0-9'
    ;;
esac
