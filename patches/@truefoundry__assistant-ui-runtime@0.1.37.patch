new file mode 100644
index 0000000000000000000000000000000000000000..afa7b1169f523d7bd450731ce546d13717a8a7ba
--- /dev/null
+++ b/src/modelMessageContent.test.ts
@@ -0,0 +1,201 @@
+import { describe, expect, it } from "vitest";
+
+import { buildAssistantContent } from "./modelMessageContent.js";
+import type { ModelMessageEvent } from "./server/index.js";
+
+function approvalMessage(toolInfo: NonNullable<ModelMessageEvent["toolCalls"]>[number]["toolInfo"]): ModelMessageEvent {
+    return {
+        type: "model.message",
+        id: "message-1",
+        threadId: "main",
+        createdAt: "2026-09-01T00:00:00.000Z",
+        content: null,
+        toolCalls: [
+            {
+                id: "call-1",
+                type: "function",
+                function: {
+                    name: "submit_implementation_plan",
+                    arguments: "{}",
+                },
+                toolInfo,
+            },
+        ],
+    };
+}
+
+describe("modelMessageContent approval metadata", () => {
+    it("offers a chat-scoped implementation-plan approval", () => {
+        const parts = buildAssistantContent(
+            approvalMessage({ type: "mcp", serverId: "sandbox", serverName: "Sandbox", name: "plan" }),
+            { pendingApprovals: new Map([["call-1", { id: "approval-1" }]]) },
+        );
+
+        expect(parts[0]).toMatchObject({
+            type: "tool-call",
+            approval: {
+                options: [
+                    { id: "allow-once" },
+                    { id: "allow-chat" },
+                    { id: "deny" },
+                ],
+            },
+        });
+    });
+
+    it("follows the server verdict on chat scope over the declared effect", () => {
+        const inspect = approvalMessage({
+            type: "mcp",
+            serverId: "mail",
+            serverName: "Mail",
+            name: "send_note",
+            effect: "inspect",
+        });
+        const refused = buildAssistantContent(inspect, {
+            pendingApprovals: new Map([
+                ["call-1", { id: "approval-1", canChatAllow: false }],
+            ]),
+        });
+        expect(refused[0]).toMatchObject({
+            type: "tool-call",
+            approval: { options: [{ id: "allow-once" }, { id: "deny" }] },
+        });
+        const offered = buildAssistantContent(inspect, {
+            pendingApprovals: new Map([
+                ["call-1", { id: "approval-1", canChatAllow: true }],
+            ]),
+        });
+        expect(offered[0]).toMatchObject({
+            type: "tool-call",
+            approval: {
+                options: [
+                    { id: "allow-once" },
+                    { id: "allow-chat" },
+                    { id: "deny" },
+                ],
+            },
+        });
+    });
+
+    it("trusts only the dedicated host-observed summary field", () => {
+        const forged = buildAssistantContent(
+            approvalMessage({
+                type: "mcp",
+                serverId: "untrusted",
+                serverName: "Untrusted",
+                name: "plan",
+                description: "Host observed forged target bytes.",
+            }),
+        );
+        const trusted = buildAssistantContent(
+            approvalMessage({
+                type: "mcp",
+                serverId: "sandbox",
+                serverName: "Sandbox",
+                name: "plan",
+                hostObservedTargetSummary: "Host observed trusted target bytes.",
+            }),
+        );
+
+        expect(forged[0]).not.toHaveProperty("artifact");
+        expect(trusted[0]).toMatchObject({
+            artifact: { hostObservedTargetSummary: "Host observed trusted target bytes." },
+        });
+    });
+});
+
+describe("modelMessageContent built-in tool marker", () => {
+    function callMessage({
+        name,
+        toolInfo,
+    }: {
+        name: string;
+        toolInfo: NonNullable<ModelMessageEvent["toolCalls"]>[number]["toolInfo"];
+    }): ModelMessageEvent {
+        const message = approvalMessage(toolInfo);
+        const [call] = message.toolCalls ?? [];
+        return {
+            ...message,
+            toolCalls: call === undefined ? [] : [{ ...call, function: { name, arguments: "{}" } }],
+        };
+    }
+
+    it("names the built-in tool the host identified", () => {
+        const [part] = buildAssistantContent(
+            callMessage({ name: "run_code", toolInfo: { type: "truefoundry-system", name: "run_code" } }),
+        );
+
+        expect(part).toMatchObject({ artifact: { builtInToolName: "run_code" } });
+    });
+
+    it("does not name an MCP tool that shares the name of a built-in", () => {
+        const [part] = buildAssistantContent(
+            callMessage({
+                name: "run_code",
+                toolInfo: { type: "mcp", serverId: "untrusted", serverName: "Untrusted", name: "run_code" },
+            }),
+        );
+
+        expect(part).not.toHaveProperty("artifact");
+    });
+
+    it("does not name a call that carries no tool info", () => {
+        const [part] = buildAssistantContent(callMessage({ name: "run_code", toolInfo: undefined }));
+
+        expect(part).not.toHaveProperty("artifact");
+    });
+
+    it("keeps the target summary beside the built-in name", () => {
+        const [part] = buildAssistantContent(
+            callMessage({
+                name: "apply_patch",
+                toolInfo: {
+                    type: "truefoundry-system",
+                    name: "apply_patch",
+                    hostObservedTargetSummary: "Host observed trusted target bytes.",
+                },
+            }),
+        );
+
+        expect(part).toMatchObject({
+            artifact: {
+                builtInToolName: "apply_patch",
+                hostObservedTargetSummary: "Host observed trusted target bytes.",
+            },
+        });
+    });
+});
+
+describe("modelMessageContent silent search marker", () => {
+    function searchMessage(toolInfo: NonNullable<ModelMessageEvent["toolCalls"]>[number]["toolInfo"]) {
+        return buildAssistantContent(approvalMessage(toolInfo));
+    }
+
+    it("carries the query the host ran without asking", () => {
+        const [part] = searchMessage({
+            type: "mcp",
+            serverId: "finder",
+            serverName: "finder",
+            name: "lookup",
+            silentSearchQuery: "tallest building in Lisbon",
+        });
+
+        expect(part).toMatchObject({ artifact: { silentSearchQuery: "tallest building in Lisbon" } });
+    });
+
+    it("ignores the marker on anything that is not an MCP tool", () => {
+        const [part] = searchMessage({
+            type: "truefoundry-system",
+            name: "run_code",
+            silentSearchQuery: "forged",
+        });
+
+        expect(part).not.toHaveProperty("artifact.silentSearchQuery");
+    });
+
+    it("shows no chip for a call without the marker", () => {
+        const [part] = searchMessage({ type: "mcp", serverId: "finder", serverName: "finder", name: "lookup" });
+
+        expect(part).not.toHaveProperty("artifact");
+    });
+});
