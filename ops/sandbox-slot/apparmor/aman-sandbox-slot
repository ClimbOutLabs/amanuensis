# AppArmor profile for the gVisor sandbox slot: Docker's default container profile
# (moby/profiles apparmor template) with the few changes runsc needs to build its
# rootless sandbox. Load once as root: sudo apparmor_parser -r -W <this file>
# Every line marked ADDED or CHANGED differs from docker-default.

# CHANGED: docker-default pins abi/3.0. The userns rule only exists from abi/4.0 (Ubuntu 24.04+).
abi <abi/4.0>,

#include <tunables/global>

profile aman-sandbox-slot flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  # ADDED: abi/4.0 no longer folds unix sockets into "network"; runsc connects its
  # sandbox and gofer processes with unix socketpairs.
  unix,
  # Disallow obsolete socket families removed from the Linux kernel.
  audit deny network ax25,
  audit deny network ipx,
  audit deny network appletalk,
  audit deny network netrom,
  audit deny network rose,
  audit deny network econet,
  audit deny network atmsvc,
  audit deny network irda,
  audit deny network wanpipe,
  audit deny network isdn,
  audit deny network caif,
  # Disallow AF_ALG (Linux kernel crypto API).
  audit deny network alg,
  # Disallow AF_VSOCK to prevent host/guest communication.
  audit deny network vsock,
  capability,
  file,
  umount,

  # ADDED: lets the slot create the user namespace that runsc --rootless runs in.
  # Ubuntu 24.04 denies this to confined processes unless the profile says so, which
  # is what lets the sysctl kernel.apparmor_restrict_unprivileged_userns stay at 1.
  userns,

  # CHANGED: docker-default has "deny mount". runsc mounts tmpfs and binds the guest
  # rootfs inside its own mount namespace. The kernel still demands CAP_SYS_ADMIN over
  # that namespace, which the slot holds only inside the user namespace it just created.
  mount,
  # ADDED: runsc switches into that private mount tree with pivot_root.
  pivot_root,

  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  # runc and crun may send signals to container processes (docker stop).
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer=aman-sandbox-slot,

  audit deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  # CHANGED: the two-character alternative is split so that /proc/fs is no longer matched here. runsc
  # mounts a private tmpfs on /proc/fs inside its own mount namespace and builds its gofer root on it
  # (directories proc, root and etc, then pivot_root), so those writes land on the tmpfs, not the kernel's
  # /proc/fs. AppArmor only sees the path, so the next two rules re-deny everything under /proc/fs except
  # those three names, and the alias of the read-only /proc bind mount at /proc/fs/proc.
  audit deny @{PROC}/{[^1-9/],[^1-9/f][^0-9/],f[^0-9/s],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  audit deny @{PROC}/fs/{?,??,[^e]??,?[^t]?,??[^c],[^pr]???,p[^r]??,pr[^o]?,pro[^c],r[^o]??,ro[^o]?,roo[^t],?????*}{,/**} w,
  audit deny @{PROC}/fs/proc/?** w,
  audit deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  audit deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  audit deny @{PROC}/sysrq-trigger rwklx,
  audit deny @{PROC}/kcore rwklx,

  audit deny /sys/[^f]*/** wklx,
  audit deny /sys/f[^s]*/** wklx,
  audit deny /sys/fs/[^c]*/** wklx,
  audit deny /sys/fs/c[^g]*/** wklx,
  audit deny /sys/fs/cg[^r]*/** wklx,
  audit deny /sys/firmware/** rwklx,
  audit deny /sys/devices/virtual/powercap/** rwklx,
  audit deny /sys/kernel/security/** rwklx,

  # Processes within the container may trace each other; systrap uses ptrace on its stubs.
  ptrace (trace,tracedby,read,readby) peer=aman-sandbox-slot,
}
