# Dummy values so config.ts loads in unit tests; no service is contacted.
# STANDALONE defaults to true → SQLite (Postgres / PUBLIC_BASE_URL unused).
POSTGRES_USER=test
POSTGRES_PASSWORD=test
POSTGRES_DB=test
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
MCP_DCR_OAUTH_CLIENT_NAME=truefoundry-harness
# run_code startup validation is fail-closed: dummy pinned digest + key path so
# config.ts loads in unit tests (no daemon or image is contacted).
SANDBOX_IMAGE=test-sandbox:0.0.0@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
SANDBOX_COSIGN_PUBLIC_KEY_PATH=/tmp/test-cosign.pub
# Most suites exercise the provider path, which only the legacy Docker backend reaches; the default is covered
# by tests that unset this.
SANDBOX_BACKEND=docker
