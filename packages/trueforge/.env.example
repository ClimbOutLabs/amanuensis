## ---------------------------------------------------------------------------
## Public agent server environment
##
## Copy to .env and fill in the values. The server validates all of these at
## startup and refuses to boot on any invalid value (bad JSON, bad URL, etc.).
##
## Topology (STANDALONE) and NODE_ENV are set by root pnpm scripts
## (`pnpm dev`, `pnpm standalone:dev`, `pnpm start`, …). Those process env
## values win over this file. Uncomment STANDALONE below only when running the
## server package directly (e.g. `node dist/main.js` or `tsx src/main.ts`).
## ---------------------------------------------------------------------------

## Useful to configure the application data dir for different environments.
APP_DATA_DIR_SUFFIX=dev

## Absolute path that replaces the OS data dir for the SQLite default, sandbox roots, sandbox state and the git
## bridge. Set it where the process has no writable home directory (the container images set /data/app).
# APP_DATA_DIR=

## HTTP port the server listens on. Optional, defaults to 8790.
PORT=8790

## HTTP bind address. Optional, defaults to localhost. Production Docker images set 0.0.0.0.
# HOST=0.0.0.0

## Optional override for the model catalog YAML (GET /catalog/model-providers).
## When unset, the catalog inlined at build time (catalog/model-catalog.yaml) is used.
# MODEL_CATALOG_PATH=/path/to/model-catalog.yaml

## TrueFoundry mode (STANDALONE=false only; ignored when STANDALONE=true). When set, GET /models
## lists tenant-enabled chat models from the TrueFoundry ServiceFoundry server (caller token) and
## turns call the tenant's default AI Gateway. Unset = local API-key model catalog. Mutually
## exclusive with OIDC.
# TRUEFOUNDRY_SERVICEFOUNDRY_SERVER_URL=https://servicefoundry-server.truefoundry.svc.cluster.local
## Required when TRUEFOUNDRY_SERVICEFOUNDRY_SERVER_URL is set. Used only to vend agent tokens for saved-agent turns.
# TRUEFOUNDRY_API_KEY=
## Max ms for non-agent ServiceFoundry HTTP calls. Default 10000.
# TRUEFOUNDRY_SERVICEFOUNDRY_HTTP_TIMEOUT_MS=10000
## Max ms for ServiceFoundry agent create/update/delete calls. Default 3000.
# TRUEFOUNDRY_SERVICEFOUNDRY_HTTP_AGENT_TIMEOUT_MS=3000

## Mutual TLS for this process's HTTPS listener and controller→server. Off by default (plain HTTP).
## When true, serves HTTPS with client-cert enforcement (except /healthz) and the controller
## presents tls.crt/tls.key from TRUEFORGE_MTLS_CERTS_DIR. Chart probes must use scheme HTTPS.
# TRUEFORGE_MTLS_ENABLED=false
# TRUEFORGE_MTLS_CERTS_DIR=/etc/tls

## Internal mutual TLS for calls to the ServiceFoundry server. When true, trueforge presents its client
## certificate (and upgrades a mesh-direct http:// peer URL to https://). Only meaningful in-cluster,
## where TRUEFOUNDRY_SERVICEFOUNDRY_SERVER_URL points at the ServiceFoundry server Service directly.
# TRUEFOUNDRY_MTLS_ENABLED=false
## Directory holding the mTLS cert triple (tls.crt / tls.key / ca.crt) when TRUEFOUNDRY_MTLS_ENABLED=true.
# TRUEFOUNDRY_MTLS_CERTS_DIR=/etc/tls/truefoundry

## Shared sandbox for all tenants (TrueFoundry mode only). PUT settings is disabled (424).
# TRUEFOUNDRY_SANDBOX_ENABLED=false
# TRUEFOUNDRY_SANDBOX_PROVIDER=daytona
## Required for daytona; optional for truefoundry.
# TRUEFOUNDRY_SANDBOX_API_KEY=
## Required when provider is truefoundry.
# TRUEFOUNDRY_SANDBOX_SERVER_URL=http://sandbox-server
## Static JSON settings (provider-specific). Daytona: snapshot + timeouts. TrueFoundry: nats_bridge_url.
# TRUEFOUNDRY_SANDBOX_SETTINGS={"snapshotName":"my-snap","timeoutMs":60000,"autoStopIntervalInMinutes":5,"autoArchiveIntervalInMinutes":60,"autoDeleteIntervalInMinutes":43200}
# TRUEFOUNDRY_SANDBOX_SETTINGS={"nats_bridge_url":"ws://nats-bridge"}

## Optional override for the MCP catalog YAML (GET /catalog/mcp-servers).
## When unset, the catalog inlined at build time (catalog/mcp-catalog.yaml) is used.
# MCP_CATALOG_PATH=/path/to/mcp-catalog.yaml

## Optional override for the skill catalog YAML (GET /catalog/skills).
## When unset, the catalog inlined at build time (catalog/skill-catalog.yaml) is used.
# SKILL_CATALOG_PATH=/path/to/skill-catalog.yaml

## Optional override for the sandbox catalog YAML (GET /catalog/sandbox-providers).
## When unset, the catalog inlined at build time (catalog/sandbox-catalog.yaml) is used.
# SANDBOX_CATALOG_PATH=/path/to/sandbox-catalog.yaml

## Frontend build the server serves alongside the API. Optional; defaults to
## packages/trueforge/dist/_frontend (after build) or monorepo packages/frontend/dist.
## With no build there the server logs a warning and serves the API only.
# FRONTEND_DIR=/absolute/path/to/frontend/dist

## Deployment topology: single process (true, default) uses SQLite and
## disables Redis/executor peering. Standalone is for local use only and is
## not production-safe (needs the OIDC_* block below; run `pnpm dev:login` for a local
## Dex; keep it on localhost). false uses
## Postgres + Redis so cancels that land on the wrong replica still work.
## Prefer root scripts (`pnpm standalone:*` vs `pnpm dev` / `pnpm start`)
## over setting this here.
# STANDALONE=false

## Absolute path to the SQLite database file. Used when STANDALONE=true;
## defaults to the OS data dir from env-paths (app name "trueforge"):
##   macOS: ~/Library/Application Support/trueforge/db/db.sqlite
##   Linux: ~/.local/share/trueforge/db/db.sqlite
##   Windows: %LOCALAPPDATA%\trueforge\Data\db\db.sqlite
# SQLITE_PATH=

## Used when STANDALONE=false (ignored in standalone). Redis connection URL for
## executor peering. Defaults to redis://localhost:6379 if unset.
## `docker-compose.yml` overrides this to redis://redis:6379 for the server container.
REDIS_URL=redis://localhost:6379

## Redis request/reply peering knobs (STANDALONE=false only). All optional.
## Max ms to wait for a peer executor's reply before failing with 424. Default 60000.
# REDIS_REQUEST_REPLY_TIMEOUT_MS=60000
## How often this process refreshes its peering heartbeat key. Default 5000.
# REDIS_REQUEST_REPLY_HEARTBEAT_INTERVAL_MS=5000
## TTL for reply values so abandoned reply keys are reclaimed. Default 120000.
# REDIS_REQUEST_REPLY_REPLY_TTL_MS=120000
## Sleep between reply poll attempts while waiting on a peer. Default 500.
# REDIS_REQUEST_REPLY_POLL_INTERVAL_MS=500

## Turn execution and resumable stream settings. All optional.
## Max seconds a single turn may run before cancellation. Default 600 (10 minutes).
# SERVER_EXECUTION_TIMEOUT_SECONDS=600
## Max seconds to wait for turn cancellation + connection drain on SIGTERM/SIGINT. Default 30.
# GRACEFUL_TIMEOUT_SECONDS=30
## Active stream TTL defaults to SERVER_EXECUTION_TIMEOUT_SECONDS + 300.
# TURN_STREAM_TTL_SECONDS=900
## Completed streams remain available for 5 minutes by default.
# TURN_STREAM_POST_COMPLETION_TTL_SECONDS=300
## A subscribe request stays open for 10 minutes by default.
# TURN_SUBSCRIBE_TIMEOUT_MS=600000
## How long one write to a streamed reply may take, in ms. After this the stream ends, so the
## browser reconnects, and the reply keeps running. Default 60000.
# TURN_SSE_STREAM_WRITE_TIMEOUT_MS=60000

## Public URL of the app. Callbacks for server OIDC and MCP OAuth/DCR use this value.
## Standalone: an origin with no path (https URLs make auth cookies Secure); unset
## defaults to http://localhost:$PORT. STANDALONE=false: origin plus optional pathname,
## the UI/API public prefix when a reverse proxy strips it
## (e.g. https://host/custom/proxy/path → assets/API/routes under /custom/proxy/path).
# PUBLIC_BASE_URL=http://localhost:3000

## Addresses the app may be opened at, comma separated origins (standalone). Sign-in then starts and ends at
## the address the request came to, and the app serves the OIDC issuer's /dex path itself so those addresses
## need no second open port. Plain http only for this computer and private networks; a public address needs https.
## Unset keeps the single PUBLIC_BASE_URL origin. The installer fills this in.
# ALLOWED_ORIGINS=http://127.0.0.1:8790,http://192.168.1.20:8790

## Where the OIDC issuer listens on this computer (loopback http, with the issuer path), for an instance whose issuer is a
## public https address: the app then serves that address's sign-in pages itself and limits password guessing.
## Behind a reverse proxy, it must set X-Forwarded-For. The installer fills this in.
# LOGIN_UPSTREAM_URL=http://127.0.0.1:5556/dex

## Addresses of a reverse proxy, besides this computer, whose X-Forwarded-For is believed when it reaches the app through
## a published port (the Docker network gateway). Comma separated IP addresses. The installer fills this in.
# TRUSTED_PROXY_ADDRESSES=172.18.0.1

## Suffix appended to every auth cookie name (letters, digits, "_" or "-"). Browsers
## share cookies across ports on one hostname, so give each instance its own value.
# AUTH_COOKIE_SUFFIX=_main

## Base URL the controller uses to reach the server API (HTTP schedule handoff).
## Dedicated controller (STANDALONE=false) and standalone loopback both use this.
## Defaults to http://localhost:$PORT; point it at the server Service in a split deployment.
# SERVER_URL=http://localhost:8790

## Service credential for controller → /api/internal/schedules.
## When unset, standalone generates a random 32-byte key at process start (local only)
## and refuses placeholder values. STANDALONE=false falls back to a well-known placeholder
## with a startup warning; set a real key for any shared deployment.
# TRUEFORGE_API_KEY=placeholder-value-please-generate-your-own

## ---------------------------------------------------------------------------
## MCP knobs.
## ---------------------------------------------------------------------------
## Client name used for Dynamic Client Registration (DCR) of MCP servers.
## This is the client name shown on authorization-server consent screens.
## Optional; defaults to truefoundry-harness.
# MCP_DCR_OAUTH_CLIENT_NAME=truefoundry-harness

## MCP client timeouts. All optional.
## Max ms for one MCP request. Default 240000 (4 minutes).
# MCP_REQUEST_TIMEOUT_MS=240000
## Max ms for an MCP transport connection. Default 30000.
# MCP_CONNECT_TIMEOUT_MS=30000
## Max bytes for one remote MCP tool-call HTTP response body (JSON / POST SSE). Default 50 MB.
# MCP_TOOL_CALL_MAX_RESPONSE_BYTES=52428800
## How long to wait to open a connection to an MCP server, in ms. Default 5000.
# MCP_HTTP_CONNECT_TIMEOUT_MS=5000
## How long to wait for an MCP server to start answering, in ms. Must be at least
## MCP_REQUEST_TIMEOUT_MS plus 5000, so a slow tool is reported as slow. Default 245000.
# MCP_HTTP_HEADERS_TIMEOUT_MS=245000
## How long an MCP answer may go quiet before the connection is dropped, in ms.
## Default 1800000 (30 minutes), so a quiet event stream stays open.
# MCP_HTTP_BODY_TIMEOUT_MS=1800000
## How many times to try an MCP request again when the server never got it
## (it could not be reached in time, or a gateway said try again). 0 turns this off. Default 2.
# MCP_HTTP_MAX_RETRIES=2

## Requests to model providers. All optional.
## How long to wait for a model's first output, from when the request is sent, in ms.
## A local model that takes long to load needs more. Default 90000.
# MODEL_FIRST_RESPONSE_TIMEOUT_MS=90000
## How long a model may go quiet once it has started answering, in ms. Default 60000.
# MODEL_STREAM_IDLE_TIMEOUT_MS=60000
## The same while the model is writing out a tool call, in ms. Default 180000.
# MODEL_STREAM_TOOL_CALL_IDLE_TIMEOUT_MS=180000
## How long to wait to open a connection to the provider, in ms. Default 5000.
# MODEL_HTTP_CONNECT_TIMEOUT_MS=5000
## A backstop on waiting for the provider to start answering, in ms. Default 300000
## (5 minutes). For a slow local model, raise MODEL_FIRST_RESPONSE_TIMEOUT_MS instead:
## that wait is shorter and is the one a slow model meets first.
# MODEL_HTTP_HEADERS_TIMEOUT_MS=300000
## How long an answer may go quiet before the connection is dropped, in ms. Default 300000.
# MODEL_HTTP_BODY_TIMEOUT_MS=300000
## How many times to try a model request again when the provider never got it or a gateway
## said try again. A server that asks to wait more than 5 seconds is not retried. 0 turns
## this off. Default 2.
# MODEL_HTTP_MAX_RETRIES=2

## Origins of your own memory provider, comma-separated, each an exact scheme://host[:port]
## with no path and no wildcard. A connector saved as the memory provider on a listed origin is
## first-party: its tools that declare readOnlyHint true and openWorldHint false run without an
## approval card. Empty or unset means nothing is first-party. List only an origin that serves
## nothing but your own memory provider. Connections to it do not follow redirects. A provider
## saved before its origin was listed needs one more save in Settings to be marked; removing an
## origin takes effect on restart.
# FIRST_PARTY_MCP_ORIGINS=https://memory.internal:8443

## ---------------------------------------------------------------------------
## Sandbox process knobs.
##
## Self-serve (not TrueFoundry mode): configure the provider via
## PUT /api/v1/settings/sandbox-providers (copy from GET /api/v1/catalogs/sandbox-providers).
## Without a configured provider, agent specs with config.sandbox.enabled (or skills) are
## rejected at session creation.
##
## TrueFoundry mode: see TRUEFOUNDRY_SANDBOX_* above (distributed config only).
## ---------------------------------------------------------------------------

## Extra hosts the sandbox Go package mirror may fetch modules from, comma-separated lower-case host names
## with a dot (for example modules.example.com). No ports, paths, wildcards or IP addresses. Default none.
# SANDBOX_MIRROR_GO_EXTRA_HOSTS=

## Max bytes for a single file download out of the sandbox. Default 25 MiB (document limit).
# SANDBOX_FILE_MAX_BYTES_FOR_DOWNLOAD=26214400

## Max bytes for an HTTP request body. Default 36 MiB (fits one 25 MiB base64 attachment).
## Reverse proxies must allow at least this (e.g. nginx client_max_body_size).
# MAX_REQUEST_BODY_BYTES=37748736

## Context size in tokens that triggers compaction (summarizing older history). Unset, compaction
## starts at 80% of the model's context length, lowered so input plus the configured max output
## tokens fit (never below 4000), or at 50000 when that length is unknown. A value here applies to every model and replaces that automatic threshold,
## unless an agent spec sets its own config.context_management.compaction.trigger.
# CONTEXT_COMPACTION_THRESHOLD_TOKENS=50000

## ---------------------------------------------------------------------------
## Voice input. Base URL of the aman-stt speech-to-text sidecar. Defaults to
## http://aman-stt:8001, which resolves only inside the compose network. Keep
## localhost here for host `pnpm dev` with the sidecar from `pnpm dev:infra`;
## `docker-compose.yml` overrides it to http://aman-stt:8001 for the server
## container. Unreachable sidecar = no mic button, typed chat unaffected.
## ---------------------------------------------------------------------------
STT_URL=http://localhost:8001

## ---------------------------------------------------------------------------
## Spoken replies. Base URL of the aman-tts text-to-speech sidecar. Defaults to
## http://aman-tts:8002, which resolves only inside the compose network. Keep
## localhost here for host `pnpm dev` with the sidecar from `pnpm dev:infra`;
## `docker-compose.yml` overrides it to http://aman-tts:8002 for the server
## container. Unreachable sidecar = replies are read by the browser's own voice.
## ---------------------------------------------------------------------------
TTS_URL=http://localhost:8002
## Set to false to turn off voice mode and the local voice. Replies read by hand then use the browser's voice.
# TTS_ENABLED=true
## Where voice mode finds its small listening model. Images carry it; `pnpm dev` fetches it when you are
## online, or run `pnpm voice:model`. It is checked against a pinned hash before use.
## Defaults to a folder inside the app data folder.
# VOICE_VAD_MODEL_DIR=./data/app/voice-model

## ---------------------------------------------------------------------------
## Postgres (used when STANDALONE=false; also read by Compose postgres
## services via env_file). Config defaults match these values if unset.
## Local-dev credentials only (trueforge/trueforge) — change them for any shared
## or networked host. Keep localhost here for host `pnpm dev`;
## `docker-compose.yml` overrides POSTGRES_HOST/PORT for the server container.
##
## Managed Postgres (Railway, etc.): set DATABASE_URL instead of the discrete
## POSTGRES_* vars below. When DATABASE_URL is set, POSTGRES_* are ignored for
## the app connection (Compose postgres still needs POSTGRES_* for its own env).
## ---------------------------------------------------------------------------
# DATABASE_URL=postgres://trueforge:trueforge@localhost:5432/trueforge
POSTGRES_USER=trueforge
POSTGRES_PASSWORD=trueforge
POSTGRES_DB=trueforge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
## Max connections in the pg Pool. Optional, defaults to 10.
# DATABASE_POOL_MAX=10
## Postgres statement_timeout / idle_in_transaction_session_timeout (ms).
## Shared by the app pool and migrations. Optional, defaults to 60000 each.
# POSTGRES_STATEMENT_TIMEOUT_MS=60000
# POSTGRES_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=60000
## How long a query waits for a database connection, in ms: to open one, or for a busy
## pool to free one. Default POSTGRES_STATEMENT_TIMEOUT_MS plus 10000.
# POSTGRES_CONNECT_TIMEOUT_MS=70000
## Appended as `sslmode` on DATABASE_URL / the built postgres:// URL.
## disable | prefer | require | verify-ca | verify-full | no-verify.
# POSTGRES_SSL_MODE=require

## ---------------------------------------------------------------------------
## OIDC. All three must be set together. Standalone refuses to start without
## them. The issuer must be Aman's own sign-in service (path /dex); any other
## issuer is refused. With STANDALONE=false, all unset = fixed local admin identity:
## anyone who can reach the server is admin. The issuer must be https, except
## http on a loopback host (localhost, 127.0.0.1, ::1).
## ---------------------------------------------------------------------------
# OIDC_ISSUER_URL=http://localhost:5556/dex
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
## Claim used as the user reference. Optional; defaults to "sub".
# OIDC_USER_REFERENCE_CLAIM=sub
## Claim used as the user role. Optional; defaults to "groups".
# OIDC_USER_ROLE_CLAIM=groups
## Case-sensitive role value granting admin access. Optional; defaults to "admin".
# OIDC_ADMIN_ROLE_VALUE=admin
## Comma-separated OAuth scopes for login. Optional; defaults to "openid,profile,email".
# OIDC_SCOPES=openid,profile,email
## Comma-separated email allowlist (exact addresses and/or * globs).
## Only ID tokens whose `email` claim matches an entry may sign in.
## STANDALONE=true requires exactly one address, with a verified email. STANDALONE=false may list several, e.g.
## alice@acme.com,*@partner.com; empty / unset = unrestricted.
# OIDC_ALLOWED_EMAILS=

## ---------------------------------------------------------------------------
## Nebius Token Factory as the main model. With a key set, the server writes a
## read-only `tokenfactory` provider at every start (default model first, the
## cheaper one second) and lists the default model first in the chat picker.
## No step in Settings is needed. `pnpm smoke:tokenfactory` checks the key.
## ---------------------------------------------------------------------------
# NEBIUS_API_KEY=
## Web search provider, picked at startup. `parallel` (default) keeps the keyless Parallel connector.
## `tavily` makes the Tavily connector the one search provider. It needs TAVILY_API_KEY, and the
## server refuses to start without it. Restart after changing either value.
# SEARCH_PROVIDER=parallel
# TAVILY_API_KEY=
## Default model. Default nvidia/nemotron-3-super-120b-a12b.
# TOKEN_FACTORY_MODEL=
## Endpoint. Default https://api.tokenfactory.nebius.com/v1.
# TOKEN_FACTORY_BASE_URL=
## Daily token budget for this instance, counted per UTC day from provider-reported
## usage on turns whose model is on Token Factory. New turns are refused once it is
## reached and start again at midnight UTC. Unset = no cap.
# TOKEN_FACTORY_DAILY_TOKEN_CAP=
## Price overrides for the cost shown under answers and in Settings, as JSON keyed by model id,
## USD per million tokens. Adds to the built-in Token Factory defaults (read 2026-10-15 from the
## Token Factory model catalog). A model with no price shows tokens only.
# TOKEN_FACTORY_PRICES={"nvidia/nemotron-3-super-120b-a12b":{"input_per_million":0.3,"output_per_million":0.9}}
## Routing when the chat model is NOT on Token Factory: off (default), fallback
## (local first, Token Factory only if the primary fails before any output) or
## force (Token Factory first, so prompts leave the machine; not local-first).
# TOKEN_FACTORY_MODE=off

## ---------------------------------------------------------------------------
## Compose login profile (`docker compose --profile login up --build`).
## A sign-in screen backed by one local account, on Aman's own sign-in service: the
## stack runs Dex (ops/compose/dex/config.yaml) at http://localhost:5556/dex
## inside the server container's network namespace, reachable from this
## computer only, so it needs no certificate. Uncomment every line in
## this block and fill in the "your" values. Once set, always start the
## stack with --profile login, or the server has no issuer to talk to.
## Used only by docker-compose.yml.
## ---------------------------------------------------------------------------
# OIDC_ISSUER_URL=http://localhost:5556/dex
# OIDC_CLIENT_ID=amanuensis
## Any random string; Dex and the server both read it. `openssl rand -hex 32`
# OIDC_CLIENT_SECRET=
## One account: its email is both the user reference and the role value, so
## that account signs in as admin.
# OIDC_USER_REFERENCE_CLAIM=email
# OIDC_USER_ROLE_CLAIM=email
# OIDC_ADMIN_ROLE_VALUE=you@example.com
# DEX_USER_EMAIL=you@example.com
# DEX_USER_NAME=Your Name
## Seeds Personalization's name once, where it is empty. Usually the same as above.
# OWNER_NAME=Your Name
## bcrypt hash of the password, kept inside single quotes so Compose leaves its
## `$` signs alone:
##   docker run --rm httpd:2.4-alpine htpasswd -nbBC 10 "" 'your-password' | cut -d: -f2
# DEX_USER_PASSWORD_HASH=''
## Notices on a phone or laptop with Aman closed (web push). Leave the keys out to keep push off.
## The installer makes the keys for you. By hand, make a pair with any VAPID key tool.
## Push needs HTTPS, except on localhost.
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
## The contact push services see on every notice. Defaults to the project's public page, so it names no one.
# WEB_PUSH_SUBJECT=
