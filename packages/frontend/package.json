{
  "name": "frontend",
  "version": "0.0.0",
  "description": "TrueForge agent chat frontend. Private app — not published to npm.",
  "author": "TrueFoundry",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ui:build": "pnpm --filter @truefoundry/trueforge-ui build",
    "predev": "pnpm run ui:build",
    "dev": "vite",
    "dev:no-watch": "pnpm run dev",
    "prebuild": "pnpm run ui:build",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretypecheck": "pnpm run ui:build",
    "typecheck": "pnpm run typecheck:only",
    "typecheck:only": "tsc --noEmit",
    "pretest": "pnpm run ui:build",
    "test": "cross-env NODE_OPTIONS=--conditions=trueforge-dev tsx --test \"tests/**/*.test.ts\"",
    "journey:slow": "cross-env NODE_OPTIONS=--conditions=trueforge-dev tsx --test tests/slowModelJourney.journey.ts"
  },
  "dependencies": {
    "@assistant-ui/core": "0.2.22",
    "@assistant-ui/react": "0.14.27",
    "@assistant-ui/store": "0.2.21",
    "@truefoundry/assistant-ui-runtime": "0.1.37",
    "@truefoundry/trueforge-core": "workspace:*",
    "@truefoundry/trueforge-sdk": "workspace:*",
    "@truefoundry/trueforge-ui": "workspace:*",
    "katex": "0.18.7",
    "monaco-editor": "^0.52.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.2",
    "thinking-orbs": "^0.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^10.1.0",
    "playwright-core": "1.62.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.16.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-monaco-editor-esm": "^2.0.2"
  }
}
