{
  "author": "TrueFoundry",
  "bin": {
    "aman-tui": "./dist/cli.js"
  },
  "bugs": {
    "url": "https://github.com/ClimbOutLabs/amanuensis/issues"
  },
  "dependencies": {
    "@truefoundry/trueforge-chat": "workspace:*",
    "@truefoundry/trueforge-sdk": "workspace:*",
    "ink": "^6.5.1",
    "react": "^19.2.4"
  },
  "description": "Aman in the terminal: pair once with a one-time code, then chat with streaming replies from the command line.",
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "exports": {
    ".": {
      "trueforge-dev": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "homepage": "https://trueforge.dev",
  "license": "MPL-2.0",
  "main": "./dist/index.js",
  "name": "@truefoundry/aman-tui",
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "directory": "packages/aman-tui",
    "type": "git",
    "url": "git+https://github.com/ClimbOutLabs/amanuensis.git"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/chmod-path.mjs dist/cli.js 755",
    "lint": "eslint src test --ext .ts,.tsx",
    "prepack": "node ../../scripts/copy-license-files.mjs",
    "pretest": "pnpm --filter @truefoundry/trueforge-sdk build && pnpm --filter @truefoundry/trueforge-chat build",
    "pretypecheck": "pnpm --filter @truefoundry/trueforge-sdk build",
    "test": "vitest run",
    "typecheck": "pnpm run typecheck:only",
    "typecheck:only": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.1.0"
}
