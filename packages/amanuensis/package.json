{
  "name": "amanuensis",
  "version": "0.1.0",
  "description": "Amanuensis: agent server and chat UI in one command (npx amanuensis)",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClimbOutLabs/amanuensis.git",
    "directory": "packages/amanuensis"
  },
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "type": "module",
  "bin": "./dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "prepack": "node ../../scripts/copy-license-files.mjs",
    "build:clean": "node ../../scripts/rm-path.mjs dist",
    "build:deps": "node scripts/sync-dependencies.mjs",
    "check:deps": "node scripts/sync-dependencies.mjs --check",
    "build:server": "pnpm --filter @truefoundry/trueforge build",
    "build": "pnpm run build:server && pnpm run build:deps && pnpm run build:clean && tsup && node ../../scripts/chmod-path.mjs dist/cli.js 755 && node scripts/vendor-server.mjs",
    "pack:dry": "pnpm pack --dry-run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@truefoundry/trueforge": "workspace:*",
    "@truefoundry/trueforge-core": "workspace:*",
    "@types/node": "^24.13.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "^2.0.88",
    "@ai-sdk/anthropic": "^4.0.102",
    "@ai-sdk/google": "^4.0.117",
    "@ai-sdk/moonshotai": "^3.0.90",
    "@ai-sdk/openai": "^4.0.49",
    "@ai-sdk/openai-compatible": "^3.0.90",
    "@ai-sdk/provider": "^4.0.37",
    "@ai-sdk/provider-utils": "^5.0.79",
    "@anthropic-ai/sandbox-runtime": "0.0.82",
    "@block65/webcrypto-web-push": "2.0.0",
    "@daytona/sdk": "^0.231.1",
    "@hono/node-server": "^2.1.7",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.1",
    "@huggingface/transformers": "4.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nats-io/nats-core": "3.4.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^2.12.1",
    "ai": "^7.0.169",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^5.10.4",
    "dedent": "^1.7.2",
    "diff": "^9.0.0",
    "diff-match-patch": "^1.0.5",
    "docx": "9.15.3",
    "env-paths": "^4.0.0",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "kysely": "^0.29.8",
    "mammoth": "^1.13.0",
    "onnxruntime-node": "1.31.1",
    "openai": "^7.55.0",
    "openid-client": "^6.8.9",
    "parse5": "^7.3.0",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.1",
    "redis": "^5.12.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "sqlite-vec": "^0.1.6",
    "swagger-ui-dist": "5.34.1",
    "ulid": "^3.0.2",
    "undici": "7.30.2",
    "unified": "^11.0.5",
    "winston": "^3.19.0",
    "ws": "8.22.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.4"
  }
}
